# Etendo root directory (relative or absolute path)
ETENDO_ROOT=..

# Etendo Database (staging/development - NEVER production)
ETENDO_DB_HOST=localhost
ETENDO_DB_PORT=5432
ETENDO_DB_USER=tad
ETENDO_DB_PASSWORD=tad
ETENDO_DB_NAME=etendo

# Etendo Java source directory (for Rule Extractor callout analysis)
ETENDO_SOURCE_DIR=../src

# Sonar Qube configuration
SONAR_HOST_URL=
SONAR_TOKEN=

# AI integration: Claude Code subagents + skills (no API key needed)

# Enable Playwright screenshots for E2E evidence and failures (opt-in).
E2E_CAPTURE_SCREENSHOTS=0

# Stripe hosted Checkout (Test Mode only) -- see docs/stripe-local-testing.md
# Base URL must match context.name in etendo_core/gradle.properties.
ETENDO_BASE_URL=http://localhost:8080/etendo
ETENDO_TEST_EMAIL=
ETENDO_TEST_PASSWORD=
# Only needed for real Stripe calls (make test-stripe-local); never an sk_live_ key.
ETGO_CHECKOUT_SECRET_KEY=
ETGO_CHECKOUT_PRICE_ID=
# Must match etendo.go.checkout.webhook.secret in etendo_core/config/Openbravo.properties.
ETGO_CHECKOUT_WEBHOOK_SECRET=
