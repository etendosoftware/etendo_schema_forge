{
  "$schema": "decisions-v2",
  "window": {
    "category": "finance",
    "name": "Currency Conversion",
    "detailEntity": null,
    "layoutType": "custom",
    "readOnly": false
  },
  "entities": {
    "header": {
      "name": "conversionRate",
      "publicApi": { "readOnly": true },
      "fields": {
        "organization": { "grid": false, "form": false, "visibility": "readOnly" },
        "currency": { "grid": true, "form": true, "searchable": true, "inputMode": "selector", "visibility": "readOnly", "publicApi": { "exposed": true } },
        "toCurrency": { "grid": true, "form": true, "searchable": true, "inputMode": "selector", "readOnlyLogic": "@sMFCRSynced@='Y'", "publicApi": { "exposed": true } },
        "conversionRateType": { "grid": false, "form": false, "visibility": "readOnly" },
        "validFromDate": { "grid": true, "form": true, "readOnlyLogic": "@sMFCRSynced@='Y'", "publicApi": { "exposed": true } },
        "validToDate": { "grid": true, "form": true, "visibility": "readOnly", "publicApi": { "exposed": true } },
        "multipleRateBy": { "grid": true, "form": true, "readOnlyLogic": "@sMFCRSynced@='Y'", "type": "number", "publicApi": { "exposed": true }, "_note": "Explicit numeric type: AD reference 800019 (Rate) is not mapped by the core extractor, so it is extracted as string while NEO answers a JSON number. Remove once ref 800019 is mapped in schema_forge_core." },
        "divideRateBy": { "grid": true, "form": true, "visibility": "readOnly", "type": "number", "publicApi": { "exposed": true }, "_note": "Explicit numeric type, same reason as multipleRateBy. Read-only since ETP-6365: the server derives it from multipleRateBy." },
        "active": { "grid": false, "form": false },
        "sMFCRSynced": { "visibility": "readOnly", "grid": true, "form": true, "section": "principal" },
        "etgoRateStatus": { "visibility": "readOnly", "grid": true, "form": true, "_note": "ETP-6365: column served by com.etendoerp.go (CURRENT = rules now | HISTORIC = no longer rules); filterable." }
      }
    }
  },
  "rules": {},
  "discardPatterns": [],
  "version": 2
}
