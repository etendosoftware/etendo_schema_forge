{
  "$schema": "decisions-v2",
  "version": 2,
  "window": {
    "category": "finance",
    "name": "Fiscal Calendar",
    "detailEntity": null,
    "hideDetailForm": false,
    "listSortBy": "fiscalYear desc",
    "processOverrides": {
      "processNow": {
        "label": "Create Periods",
        "params": [
          {
            "key": "CREATEADJUSTMENT",
            "type": "select",
            "label": "Create Adjustment Period",
            "required": false,
            "options": [
              { "value": "N", "label": "No" },
              { "value": "Y", "label": "Yes" }
            ]
          }
        ]
      }
    },
    "menuActions": [
      { "key": "closeYear", "labelKey": "closeYearTitle", "component": "CloseYearModal" },
      { "key": "undoCloseYear", "labelKey": "undoCloseYearTitle", "component": "UndoCloseYearModal" }
    ],
    "labelOverrides": {
      "es_ES": {
        "Year": "Año fiscal",
        "PeriodNo": "N.º período",
        "StartDate": "Fecha inicio",
        "EndDate": "Fecha fin",
        "PeriodType": "Tipo",
        "Status": "Estado"
      }
    }
  },
  "entities": {
    "calendar": {
      "exclude": true
    },
    "year": {
      "javaQualifier": "year-close",
      "fields": {
        "fiscalYear": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "gridOrder": 1,
          "labelKey": "Fiscal Year"
        },
        "description": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "gridOrder": 2
        },
        "calendar": {
          "visibility": "system",
          "derivation": "fromParent"
        },
        "processNow": {
          "form": true,
          "visibility": "editable",
          "processId": "100",
          "processType": "classic"
        },
        "createRegFactAcct": {
          "visibility": "discarded"
        },
        "dropRegFactAcct": {
          "visibility": "discarded"
        },
        "active": {
          "visibility": "discarded"
        },
        "organization": {
          "visibility": "discarded"
        },
        "client": {
          "visibility": "discarded"
        },
        "id": {
          "visibility": "discarded"
        },
        "creationDate": {
          "visibility": "discarded"
        },
        "createdBy": {
          "visibility": "discarded"
        },
        "updated": {
          "visibility": "discarded"
        },
        "updatedBy": {
          "visibility": "discarded"
        }
      }
    },
    "period": {
      "exclude": true,
      "fields": {
        "periodNo": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "gridOrder": 1
        },
        "name": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "gridOrder": 2
        },
        "startingDate": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "gridOrder": 3
        },
        "endingDate": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "gridOrder": 4
        },
        "periodType": {
          "grid": false,
          "form": true,
          "visibility": "readOnly"
        },
        "status": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "badge": true,
          "columnType": "enum",
          "enumVariants": {
            "O": "green",
            "N": "neutral",
            "C": "neutral",
            "P": "red"
          },
          "gridOrder": 5
        },
        "processNow": {
          "visibility": "discarded"
        },
        "openClose": {
          "visibility": "discarded"
        },
        "active": {
          "visibility": "discarded"
        },
        "organization": {
          "visibility": "discarded"
        },
        "client": {
          "visibility": "discarded"
        },
        "id": {
          "visibility": "discarded"
        },
        "year": {
          "visibility": "discarded"
        },
        "closingFactAcctGroupID": {
          "visibility": "discarded"
        },
        "creationDate": {
          "visibility": "discarded"
        },
        "createdBy": {
          "visibility": "discarded"
        },
        "divideupFactAcctGroupID": {
          "visibility": "discarded"
        },
        "openFactAcctGroupID": {
          "visibility": "discarded"
        },
        "regularizationFactAcctGroupID": {
          "visibility": "discarded"
        },
        "updated": {
          "visibility": "discarded"
        },
        "updatedBy": {
          "visibility": "discarded"
        }
      }
    }
  }
}
