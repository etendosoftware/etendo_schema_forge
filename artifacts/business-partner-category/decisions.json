{
  "$schema": "decisions-v2",
  "window": {
    "category": "contact",
    "name": "Business Partner Category",
    "detailEntity": "accounting",
    "detailVisibleWhenCapability": "showAccountingFields",
    "linesLayout": "inlineEditable",
    "formCardPadding": "p-2",
    "toolbarPaddingX": "px-2",
    "tabsBarPaddingX": "px-2",
    "formScrollPaddingX": "px-2",
    "noHeaderBorder": true,
    "toolbarBorderBottom": true,
    "whiteFormBackground": true,
    "autoSaveOnBlur": true,
    "hidePrint": true,
    "hideLink": true,
    "listbarPaddingX": "px-2",
    "tablePaddingX": "px-2",
    "maxDetailLines": 1,
    "customLinesComponent": "BpCategoryAccountingPanel",
    "customLinesLabel": "Accounting"
  },
  "entities": {
    "businessPartnerCategory": {
      "fields": {
        "searchKey": {
          "grid": false,
          "searchable": true,
          "section": "principal",
          "seq": 1
        },
        "name": {
          "grid": true,
          "searchable": true,
          "section": "principal",
          "seq": 2,
          "gridOrder": 1
        },
        "description": {
          "form": false,
          "grid": false
        },
        "default": {
          "section": "principal",
          "seq": 4,
          "grid": true,
          "gridOrder": 4,
          "badge": true,
          "badgeLabels": {
            "true": {
              "es_ES": "Sí",
              "en_US": "Yes"
            },
            "false": {
              "es_ES": "No",
              "en_US": "No"
            }
          },
          "badgeVariants": {
            "true": "green",
            "false": "neutral"
          }
        },
        "etgoIscustomer": {
          "visibility": "editable",
          "form": true,
          "grid": true,
          "gridOrder": 2,
          "section": "principal",
          "seq": 5,
          "span": 4,
          "customRenderer": "ContactTypeField",
          "agentPrompt": "#REF#agent-prompts/business-partner-category/category.etgo-iscustomer.md",
          "badge": true,
          "badgeLabels": {
            "true": {
              "es_ES": "Sí",
              "en_US": "Yes"
            },
            "false": {
              "es_ES": "No",
              "en_US": "No"
            }
          },
          "badgeVariants": {
            "true": "green",
            "false": "neutral"
          }
        },
        "etgoIsvendor": {
          "visibility": "editable",
          "form": false,
          "grid": true,
          "gridOrder": 3,
          "agentPrompt": "#REF#agent-prompts/business-partner-category/category.etgo-isvendor.md",
          "badge": true,
          "badgeLabels": {
            "true": {
              "es_ES": "Sí",
              "en_US": "Yes"
            },
            "false": {
              "es_ES": "No",
              "en_US": "No"
            }
          },
          "badgeVariants": {
            "true": "green",
            "false": "neutral"
          }
        }
      }
    },
    "accounting": {
      "javaQualifier": "businessPartnerCategoryAccountingHandler",
      "hideDelete": true,
