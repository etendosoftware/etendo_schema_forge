{
  "$schema": "decisions-v2",
  "version": 2,
  "window": {
    "category": "finance",
    "name": "Calendar",
    "detailEntity": null,
    "layoutType": "custom",
    "hideDetailForm": false,
    "listSortBy": "fiscalYear desc",
    "processOverrides": {
      "processNow": {
        "label": "Create Periods",
        "params": [
          {
            "key": "CREATEADJUSTMENT",
            "type": "select",
            "label": "Create Adjustment Period",
            "required": false,
            "options": [
              { "value": "N", "label": "No" },
              { "value": "Y", "label": "Yes" }
            ]
          }
        ]
      },
      "openClose": {
        "label": "Open Close Period",
        "detailLabel": "Open Close Document",
        "params": [
          {
            "key": "openClose",
            "type": "select",
            "label": "Action",
            "required": true,
            "options": [
              { "value": "O", "label": "Open" },
              { "value": "C", "label": "Closed" },
              { "value": "P", "label": "Permanently closed" }
            ]
          }
        ]
      }
    },
    "statusEnumLabels": {
      "O": "All Opened",
      "N": "All Never Opened",
      "C": "All Closed",
      "P": "All Permanently Closed",
      "M": "Mixed"
    },
    "menuActions": [
      { "key": "closeYear", "labelKey": "closeYearTitle", "component": "CloseYearModal" },
      { "key": "undoCloseYear", "labelKey": "undoCloseYearTitle", "component": "UndoCloseYearModal" }
    ],
    "labelOverrides": {
      "es_ES": {
        "Year": "Año fiscal",
        "PeriodNo": "N.º período",
        "StartDate": "Fecha inicio",
        "EndDate": "Fecha fin",
        "PeriodType": "Tipo",
        "Status": "Estado",
        "DocumentCategory": "Tipo de documento",
        "PeriodStatus": "Estado período"
      }
    }
