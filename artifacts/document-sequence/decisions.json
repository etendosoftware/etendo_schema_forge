{
  "$schema": "decisions-v2",
  "version": 2,
  "window": {
    "category": "settings",
    "name": "Document Sequence",
    "detailEntity": null,
    "hideDetailForm": false,
    "listSortBy": "name asc",
    "hideCreate": true,
    "discardPatterns": [
      "EM_*"
    ],
    "labelOverrides": {
      "es_ES": {
        "Name": "Nombre",
        "Description": "Descripción",
        "Prefix": "Prefijo",
        "StartNo": "Número inicial",
        "CurrentNext": "Próximo número"
      }
    },
    "hideDeleteButton": true
  },
  "entities": {
    "sequence": {
      "javaQualifier": "document-sequence",
      "methods": [
        "GET",
        "GETBYID",
        "PUT",
        "PATCH"
      ],
      "hideDelete": true,
      "fields": {
        "name": {
          "grid": true,
          "form": true,
          "visibility": "readOnly",
          "gridOrder": 1,
          "enumValues": [
            {
              "value": "Purchase Order",
              "name": "documentSequencePurchaseOrder"
            },
            {
              "value": "Standard Order",
              "name": "documentSequenceSalesOrder"
            },
            {
              "value": "AR Invoice",
              "name": "documentSequenceSalesInvoice"
            },
            {
              "value": "Factura Rectificativa (Ventas)",
              "name": "documentSequenceSalesCorrectiveInvoice"
            },
            {
              "value": "Factura Rectificativa (Compras)",
              "name": "documentSequencePurchaseCorrectiveInvoice"
            }
          ],
          "section": "principal"
        },
        "description": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "gridOrder": 2,
          "section": "principal"
        },
        "prefix": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "gridOrder": 3,
          "section": "principal"
        },
        "startingNo": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "integer": true,
          "gridOrder": 4,
          "section": "principal"
        },
        "nextAssignedNumber": {
          "grid": true,
          "form": true,
          "visibility": "editable",
          "integer": true,
          "gridOrder": 5,
          "section": "principal"
        },
        "suffix": {
          "visibility": "discarded"
        },
        "incrementBy": {
          "visibility": "discarded"
        },
        "restartSequenceEveryYear": {
          "visibility": "discarded"
        },
        "autoNumbering": {
          "visibility": "discarded"
        },
        "mask": {
          "visibility": "discarded"
        },
        "valueFormat": {
          "visibility": "discarded"
        },
        "documentType": {
          "visibility": "discarded"
        },
        "currentNextSystem": {
          "visibility": "discarded"
        },
        "usedForRecordID": {
          "visibility": "discarded"
        },
        "aDTableID": {
          "visibility": "discarded"
        },
        "aDColumnID": {
          "visibility": "discarded"
        },
