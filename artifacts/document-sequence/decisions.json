          "visibility": "discarded"
        },
        "active": {
          "visibility": "discarded"
        },
        "organization": {
          "visibility": "discarded"
        },
        "client": {
          "visibility": "discarded"
        },
        "id": {
          "visibility": "discarded"
        },
        "creationDate": {
          "visibility": "discarded"
        },
        "createdBy": {
          "visibility": "discarded"
        },
        "updated": {
          "visibility": "discarded"
        },
        "updatedBy": {
          "visibility": "discarded"
        }
