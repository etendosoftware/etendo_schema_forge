{
  "$schema": "decisions-v2",
  "window": {
    "category": "accounting",
    "name": "Chart of Accounts",
    "hideCreate": true,
    "titleField": "searchKey",
    "customComponents": {
      "headerTable": "AccountTreeView"
    },
    "menuActions": [
      { "key": "newSubAccount", "label": "New Sub-account", "labelKey": "newSubAccount", "component": "NewAccountModal" }
    ]
  },
  "entities": {
    "element": {
      "exclude": true
    },
    "elementValue": {
      "javaQualifier": "chart-of-accounts",
      "orderBy": [{ "field": "searchKey", "direction": "ASC" }],
      "fields": {
        "searchKey":             { "visibility": "editable",  "grid": true,  "form": true, "customRenderer": "AccountCodeField", "readOnlyLogic": "@ProtectedParentLikeSubaccount@='Y'" },
        "name":                  { "visibility": "editable",  "grid": true,  "form": true, "readOnlyLogic": "@ProtectedParentLikeSubaccount@='Y'" },
        "description":           { "visibility": "editable",  "grid": false, "form": true, "readOnlyLogic": "@ProtectedParentLikeSubaccount@='Y'" },
        "accountType":           { "visibility": "editable",  "grid": true,  "form": true, "readOnlyLogic": "@ProtectedParentLikeSubaccount@='Y'" },
        "summaryLevel":          { "visibility": "system" },
        "active": {
          "visibility": "editable",
          "grid": true,
          "form": true,
          "inlineToggle": true,
          "derivation": null,
          "reason": "ETP-4884 item 5 — no UI action existed to deactivate an existing subaccount. Raw AD data pins this field to a computed derivation (source: 'true', always hardcoded true) even though visibility was already 'readOnly' here — overridden to visibility: editable + inlineToggle: true (renders a live-PATCHing Switch, mirroring the exact escape-hatch pattern already used for user.active, ETP-4830) + an explicit derivation: null so resolve-curated.js's copyRawProps does not keep copying the raw computed derivation onto the curated field post-flip, which would let NEO override any admin-set value on save. Deactivating a subaccount only flips C_ElementValue.IsActive — it does not delete the record or block viewing/editing it afterward (standard Etendo de-activation semantics). Protected 0000-suffixed placeholder subaccounts remain fully locked (readOnlyLogic on the other editable fields is unaffected by this change) and the toggle is disabled for them in AccountTreeRow since the backend rejects any PATCH on those codes regardless."
        },
        "organization":          { "visibility": "system" },
        "id":                    { "visibility": "system" },
        "client":                { "visibility": "system" },
        "accountingElement":     { "visibility": "system" },
        "accountSign":           { "visibility": "discarded" },
        "elementLevel":          { "visibility": "discarded" },
        "accountType2":          { "visibility": "discarded" },
        "showValueCondition":    { "visibility": "discarded" },
        "elementShown":          { "visibility": "discarded" },
        "titleNode":             { "visibility": "discarded" },
        "bankAccount":           { "visibility": "discarded" },
        "foreignCurrencyAccount":{ "visibility": "discarded" },
        "currency":              { "visibility": "discarded" },
        "isBankAccount":         { "visibility": "discarded" },
        "postActual":            { "visibility": "discarded" },
        "postBudget":            { "visibility": "discarded" },
        "postStatistical":       { "visibility": "discarded" },
        "documentControlled":    { "visibility": "discarded" },
        "validFromDate":         { "visibility": "discarded" },
        "validToDate":           { "visibility": "discarded" },
        "postEncumbrance":       { "visibility": "discarded" },
        "creationDate":          { "visibility": "system" },
        "createdBy":             { "visibility": "system" },
        "updated":               { "visibility": "system" },
        "updatedBy":             { "visibility": "system" }
      }
    },
    "customizedElements": {
      "exclude": true
    },
    "translation": {
      "exclude": true
    }
  }
}
