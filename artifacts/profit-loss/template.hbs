{{!-- Profit & Loss — indented account-report tree (ETP-4899).
      Rows arrive pre-flattened from buildAccountReportTree(): each carries its
      own `indentClass` and `isHeading`, so this template needs no arithmetic
      (and therefore no new Handlebars helper). --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
{{{css}}}
.tree-row td { border-bottom: 1px solid #eef2f7 !important; }
.tree-row.heading td { font-weight: 700; background: #f8fafc; }
.group-header td { background: var(--color-accent-highlight-muted); color: var(--color-accent-highlight-foreground); font-weight: 600; padding: 2mm 4mm; font-size: 11pt; }
/* Indentation is a per-depth left pad on the element cell — mirrors Classic,
   which prepends spaces to the label rather than using nested tables. */
.ind-0 { padding-left: 2mm !important; }
.ind-1 { padding-left: 7mm !important; }
.ind-2 { padding-left: 12mm !important; }
.ind-3 { padding-left: 17mm !important; }
.ind-4 { padding-left: 22mm !important; }
.ind-5 { padding-left: 27mm !important; }
.ind-6 { padding-left: 32mm !important; }
</style>
</head>
<body><div class="report-container">
  <div class="report-header">
    <div><div class="report-title">{{meta.title}}</div>
</div>
    {{> document-branding}}
  </div>
  {{#if meta.filters.length}}
  <div class="report-filters-grid">
    {{#each meta.filters}}
    <div><span>{{this.label}}: </span><strong>{{this.value}}</strong></div>
    {{/each}}
  </div>
  {{/if}}

  <table class="report-table" style="table-layout: fixed;">
    <colgroup>
      {{#ifCond meta.params.compareTo '===' 'true'}}
      <col style="width:60%"><col style="width:20%"><col style="width:20%">
      {{else}}
      <col style="width:75%"><col style="width:25%">
      {{/ifCond}}
    </colgroup>
    <thead>
      <tr>
        <th>{{meta.labels.element}}</th>
        <th class="cell-amount">{{meta.labels.amount}}</th>
        {{#ifCond meta.params.compareTo '===' 'true'}}<th class="cell-amount">{{meta.labels.amount_ref}}</th>{{/ifCond}}
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      {{#if this.isGroupStart}}
      <tr class="group-header">
        <td colspan="{{#ifCond @root.meta.params.compareTo '===' 'true'}}3{{else}}2{{/ifCond}}">{{this.group}}</td>
      </tr>
      {{/if}}
      <tr class="tree-row {{#if this.isHeading}}heading{{/if}}">
        <td class="{{this.indentClass}}">{{this.element}}</td>
        <td class="cell-amount">{{formatCurrency this.amount}}</td>
        {{#ifCond @root.meta.params.compareTo '===' 'true'}}<td class="cell-amount">{{formatCurrency this.amount_ref}}</td>{{/ifCond}}
      </tr>
      {{/each}}
    </tbody>
  </table>

  {{#if meta.isInteractive}}
  <div class="print-only-footer-note">{{meta.ui.printedOn}} {{formatDate meta.generatedAt}}</div>
  {{/if}}
</div></body></html>
