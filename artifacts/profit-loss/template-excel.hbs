{{!-- Excel-only template (ETP-4899) — flattens the indented tree into a plain,
      calculation-friendly grid. The HTML preview conveys hierarchy with left
      padding, which Excel cannot express, so depth becomes its own sortable
      "Level" column plus separate code/name columns.
      Amount cells use data-cell-type="number" with the RAW value (no
      formatCurrency) — html-to-xlsx does `parseFloat(cell.innerText)` for that
      type, so a formatted amount would silently truncate at the thousands
      separator. Never format here. --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
  table { border-collapse: collapse; font-family: sans-serif; font-size: 10pt; }
  th { font-weight: bold; text-align: left; background: #f1f5f9; }
  th, td { padding: 1px 4px; white-space: nowrap; }
</style>
</head>
<body>
  <table>
    <thead><tr>
      <th>Level</th>
      <th>Code</th>
      <th>Name</th>
      <th>{{meta.labels.amount}}</th>
      {{#ifCond meta.params.compareTo '===' 'true'}}<th>{{meta.labels.amount_ref}}</th>{{/ifCond}}
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td data-cell-type="number">{{this.indent}}</td>
        <td>{{this.value}}</td>
        <td>{{this.name}}</td>
        <td data-cell-type="number">{{this.amount}}</td>
        {{#ifCond @root.meta.params.compareTo '===' 'true'}}<td data-cell-type="number">{{this.amount_ref}}</td>{{/ifCond}}
      </tr>
      {{/each}}
    </tbody>
  </table>
</body></html>
