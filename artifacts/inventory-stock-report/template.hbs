{{!-- Inventory Stock Report (Neo source) --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
{{{css}}}
.group-header td { border: none !important; }
</style>
</head>
<body><div class="report-container">
  <div class="report-header">
    <div><div class="report-title">{{meta.title}}</div></div>
    <div class="report-meta"><div>{{formatDate meta.generatedAt}}</div><div>{{meta.recordCount}} {{meta.ui.records}}</div></div>
  </div>

  {{!-- The other two dimensions (of Product/Warehouse/Category) always show as their own
        columns, right after the search key, in that fixed relative order — whichever one is
        the CURRENT grouping is skipped there since its band already carries that value. This
        keeps the column count constant (5 fixed + 2 of the 3 dimensions = 7) regardless of
        which "Agrupar por" option is chosen, so the colspan below never needs to change. --}}
  <table class="report-table">
    <thead><tr>
      <th style="width: 12%">{{meta.labels.productSearchKey}}</th>
      {{#unless (eq meta.dimensionField 'product')}}<th style="width: 18%">{{meta.labels.product}}</th>{{/unless}}
      {{#unless (eq meta.dimensionField 'warehouse')}}<th style="width: 14%">{{meta.labels.warehouse}}</th>{{/unless}}
      {{#unless (eq meta.dimensionField 'category')}}<th style="width: 14%">{{meta.labels.category}}</th>{{/unless}}
      <th style="width: 8%">{{meta.labels.uom}}</th>
      <th style="width: 14%" class="cell-amount">{{meta.labels.qtyOnHand}}</th>
      <th style="width: 12%" class="cell-amount">{{meta.labels.unitCost}}</th>
      <th style="width: 18%" class="cell-amount">{{meta.labels.totalValuation}}</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
        {{#if @root.meta.dimensionField}}
        {{#if (isGroupBreak @root.meta.dimensionField (lookup this @root.meta.dimensionField))}}
        <tr class="group-header">
          <td colspan="7" style="background: #000000; color: #ffffff; font-weight: 600; padding: 2mm 4mm; font-size: 11pt;">
            {{lookup this @root.meta.dimensionField}}
          </td>
        </tr>
        {{/if}}
        {{/if}}
        <tr>
          <td>{{lookup this 'productSearchKey'}}</td>
          {{#unless (eq @root.meta.dimensionField 'product')}}<td>{{lookup this 'product'}}</td>{{/unless}}
          {{#unless (eq @root.meta.dimensionField 'warehouse')}}<td>{{lookup this 'warehouse'}}</td>{{/unless}}
          {{#unless (eq @root.meta.dimensionField 'category')}}<td>{{lookup this 'category'}}</td>{{/unless}}
          <td>{{lookup this 'uom'}}</td>
          <td class="cell-amount">{{formatCurrency (lookup this 'qtyOnHand')}}</td>
          <td class="cell-amount">{{formatCurrency (lookup this 'unitCost')}}</td>
          <td class="cell-amount">{{formatCurrency (lookup this 'totalValuation')}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="report-footer">
    <div class="report-summary">{{meta.ui.total}}: {{meta.recordCount}} {{meta.ui.records}}</div>
    <div>{{meta.ui.generatedBy}}</div>
  </div>
</div></body></html>
