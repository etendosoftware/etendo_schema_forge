{
  "version": 1,
  "reportId": "inventory-stock-report",
  "category": "inventory",
  "type": "grouped-listing",
  "source": "neo",
  "title": {
    "en_US": "Inventory Stock Report",
    "es_ES": "Reporte de Stock"
  },
  "orientation": "landscape",
  "neo": {
    "endpoint": "/sws/neo/inventory-stock-report",
    "method": "POST",
    "body": {},
    "dataPath": "response.data",
    "handler": "inventoryStockReportHandler"
  },
  "columns": [
    {
      "field": "productSearchKey",
      "label": {
        "en_US": "Search Key",
        "es_ES": "Clave"
      },
      "type": "string",
      "width": "12%",
      "sortable": true
    },
    {
      "field": "product",
      "label": {
        "en_US": "Product",
        "es_ES": "Producto"
      },
      "type": "string",
      "width": "22%",
      "sortable": true
    },
    {
      "field": "uom",
      "label": {
        "en_US": "UoM",
        "es_ES": "UdM"
      },
      "type": "string",
      "width": "8%",
      "sortable": true
    },
    {
      "field": "qtyOnHand",
      "label": {
        "en_US": "Qty on Hand",
        "es_ES": "Stock Disponible"
      },
      "type": "amount",
      "width": "14%",
      "sortable": true
    },
    {
      "field": "unitCost",
      "label": {
        "en_US": "Unit Cost",
        "es_ES": "Coste Unitario"
      },
      "type": "amount",
      "width": "12%",
      "sortable": true
    },
    {
      "field": "totalValuation",
      "label": {
        "en_US": "Total Valuation",
        "es_ES": "Valoración"
      },
      "type": "amount",
      "width": "18%",
      "sortable": true
    },
    {
      "field": "warehouse",
      "label": {
        "en_US": "Warehouse",
        "es_ES": "Almacen"
      },
      "type": "string",
      "width": "14%",
      "sortable": true
    },
    {
      "field": "category",
      "label": {
        "en_US": "Category",
        "es_ES": "Categoría"
      },
      "type": "string",
      "width": "14%",
      "sortable": true
    }
  ],
  "groups": [
    {
      "field": "warehouse",
      "label": {
        "en_US": "Warehouse",
        "es_ES": "Almacen"
      }
    }
  ],
  "filters": [],
  "sections": [
    {
      "id": "alcance",
      "label": {
        "en_US": "Scope",
        "es_ES": "Alcance"
      }
    },
    {
      "id": "agrupacion",
      "label": {
        "en_US": "Grouping",
        "es_ES": "Agrupación"
      }
    }
  ],
  "parameters": [
    {
      "name": "M_Product_ID",
      "label": {
        "en_US": "Product",
        "es_ES": "Producto"
      },
      "type": "search",
      "selector": "product",
      "multi": true,
      "inputStyle": "popup",
      "section": "alcance",
      "groupByValue": "product",
      "groupByField": "product"
    },
    {
      "name": "M_Warehouse_ID",
      "label": {
        "en_US": "Warehouse",
        "es_ES": "Almacen"
      },
      "type": "search",
      "selector": "warehouse",
      "multi": true,
      "inputStyle": "popup",
      "section": "alcance",
      "groupByValue": "warehouse",
      "groupByField": "warehouse"
    },
    {
      "name": "M_Product_Category_ID",
      "label": {
        "en_US": "Category",
        "es_ES": "Categoría"
      },
      "type": "search",
      "selector": "product-category",
      "multi": true,
      "inputStyle": "popup",
      "section": "alcance",
      "groupByValue": "category",
      "groupByField": "category"
    },
    {
      "name": "includeZeroStock",
      "label": {
        "en_US": "Include products without stock",
        "es_ES": "Incluir productos sin stock"
      },
      "type": "toggle",
      "default": false,
      "section": "alcance"
    },
    {
      "name": "groupBy",
      "label": {
        "en_US": "Group results by",
        "es_ES": "Agrupar por"
      },
      "type": "select",
      "default": "warehouse",
      "section": "agrupacion"
    }
  ],
  "defaultSort": {
    "field": "productSearchKey",
    "direction": "asc"
  },
  "outputs": [
    "pdf",
    "xlsx",
    "csv",
    "html"
  ],
  "summary": {
    "totalRows": true
  },
  "mockDataFile": "mock-data.json"
}
