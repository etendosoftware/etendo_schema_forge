{
  "$schema": "decisions-v2",
  "window": {
    "category": "sales",
    "name": "Goods Shipment",
    "salesTheme": true,
    "notesField": "description",
    "relatedDocuments": true,
    "hideDeleteWhenComplete": true,
    "hidePrint": true,
    "customComponents": {
      "topbarRight": "GoodsShipmentActions",
      "topbarExtra": "GoodsShipmentBillingBadge",
      "bulkActions": "BulkInvoiceFromShipment",
      "bottomSection": "GoodsShipmentBottomPanel"
    },
    "linesLayout": "inlineEditable",
    "menuActions": [
      {
        "key": "post",
        "label": "Post",
        "labelKey": "post",
        "action": "post",
        "visibleWhenFieldFalse": "posted",
        "successKey": "documentPosted",
        "visibleWhenFieldTrue": "processed"
      },
      {
        "key": "unpost",
        "label": "Unpost",
        "labelKey": "unpost",
        "action": "unpost",
        "visibleWhenFieldTrue": "posted",
        "successKey": "documentUnposted",
        "destructive": true
      }
    ],
    "processOverrides": {
      "documentAction": {
        "exclude": true
      }
    },
    "noHeaderBorder": true,
    "dateFilterKey": "movementDate",
    "statusPills": [
      {
        "field": "posted",
        "trueKey": "postedStatus",
        "falseKey": "notPostedStatus",
        "_note": "Accounting status pill — visible to financial+admin roles only (permissions enforcement pending)"
      }
    ],
    "labelOverrides": {
      "en_US": {
        "EM_ETGO_Currency_ID": "Currency"
      },
      "es_ES": {
        "EM_ETGO_Currency_ID": "Moneda"
      }
    }
  },
  "entities": {
    "header": {
      "name": "goodsShipment",
      "javaQualifier": "goodsShipmentHeaderHandler",
      "draftMode": {
        "enabled": false
      },
      "fields": {
        "documentNo": {
          "visibility": "readOnly",
          "grid": true,
          "searchable": true,
          "inputMode": "text",
          "section": "principal",
          "seq": 20
        },
        "businessPartner": {
          "grid": true,
          "searchable": true,
          "reference": "BusinessPartner",
          "inputMode": "search",
          "readOnlyLogic": "@Processed@='Y'",
          "section": "principal",
          "seq": 10
        },
        "movementDate": {
          "grid": true,
          "searchable": true,
          "inputMode": "date",
          "section": "principal",
          "seq": 30
        },
        "warehouse": {
          "grid": true,
          "searchable": true,
          "inputMode": "search",
          "section": "principal",
          "seq": 40,
          "defaultExpr": "@#M_Warehouse_ID@"
        },
        "etgoCurrency": {
          "visibility": "editable",
          "reference": "Currency",
          "inputMode": "selector",
          "grid": false,
          "form": true,
          "section": "principal",
          "seq": 45,
          "readOnlyLogic": "@Processed@='Y'",
          "defaultExpr": "@C_Currency_ID@"
        },
        "documentStatus": {
          "visibility": "readOnly",
          "grid": true,
          "searchable": true,
          "form": false
        },
        "partnerAddress": {
          "reference": "BusinessPartnerLocation",
          "inputMode": "dependent",
          "dependsOn": {
            "field": "businessPartner",
            "filterKey": "C_BPartner_ID"
          },
          "grid": true,
          "section": "principal",
          "seq": 50
        },
        "accountingDate": {
          "visibility": "system",
          "_note": "ETP-4531 (redefined 2026-07-17): accounting date is now hidden and unified with the document date internally; the Java-side guard that used to block this cascade has been removed so the native document-date→accounting-date coupling flows through untouched."
        },
        "orderReference": {
          "visibility": "discarded"
        },
        "description": {
          "inputMode": "textarea",
          "section": "collapsed"
        },
        "shippingCompany": {
          "visibility": "discarded"
        },
        "trackingNo": {
          "visibility": "discarded"
        },
        "shipDate": {
          "visibility": "discarded"
        },
        "deliveryTerms": {
          "visibility": "discarded"
        },
        "deliveryMethod": {
          "visibility": "discarded"
