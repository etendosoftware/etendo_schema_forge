        },
        "organization": {
          "visibility": "system"
        },
        "salesTransaction": {
          "visibility": "system"
        },
        "documentType": {
          "visibility": "system"
        },
        "created": {
          "visibility": "system"
        },
        "updated": {
          "visibility": "system"
        },
        "active": {
          "visibility": "discarded"
        },
        "deliveryLocation": {
          "visibility": "discarded"
        },
        "project": {
          "visibility": "discarded"
        },
        "processed": {
          "visibility": "readOnly",
          "form": false,
          "grid": false
        },
        "movementType": {
          "visibility": "discarded"
        },
        "freightCostRule": {
          "visibility": "discarded"
        },
        "freightAmount": {
          "visibility": "discarded"
        },
        "chargeAmount": {
          "visibility": "discarded"
        },
        "costcenter": {
          "visibility": "discarded"
        },
        "stDimension": {
          "visibility": "discarded"
        },
        "ndDimension": {
          "visibility": "discarded"
        },
        "printDescription": {
          "visibility": "discarded"
        },
        "invoiceStatus": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "salesOrder": {
          "visibility": "system"
        },
        "isnettingshipment": {
          "visibility": "discarded"
        },
        "externalBusinessPartnerReference": {
          "visibility": "discarded"
        },
        "createLinesFrom": {
          "visibility": "discarded"
        },
