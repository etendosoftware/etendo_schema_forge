{
  "$schema": "decisions-v2",
  "window": {
    "agentPrompt": "#REF#agent-prompts/financial-account/spec.md",
    "category": "finance",
    "name": "Accounts",
    "detailEntity": null,
    "customComponents": {
      "headerTable": "AccountsHeaderTable"
    },
    "rowQuickActions": { "enabled": false },
    "hideCreate": true,
    "hidePrint": true,
    "hideMoreMenu": true,
    "hideListFilters": true,
    "listSortBy": "name asc"
  },
  "entities": {
    "account": {
      "javaQualifier": "financialAccountHeaderHandler",
      "agentPrompt": "#REF#agent-prompts/financial-account/account.md",
      "fields": {
        "name": { "visibility": "editable", "grid": true, "gridOrder": 1, "required": true, "gridLabelKey": "financeAccountsColAccount", "cellType": "accountName" },
        "type": {
          "visibility": "editable",
          "grid": true,
          "gridOrder": 2,
          "gridLabelKey": "financeAccountsColType",
          "cellType": "accountType",
          "searchable": true,
          "multiField": {
            "parts": [
              { "field": "type", "labelKey": "financeAccountsColType" },
              { "field": "iBAN", "labelKey": "financeAccountsColIban" }
            ]
          },
          "reason": "The Tipo cell shows TWO values — the account type and, under it, the IBAN — so a single header could only ever sort by one of them. The multiField decorator splits the header into two independently sortable segments (\"Tipo & IBAN\"), the same mechanism the Product list uses for \"Identificador & Nombre\". The cell body is untouched: cellType accountType still renders TypeCell, because DataTable's col.render wins over the multiField cell renderer. Both parts carry searchable:true because F18 blocks a sort-enabled part that is not queryable.",
          "agentPrompt": "#REF#agent-prompts/financial-account/account.type.md"
        },
        "currency": { "visibility": "editable", "grid": false, "required": true },
        "currentBalance": { "visibility": "readOnly", "grid": true, "gridOrder": 4, "gridLabelKey": "financeAccountsColBalance", "cellType": "accountBalance" },
        "description": { "visibility": "editable", "grid": false },
        "iBAN": { "visibility": "editable", "grid": false, "searchable": true, "agentPrompt": "#REF#agent-prompts/financial-account/account.iban.md" },
        "swiftCode": { "visibility": "editable", "grid": false, "agentPrompt": "#REF#agent-prompts/financial-account/account.swift-code.md" },
        "bankCode": { "visibility": "editable", "grid": false },
        "branchCode": { "visibility": "editable", "grid": false },
        "partialAccountNo": { "visibility": "editable", "grid": false },
        "accountNo": { "visibility": "editable", "grid": false, "agentPrompt": "#REF#agent-prompts/financial-account/account.account-no.md" },
        "businessPartner": { "visibility": "system" },
        "matchingAlgorithm": { "visibility": "system" },
        "initialBalance": { "visibility": "system" },
        "creditLimit": { "visibility": "discarded" },
        "locationAddress": { "visibility": "discarded" },
        "default": { "visibility": "readOnly", "grid": false },
        "genericAccountNo": { "visibility": "discarded" },
        "iNENo": { "visibility": "discarded" },
        "country": { "visibility": "editable", "grid": true, "gridOrder": 3, "gridLabelKey": "financeAccountsColCountry", "cellType": "accountCountry", "required": true, "displayLogic": null, "reason": "ETP-4896 — country was backend-only (derived from the IBAN and overwritten on every write), leaving cash/card/IBAN-less bank accounts with no country and no way for the user to set one. Now user-editable and always required — pre-filled with the organization's country, never locked (no readOnlyLogic). displayLogic explicitly nulled: the raw AD field carries '@Type@='B'' (IBAN's own display logic), which would otherwise hide Country outside Bank accounts. Grid column added right after Type (gridOrder 3, ETP-4896 follow-up) — Balance/Pending bumped to 4/5." },
        "bankFormat": { "visibility": "discarded" },
        "typewriteoff": { "visibility": "discarded" },
        "writeofflimit": { "visibility": "editable" },
        "bankDigitcontrol": { "visibility": "discarded" },
        "accountDigitcontrol": { "visibility": "discarded" },
        "routingNo": { "visibility": "discarded" },
        "lastreconciliation": { "visibility": "system" },
        "lastreconbalance": { "visibility": "system" },
        "aprmIsfundstransEnabled": { "visibility": "discarded" },
        "aprmGlitemDiff": { "visibility": "editable", "grid": false },
        "eTGODateTolerance": { "visibility": "editable" },
        "eTGOAmountTolerance": { "visibility": "editable" },
        "eTGOPendingCount": { "visibility": "readOnly", "form": false, "grid": true, "gridOrder": 5, "gridLabelKey": "financeAccountsColPending", "cellType": "reconcilePill", "reason": "\"Por conciliar\". Was an entities.account.virtualFields[] entry injected by FinancialAccountHandler.afterHandle; became the EM_ETGO_Pending_Count stored computed column (EPL-1807 engine) so the column can be sorted and filtered server-side — a value injected in afterHandle can only be reordered inside the page the SQL already selected. Being a real field also retires the two workarounds the virtual one needed: cellType no longer goes through VIRTUAL_FIELD_CELL_TYPES and the header no longer needs window.labelOverrides, because appendVirtualFields' closed whitelist excluded both keys." }
      }
    },
    "transaction": {
      "javaQualifier": "document-posting",
      "fields": {
        "transactionDate": { "visibility": "readOnly", "grid": true, "gridOrder": 1 },
        "documentNo": { "visibility": "readOnly", "grid": true, "gridOrder": 2 },
        "businessPartner": { "visibility": "readOnly", "grid": true, "gridOrder": 3, "displayLogic": "@Trxtype@!''", "displayLogicJs": "record['transactionType'] !== ''", "reason": "ETP-4529 — Contacto is always shown regardless of the accounting-dimension config (strips @ACCT_DIMENSION_DISPLAY@ from the raw '@ACCT_DIMENSION_DISPLAY@ & @Trxtype@!\\'\\'' expression), but the unrelated Trxtype condition is preserved as client-evaluable JS: Trxtype (Transaction Type — BP Deposit/Withdrawal/Bank fee) is mandatory with a default, so this only hides the field for the instant before a type is set on a brand-new record." },
        "description": { "visibility": "readOnly", "grid": true, "gridOrder": 4 },
        "status": { "visibility": "readOnly", "grid": true, "gridOrder": 5 },
        "transactionType": { "visibility": "readOnly", "grid": true, "gridOrder": 6 },
        "gLItem": { "visibility": "readOnly", "grid": true, "gridOrder": 7 },
        "depositAmount": { "visibility": "readOnly", "grid": false },
        "paymentAmount": { "visibility": "readOnly", "grid": false },
        "posted": {
          "visibility": "readOnly",
          "type": "boolean",
          "form": false,
          "grid": true,
          "badge": true,
          "badgeLabels": {
            "true":  { "en_US": "Posted",     "es_ES": "Contabilizado"   },
            "false": { "en_US": "Not posted", "es_ES": "Sin contabilizar" }
          },
          "badgeVariants": {
            "true": "green",
            "false": "orange"
          }
        },
        "finPaymentID": { "visibility": "system" },
        "currency": { "visibility": "system" },
        "organization": { "visibility": "readOnly", "grid": false },
        "eTGOFinaccTransDest": { "visibility": "readOnly", "grid": false, "dimensionsPanel": true, "seq": 5, "reason": "Funds-transfer counterpart link (ETP-4882). Set automatically by FundsTransferDestinationHook, never by the user, so it is readOnly regardless of the AD column's Updatable flag. Declared first in the panel so it renders immediately before the accounting dimensions, and rendered by a bespoke link renderer (MOVEMENT_PANEL_RENDERERS) that resolves BOTH transfer directions from the handler's transfer* props." },
        "project": { "visibility": "readOnly", "grid": false, "dimensionsPanel": true, "seq": 10 },
        "costCenter": { "visibility": "readOnly", "grid": false, "dimensionsPanel": true, "seq": 20 },
        "activity": { "visibility": "readOnly", "grid": false },
        "salesCampaign": { "visibility": "readOnly", "grid": false },
        "salesRegion": { "visibility": "readOnly", "grid": false },
        "stDimension": { "visibility": "readOnly", "grid": false },
        "ndDimension": { "visibility": "readOnly", "grid": false },
        "product": { "visibility": "readOnly", "grid": false, "dimensionsPanel": true, "seq": 30 },
        "lineNo": { "visibility": "system" },
        "reconciliation": { "visibility": "system" },
        "dateAcct": { "visibility": "system" },
        "processed": { "visibility": "system" },
        "processNow": { "visibility": "discarded" },
        "createdByAlgorithm": { "visibility": "discarded" },
        "aprmFinaccTransOrigin": { "visibility": "discarded" },
        "aprmProcessed": { "visibility": "discarded" },
        "foreignCurrency": { "visibility": "discarded" },
        "foreignAmount": { "visibility": "discarded" },
        "foreignConversionRate": { "visibility": "discarded" }
      }
    },
    "importedBankStatements": {
      "fields": {
        "documentNo": { "visibility": "readOnly", "grid": true, "gridOrder": 1 },
        "name": { "visibility": "editable", "grid": true, "gridOrder": 2 },
        "fileName": { "visibility": "readOnly", "grid": true, "gridOrder": 3 },
        "notes": { "visibility": "editable", "grid": true, "gridOrder": 4 },
        "importdate": { "visibility": "readOnly", "grid": true, "gridOrder": 5 },
        "transactionDate": { "visibility": "readOnly", "grid": true, "gridOrder": 6 },
        "posted": { "visibility": "system" },
        "documentType": { "visibility": "system" },
        "fINReconciliationID": { "visibility": "system" },
        "aPRMProcessBankStatementForce": { "visibility": "discarded" },
        "aPRMProcessBankStatement": { "visibility": "system" }
      }
    },
    "bankStatementLines": {
      "fields": {
        "transactionDate": { "visibility": "readOnly", "grid": true, "gridOrder": 1 },
        "description": { "visibility": "editable", "grid": true, "gridOrder": 2 },
        "bpartnername": { "visibility": "editable", "grid": true, "gridOrder": 3 },
        "businessPartner": { "visibility": "editable", "grid": true, "gridOrder": 4 },
        "gLItem": { "visibility": "editable", "grid": true, "gridOrder": 5 },
        "referenceNo": { "visibility": "editable", "grid": true, "gridOrder": 6 },
        "dramount": { "visibility": "editable", "grid": true, "gridOrder": 7 },
        "cramount": { "visibility": "editable", "grid": true, "gridOrder": 8 },
        "lineNo": { "visibility": "system" },
        "financialAccountTransaction": { "visibility": "system" },
        "matchingtype": { "visibility": "system" },
        "matchedDocument": { "visibility": "system" },
        "bankStatement": { "visibility": "system" },
        "c43Description": { "visibility": "discarded" },
        "pSD2TransactionIdentifier": { "visibility": "discarded" },
        "pSD2BalanceAfterTransaction": { "visibility": "discarded" }
      }
    },
    "accountingHistory": { "exclude": true },
    "exchangeRates": { "exclude": true },
    "accountingConfiguration": {
      "javaQualifier": "financialAccountAccountingHandler",
      "fields": {
        "fINAssetAcct": { "visibility": "editable", "grid": false, "required": true },
        "fINTransitoryAcct": { "visibility": "editable", "grid": false },
        "accountingSchema": { "visibility": "system" },
        "active": { "visibility": "system" },
        "id": { "visibility": "system" },
        "account": { "visibility": "system" },
        "organization": { "visibility": "system" },
        "client": { "visibility": "system" },
        "creationDate": { "visibility": "system" },
        "createdBy": { "visibility": "system" },
        "updated": { "visibility": "system" },
        "updatedBy": { "visibility": "system" },
        "enablebankstatement": { "visibility": "discarded" },
        "fINBankrevaluationgainAcct": { "visibility": "discarded" },
        "fINBankrevaluationlossAcct": { "visibility": "discarded" },
        "fINBankfeeAcct": { "visibility": "discarded" },
        "inTransitPaymentAccountIN": { "visibility": "discarded" },
        "depositAccount": { "visibility": "discarded" },
        "clearedPaymentAccount": { "visibility": "discarded" },
        "fINOutIntransitAcct": { "visibility": "discarded" },
        "withdrawalAccount": { "visibility": "discarded" },
        "clearedPaymentAccountOUT": { "visibility": "discarded" },
        "receivePaymentAccount": { "visibility": "discarded" },
        "makePaymentAccount": { "visibility": "discarded" },
        "creditAccount": { "visibility": "discarded" },
        "debitAccount": { "visibility": "discarded" }
      }
    },
    "paymentMethod": { "exclude": true },
    "reconciliations": {
      "fields": {
        "documentNo": { "visibility": "readOnly", "grid": true, "gridOrder": 1 },
        "transactionDate": { "visibility": "readOnly", "grid": true, "gridOrder": 2 },
        "endingDate": {
          "visibility": "readOnly",
          "grid": false,
          "reason": "ETP-4795 — a cash close writes Statementdate and Dateto with the same value, so the two dates are always identical. The UI shows one column, \"Fecha cierre\", backed by transactionDate."
        },
        "startingbalance": { "visibility": "readOnly", "grid": true, "gridOrder": 3 },
        "endingBalance": { "visibility": "readOnly", "grid": true, "gridOrder": 4 },
        "documentStatus": { "visibility": "readOnly", "grid": true, "gridOrder": 5 },
        "posted": {
          "visibility": "readOnly",
          "type": "string",
          "form": false,
          "grid": true,
          "gridOrder": 6,
          "reason": "ETP-4795 — accounting status of the reconciliation. Read from Posted, NOT from EM_Etblkp_Accountingstatus: that mirror column is maintained by a trigger that only fires on UPDATE, so freshly inserted rows keep the 'l' (Pending Refresh) default and go stale."
        },
        "documentType": { "visibility": "system" },
        "account": { "visibility": "system" },
        "processed": { "visibility": "system" },
        "processNow": { "visibility": "system" },
        "printdetailed": { "visibility": "system" },
        "printsummary": { "visibility": "system" },
        "aPRMProcessReconciliation": { "visibility": "system" },
        "etblkpAccountingstatus": { "visibility": "discarded" },
        "aPRMReconciledItemNo": { "visibility": "discarded" },
        "aPRMReconciledItemAmount": { "visibility": "discarded" },
        "aPRMUnReconciledItemNo": { "visibility": "discarded" },
        "aPRMUnReconciledItemAmount": { "visibility": "discarded" },
        "aPRMOutstandingPaymentsItemNo": { "visibility": "discarded" },
        "aPRMOutstandingPaymentsItemsAmount": { "visibility": "discarded" },
        "aPRMOutstandingDepositsItemNo": { "visibility": "discarded" },
        "aPRMOutstandingDepositItemsAmount": { "visibility": "discarded" },
        "aPRMPrintDetailed": { "visibility": "discarded" },
        "aPRMPrintSummary": { "visibility": "discarded" },
        "aprmProcessRec": { "visibility": "discarded" },
        "aPRMProcessReconciliationForce": { "visibility": "discarded" },
        "etprReactivateRecon": { "visibility": "discarded" },
        "etprRemoveReconciliation": { "visibility": "discarded" },
        "etblkpBulkposting": { "visibility": "discarded" }
      }
    },
    "clearedItems": {
      "readOnly": true,
      "fields": {
        "transactionDate": { "visibility": "readOnly", "grid": true, "gridOrder": 1 },
        "accountingDate": {
          "visibility": "readOnly",
          "grid": false,
          "reason": "ETP-4795 — a single \"Fecha\" column, backed by transactionDate. A cash close writes Statementdate and Dateacct with the same value (including the date rewrite it applies to post-dated movements), so showing both only ever repeated the same date."
        },
        "description": { "visibility": "readOnly", "grid": true, "gridOrder": 2 },
        "financialAccountTransaction": { "visibility": "readOnly", "grid": true, "gridOrder": 3 },
        "payment": { "visibility": "readOnly", "grid": true, "gridOrder": 4 },
        "currency": { "visibility": "readOnly", "grid": true, "gridOrder": 5 },
        "transactionType": { "visibility": "readOnly", "grid": true, "gridOrder": 6 },
        "gLItem": { "visibility": "readOnly", "grid": true, "gridOrder": 7 },
        "depositAmount": {
          "visibility": "readOnly",
          "grid": false,
          "reason": "ETP-4795 — still fetched, but not its own column: the UI merges deposit and payment into a single signed 'Importe' column (green in / red out), like the Movements grid. A signed net is a derived value, not an AD field, so it is a structural column in the table rather than a contract one."
        },
        "paymentAmount": { "visibility": "readOnly", "grid": false },
        "bankStatementLine": {
          "visibility": "readOnly",
          "grid": false,
          "reason": "ETP-4795 — always NULL on a cash reconciliation (no bank statements), so it would be an empty column on the only tab that renders this entity."
        },
        "project": { "visibility": "readOnly", "grid": false },
        "stDimension": { "visibility": "readOnly", "grid": false },
        "ndDimension": { "visibility": "readOnly", "grid": false },
        "reconciliation": { "visibility": "system" },
        "financialAccount": { "visibility": "system" },
        "activity": { "visibility": "system" },
        "salesCampaign": { "visibility": "system" }
      }
    },
    "accounting": { "exclude": true },
    "bankConnections": { "exclude": true }
  },
  "version": 2
}
