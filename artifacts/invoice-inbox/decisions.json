{
  "$schema": "decisions-v2",
  "window": {
    "category": "purchases",
    "name": "Invoice Inbox",
    "layoutType": "custom",
    "hidePrint": true
  },
  "entities": {
    "header": {
      "agentPrompt": "The invoice inbox (Bandeja de facturas): supplier documents a person uploaded in the app, read by OCR. status is one of these exact codes: PROCESSING (being read), PENDING_REVIEW, READY and ERROR (all three are still pending to become a purchase invoice; ERROR means something must be fixed, see errorCode), CONFIRMED (became the purchase invoice in invoice) and DISCARDED. For what is pending, filter status in [PENDING_REVIEW, READY, ERROR]; any other value matches nothing. An agent can only read the inbox: uploading, reviewing, confirming and discarding are done by a person in the app.",
      "methods": [
        "GET",
        "GETBYID"
      ],
      "fields": {
        "fileName": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 1
        },
        "source": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 2
        },
        "creationDate": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 3
        },
        "businessPartner": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 4
        },
        "extractedName": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 5
        },
        "extractedTaxID": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 6
        },
        "orderReference": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 7
        },
        "invoiceDate": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 8
        },
        "grandTotalAmount": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 9
        },
        "status": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 10
        },
        "errorCode": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 11
        },
        "duplicateOfInvoice": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "gridOrder": 12
        },
        "sender": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "invoice": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "errorDetail": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "currency": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "newProducts": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "totalMismatch": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "discardedAt": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "reviewed": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "adjusted": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "targetType": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        },
        "currentData": {
          "visibility": "discarded",
          "reason": "Large JSON text (up to 1 MB); never served in the list. The review panel (ETP-6050) reads the document through the `review` action (GET /sws/neo/invoice-inbox/header/{id}/action/review) and edits it through the `apply` and `mark-reviewed` actions (POST, REST only, hidden from MCP), not through this spec."
        },
        "extractedData": {
          "visibility": "discarded",
          "reason": "Large JSON text (up to 1 MB); never served in the list. The review panel (ETP-6050) reads the document through the `review` action (GET /sws/neo/invoice-inbox/header/{id}/action/review) and edits it through the `apply` and `mark-reviewed` actions (POST, REST only, hidden from MCP), not through this spec."
        },
        "processingAttempts": {
          "visibility": "system",
          "derivation": "fromConfig",
          "reason": "Server-side processing bookkeeping; never shown or written by the UI."
        },
        "processingLease": {
          "visibility": "system",
          "derivation": "fromConfig",
          "reason": "Server-side processing bookkeeping; never shown or written by the UI."
        },
        "processedAt": {
          "visibility": "system",
          "derivation": "fromConfig",
          "reason": "Server-side processing bookkeeping; never shown or written by the UI."
        },
        "active": {
          "visibility": "readOnly",
          "grid": false,
          "form": false
        }
      }
    }
  }
}
