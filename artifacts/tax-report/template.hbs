{{!-- Tax Report --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8"><style>
{{{css}}}
/* Section banners (Purchases / Sales) */
.section-banner { font-size: 15px; font-weight: bold; color: #fff; background: #1e3a5f; padding: 6px 12px; margin: 20px 0 0; }

/* Tax group header */
.tax-group-header td { font-weight: bold; font-size: 13px; background: #dde6f0; padding: 6px 8px; border-top: 2px solid #1e3a5f; border-bottom: 1px solid #aac; }
.tax-group-total td { font-weight: bold; background: #f5f7fa; border-top: 1px solid #aaa; border-bottom: 2px solid #333; }

/* BP sub-group */
.bp-header-row td { font-weight: 600; font-size: 12px; padding-top: 8px; padding-bottom: 2px; border: none; background: transparent; color: #333; }
.bp-total-row td { font-style: italic; color: #555; border-top: 1px dashed #ccc; font-size: 11px; }

/* Document rows */
.doc-row td { border: none; font-size: 11px; }
{{#if meta.isInteractive}}
.doc-link { cursor: pointer; color: #2563eb; text-decoration: underline; }
.doc-link:hover { opacity: 0.75; text-decoration: none; }
{{/if}}
/* Belt-and-suspenders (ETP-5013 follow-up, see report-trial-balance's own
   template for the full rationale): a browser's own Cmd/Ctrl+P on the live
   preview bypasses meta.isInteractive entirely, so @media print is what
   actually catches it — plus our own jsreport PDF export, uniformly. */
@media print {
  .doc-link { color: inherit !important; text-decoration: none !important; cursor: default !important; }
}

/* Category / Rate summary */
.cat-header td, .rate-header td { font-weight: bold; font-size: 13px; background: #f0f4fa; padding: 6px 8px; border-top: 2px solid #1e3a5f; border-bottom: 1px solid #aac; }
.cat-row td, .rate-row td { font-size: 12px; }
.cat-total td, .rate-total td { font-weight: bold; background: #f5f7fa; border-top: 1px solid #aaa; border-bottom: 2px solid #333; }

tfoot tr td { font-weight: bold; border-top: 2px solid #333; }
.report-empty { padding: 48px 0; text-align: center; color: #888; font-size: 14px; }
.region-title { font-size: 13px; font-weight: bold; margin: 28px 0 0; color: #1e3a5f; border-bottom: 2px solid #1e3a5f; padding-bottom: 3px; }
</style></head>
<body><div class="report-container">

  <div class="report-header">
    <div class="report-title">{{meta.title}}</div>
    {{> document-branding}}
  </div>

  {{#if meta.filters.length}}
  <div class="report-filters-grid">
    {{#each meta.filters}}
    <div><span>{{this.label}}: </span><strong>{{this.value}}</strong></div>
    {{/each}}
  </div>
  {{/if}}

  {{!-- ================================================================ --}}
  {{!-- REGION 1: DETAIL                                                 --}}
  {{!-- ================================================================ --}}
  {{#if meta.showDetails}}
  {{#if (eq meta.params.transactionType 'P')}}
    {{#if rows.purchase.detail.length}}
      {{> detailSection sectionRows=rows.purchase.detail label=meta.labels.purchasesPayments groupByBp=meta.groupByBp}}
    {{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'S')}}
    {{#if rows.sales.detail.length}}
      {{> detailSection sectionRows=rows.sales.detail label=meta.labels.salesReceipts groupByBp=meta.groupByBp}}
    {{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'B')}}
    {{#if rows.purchase.detail.length}}
      {{> detailSection sectionRows=rows.purchase.detail label=meta.labels.purchasesPayments groupByBp=meta.groupByBp}}
    {{/if}}
    {{#if rows.sales.detail.length}}
      {{> detailSection sectionRows=rows.sales.detail label=meta.labels.salesReceipts groupByBp=meta.groupByBp}}
    {{/if}}
  {{/if}}

  {{/if}}

  {{!-- ================================================================ --}}
  {{!-- REGION 2: SUMMARY BY TAX CATEGORY                               --}}
  {{!-- ================================================================ --}}
  <div class="region-title">{{meta.labels.summaryByTaxCategory}}</div>

  {{#if (eq meta.params.transactionType 'P')}}
    {{#if rows.purchase.summaryByCategory.length}}{{> categorySection groups=rows.purchase.summaryByCategory label=meta.labels.purchasesPayments}}{{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'S')}}
    {{#if rows.sales.summaryByCategory.length}}{{> categorySection groups=rows.sales.summaryByCategory label=meta.labels.salesReceipts}}{{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'B')}}
    {{#if rows.purchase.summaryByCategory.length}}{{> categorySection groups=rows.purchase.summaryByCategory label=meta.labels.purchasesPayments}}{{/if}}
    {{#if rows.sales.summaryByCategory.length}}{{> categorySection groups=rows.sales.summaryByCategory label=meta.labels.salesReceipts}}{{/if}}
  {{/if}}

  {{!-- ================================================================ --}}
  {{!-- REGION 3: SUMMARY BY TAX RATE                                   --}}
  {{!-- ================================================================ --}}
  <div class="region-title">{{meta.labels.summaryByTaxRate}}</div>

  {{#if (eq meta.params.transactionType 'P')}}
    {{#if rows.purchase.summaryByRate.length}}{{> rateSection groups=rows.purchase.summaryByRate label=meta.labels.purchasesPayments}}{{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'S')}}
    {{#if rows.sales.summaryByRate.length}}{{> rateSection groups=rows.sales.summaryByRate label=meta.labels.salesReceipts}}{{/if}}
  {{/if}}
  {{#if (eq meta.params.transactionType 'B')}}
    {{#if rows.purchase.summaryByRate.length}}{{> rateSection groups=rows.purchase.summaryByRate label=meta.labels.purchasesPayments}}{{/if}}
    {{#if rows.sales.summaryByRate.length}}{{> rateSection groups=rows.sales.summaryByRate label=meta.labels.salesReceipts}}{{/if}}
  {{/if}}

  {{#if meta.isInteractive}}
  <div class="print-only-footer-note">{{meta.ui.printedOn}} {{formatDate meta.generatedAt}}</div>
  {{/if}}
</div>

{{!-- ================================================================ --}}
{{!-- PARTIAL: Detail table (pre-grouped by tax, optionally by BP)      --}}
{{!-- ================================================================ --}}
{{#*inline "detailSection"}}
<div class="section-banner">{{label}}</div>
<table class="report-table">
  <thead><tr>
    <th style="width:16%">{{@root.meta.labels.taxName}}</th>
    <th style="width:9%">{{@root.meta.labels.docNo}}</th>
    <th style="width:8%">{{@root.meta.labels.docType}}</th>
    <th style="width:8%">{{@root.meta.labels.docDate}}</th>
    <th style="width:8%">{{@root.meta.labels.acctDate}}</th>
    <th style="width:14%">{{@root.meta.labels.bPartnerId}}</th>
    <th style="width:6%">{{@root.meta.labels.country}}</th>
    <th style="width:6%">{{@root.meta.labels.region}}</th>
    <th style="width:8%" class="cell-amount">{{@root.meta.labels.taxBaseAmt}}</th>
    <th style="width:8%" class="cell-amount">{{@root.meta.labels.taxAmt}}</th>
    <th style="width:9%" class="cell-amount">{{@root.meta.labels.totalAmt}}</th>
  </tr></thead>
  <tbody>
    {{#each sectionRows}}
    <tr class="tax-group-header">
      <td>{{taxName}}</td>
      <td></td><td></td><td></td><td></td><td></td><td></td><td></td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
    </tr>
    {{#if @root.meta.groupByBp}}
      {{#each bpGroups}}
      <tr class="bp-header-row"><td></td><td colspan="10">{{bPartner}}</td></tr>
      {{#each docs}}<tr class="doc-row">
        <td></td>
        <td><span class="doc-link" onclick="window.parent.postMessage({type:'navigate-invoice',invoiceId:'{{invoiceId}}'},'*')">{{docNo}}</span></td>
        <td>{{docType}}</td>
        <td>{{formatDateDisplay docDate}}</td>
        <td>{{formatDateDisplay acctDate}}</td>
        <td></td>
        <td>{{bpCountry}}</td>
        <td>{{bpRegion}}</td>
        <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
        <td class="cell-amount">{{formatCurrency taxAmt}}</td>
        <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      </tr>{{/each}}
      <tr class="bp-total-row">
        <td></td><td colspan="7">{{@root.meta.ui.total}} {{bPartner}}</td>
        <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
        <td class="cell-amount">{{formatCurrency taxAmt}}</td>
        <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      </tr>
      {{/each}}
    {{else}}
      {{#each docs}}<tr class="doc-row">
        <td></td>
        <td><span class="doc-link" onclick="window.parent.postMessage({type:'navigate-invoice',invoiceId:'{{invoiceId}}'},'*')">{{docNo}}</span></td>
        <td>{{docType}}</td>
        <td>{{formatDateDisplay docDate}}</td>
        <td>{{formatDateDisplay acctDate}}</td>
        <td>{{bPartner}}</td>
        <td>{{bpCountry}}</td>
        <td>{{bpRegion}}</td>
        <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
        <td class="cell-amount">{{formatCurrency taxAmt}}</td>
        <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      </tr>{{/each}}
    {{/if}}
    <tr class="tax-group-total">
      <td colspan="8">{{@root.meta.ui.total}} {{taxName}}</td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
    </tr>
    {{/each}}
  </tbody>
  <tfoot><tr>
    <td colspan="8">{{@root.meta.ui.totals}}</td>
    <td class="cell-amount">{{formatCurrency (sumField sectionRows 'taxBaseAmt')}}</td>
    <td class="cell-amount">{{formatCurrency (sumField sectionRows 'taxAmt')}}</td>
    <td class="cell-amount">{{formatCurrency (sumField sectionRows 'totalAmt')}}</td>
  </tr></tfoot>
</table>
{{/inline}}

{{!-- ================================================================ --}}
{{!-- PARTIAL: Summary by Tax Category                                  --}}
{{!-- ================================================================ --}}
{{#*inline "categorySection"}}
<div class="section-banner">{{label}}</div>
<table class="report-table">
  <thead><tr>
    <th style="width:28%">{{@root.meta.labels.taxName}}</th>
    <th style="width:8%" class="cell-amount">{{@root.meta.labels.rate}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.taxBaseAmt}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.taxAmt}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.totalAmt}}</th>
    <th style="width:10%" class="cell-amount">{{@root.meta.labels.noPartners}}</th>
  </tr></thead>
  <tbody>
    {{#each groups}}
    <tr class="cat-header"><td colspan="6">{{@root.meta.labels.totalByTaxCategory}} - {{taxCategoryName}}</td></tr>
    {{#each taxes}}<tr class="cat-row">
      <td>{{taxName}}</td>
      <td class="cell-amount">{{formatNumber rate}}</td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      <td class="cell-amount">{{bpCount}}</td>
    </tr>{{/each}}
    <tr class="cat-total">
      <td colspan="2">{{@root.meta.ui.totals}}</td>
      <td class="cell-amount">{{formatCurrency (sumField taxes 'taxBaseAmt')}}</td>
      <td class="cell-amount">{{formatCurrency (sumField taxes 'taxAmt')}}</td>
      <td class="cell-amount">{{formatCurrency (sumField taxes 'totalAmt')}}</td>
      <td></td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/inline}}

{{!-- ================================================================ --}}
{{!-- PARTIAL: Summary by Tax Rate                                      --}}
{{!-- ================================================================ --}}
{{#*inline "rateSection"}}
<div class="section-banner">{{label}}</div>
<table class="report-table">
  <thead><tr>
    <th style="width:26%">{{@root.meta.labels.bPartnerId}} / {{@root.meta.labels.taxName}}</th>
    <th style="width:8%" class="cell-amount">{{@root.meta.labels.rate}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.taxBaseAmt}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.taxAmt}}</th>
    <th style="width:16%" class="cell-amount">{{@root.meta.labels.totalAmt}}</th>
    <th style="width:10%" class="cell-amount">{{@root.meta.labels.noPartners}}</th>
  </tr></thead>
  <tbody>
    {{#each groups}}
    <tr class="rate-header"><td colspan="6">{{formatNumber rate}}%</td></tr>
    {{#each bpGroups}}
    <tr class="bp-header-row">
      <td colspan="2"><strong>{{bPartner}}</strong>{{#if bpTaxId}} <span style="color:#666;font-size:10px;">{{@root.meta.labels.bpTaxId}}: {{bpTaxId}}</span>{{/if}}</td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      <td class="cell-amount">1</td>
    </tr>
    {{#each taxes}}<tr class="rate-row">
      <td style="padding-left:20px">{{taxName}}</td>
      <td class="cell-amount">{{formatNumber rate}}</td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      <td></td>
    </tr>{{/each}}
    {{/each}}
    <tr class="rate-total">
      <td colspan="2">{{@root.meta.ui.totals}}</td>
      <td class="cell-amount">{{formatCurrency taxBaseAmt}}</td>
      <td class="cell-amount">{{formatCurrency taxAmt}}</td>
      <td class="cell-amount">{{formatCurrency totalAmt}}</td>
      <td class="cell-amount">{{bpCount}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{/inline}}

</body></html>
