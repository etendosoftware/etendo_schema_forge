    },
    "receivedInvoices": {
      "fields": {
        "eTGOCurrencyRate": { "visibility": "discarded" }
      }
    },
    "issuedInvoices(previousPeriod)": {
      "fields": {
        "eTGOCurrencyRate": { "visibility": "discarded" }
      }
    },
    "receivedInvoices(previousPeriod)": {
      "fields": {
        "eTGOCurrencyRate": { "visibility": "discarded" }
      }
    }
  }
}
