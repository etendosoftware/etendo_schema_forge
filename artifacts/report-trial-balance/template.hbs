{{!-- Trial Balance report template --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
{{{css}}}
{{#if meta.isInteractive}}
.account-link { cursor: pointer; color: #2563eb; text-decoration: underline; font-weight: 600; }
.account-link:hover { opacity: 0.75; text-decoration: none; }
{{/if}}
/* Belt-and-suspenders for the SAME "looks clickable but isn't" bug
   (ETP-5013 follow-up): a browser's own Cmd/Ctrl+P on the live interactive
   preview renders THIS page directly — bypassing our /render?format=pdf
   endpoint (and meta.isInteractive) entirely — so the `if` above alone
   still leaves the link blue there. `@media print` catches every printed
   output uniformly (our own jsreport PDF included — its chrome-pdf recipe
   emulates print media, same reason the `@page` rule above already sizes
   correctly), while leaving the on-screen interactive color untouched. */
@media print {
  .account-link { color: inherit !important; text-decoration: none !important; cursor: default !important; font-weight: inherit !important; }
}
/* Account blocks (ETP-5013) — one bordered block PER ACCOUNT, its dimension
   breakdown nested inside and the account itself as the block's closing total
   row. Matches Classic's real Trial Balance layout (verified against a real
   Classic PDF export) — replaces the ETP-4898 "dim-group" card, which nested
   accounts inside a dimension instead and made every dimension's "total" net
   to 0 (summing unrelated accounts for one contact has no accounting
   meaning). Only used when "Agrupar por" picks a dimension; the flat
   single-level table below is untouched. */
.acct-block { margin-bottom: 3mm; }
/* .acct-total is ALSO the flat (ungrouped) branch's single grand-total row
   (below) — its own border-top is all that row needs, so the heavy
   between-blocks separator is scoped to .acct-block (grouped mode only),
   never bare .acct-total, or it leaks into the flat view's Total row too. */
.acct-total td { font-weight: 700; background: #f1f5f9; border-top: 1px solid #cbd5e1 !important; }
.acct-block .acct-total td { border-bottom: 2px solid #1a1a2e !important; }
/* The heavy separator only makes sense BETWEEN blocks — after the last
   account, nothing follows it, so it read as a stray line before the footer. */
.acct-block:last-of-type .acct-total td { border-bottom: none !important; }
</style>
</head>
<body><div class="report-container">
  <div class="report-header">
    <div><div class="report-title">{{meta.title}}</div>
</div>
    {{> document-branding}}
  </div>
  {{#if meta.filters.length}}
  <div class="report-filters-grid">
    {{#each meta.filters}}
    <div><span>{{this.label}}: </span><strong>{{this.value}}</strong></div>
    {{/each}}
  </div>
  {{/if}}


  {{#ifCond meta.params.groupBy '!==' ''}}
  {{#each meta.tbGroups}}
  <table class="report-table acct-block" style="table-layout: fixed;">
    <colgroup>
      <col style="width:10%"><col style="width:30%"><col style="width:15%">
      <col style="width:12%"><col style="width:12%"><col style="width:15%">
    </colgroup>
    {{#ifCond @index '===' 0}}
    <thead>
      <tr>
        <th style="width:10%">{{@root.meta.labels.account_no}}</th>
        <th style="width:30%">{{@root.meta.labels.account_name}}</th>
        <th style="width:15%" class="cell-amount">{{@root.meta.labels.balanceAsOf}} {{@root.meta.params.dateFrom}}</th>
        <th style="width:12%" class="cell-amount">{{@root.meta.labels.activity_debit}}</th>
        <th style="width:12%" class="cell-amount">{{@root.meta.labels.activity_credit}}</th>
        <th style="width:15%" class="cell-amount">{{@root.meta.labels.balanceAsOf}} {{@root.meta.params.dateTo}}</th>
      </tr>
    </thead>
    {{/ifCond}}
    <tbody>
      {{#each this.dimensionRows}}
      <tr>
        <td></td>
        <td>{{this.dimensionValue}}</td>
        <td class="cell-amount">{{formatCurrency this.opening_balance}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_debit}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_credit}}</td>
        <td class="cell-amount">{{formatCurrency this.closing_balance}}</td>
      </tr>
      {{/each}}
      <tr class="acct-total">
        <td>{{#ifCond @root.meta.params.accountLevel '===' 'S'}}<span class="account-link" onclick="window.parent.postMessage({type:'trial-balance-drilldown',accountId:'{{this.account_id}}',accountValue:'{{this.account_no}}',accountName:'{{this.account_name}}'},'*')">{{this.account_no}}</span>{{else}}{{this.account_no}}{{/ifCond}}</td>
        <td>{{this.account_name}}</td>
        <td class="cell-amount">{{formatCurrency this.opening_balance}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_debit}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_credit}}</td>
        <td class="cell-amount">{{formatCurrency this.closing_balance}}</td>
      </tr>
    </tbody>
  </table>
  {{/each}}
  {{else}}
  <table class="report-table" style="table-layout: fixed;">
    <colgroup>
      <col style="width:10%"><col style="width:30%"><col style="width:15%">
      <col style="width:12%"><col style="width:12%"><col style="width:15%">
    </colgroup>
    <thead>
      <tr>
        <th style="width:10%">{{meta.labels.account_no}}</th>
        <th style="width:30%">{{meta.labels.account_name}}</th>
        <th style="width:15%" class="cell-amount">{{meta.labels.balanceAsOf}} {{meta.params.dateFrom}}</th>
        <th style="width:12%" class="cell-amount">{{meta.labels.activity_debit}}</th>
        <th style="width:12%" class="cell-amount">{{meta.labels.activity_credit}}</th>
        <th style="width:15%" class="cell-amount">{{meta.labels.balanceAsOf}} {{meta.params.dateTo}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{#ifCond @root.meta.params.accountLevel '===' 'S'}}<span class="account-link" onclick="window.parent.postMessage({type:'trial-balance-drilldown',accountId:'{{lookup this 'account_id'}}',accountValue:'{{lookup this 'account_no'}}',accountName:'{{lookup this 'account_name'}}'},'*')">{{lookup this 'account_no'}}</span>{{else}}{{lookup this 'account_no'}}{{/ifCond}}</td>
        <td>{{lookup this 'account_name'}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'opening_balance')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'activity_debit')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'activity_credit')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'closing_balance')}}</td>
      </tr>
      {{/each}}
      <tr class="acct-total">
        <td colspan="2">{{meta.ui.total}}</td>
        <td class="cell-amount">{{formatCurrency (sumField rows 'opening_balance')}}</td>
        <td class="cell-amount">{{formatCurrency (sumField rows 'activity_debit')}}</td>
        <td class="cell-amount">{{formatCurrency (sumField rows 'activity_credit')}}</td>
        <td class="cell-amount">{{formatCurrency (sumField rows 'closing_balance')}}</td>
      </tr>
    </tbody>
  </table>
  {{/ifCond}}

  {{#if meta.isInteractive}}
  <div class="print-only-footer-note">{{meta.ui.printedOn}} {{formatDate meta.generatedAt}}</div>
  {{/if}}
</div></body></html>
