{{!-- Trial Balance report template --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
{{{css}}}
/* Trial Balance is the only report whose header row uses table-layout: fixed
   (needed so its 6 percentage-width columns stay aligned between the header
   row and every .acct-block's own body rows) — a real column width instead
   of the auto-sizing every other report's thead gets. Combined with the
   shared .report-table thead th's `white-space: nowrap`, that means a header
   that doesn't fit its fixed column doesn't grow it, it bleeds text into the
   next one instead: "ACCOUNT NO." into "NAME", and — worse, since it embeds
   a dynamic formatted date — "BALANCE AS OF 2026-08-13" into "DEBIT". Both
   only showed up once Inter (ETP-5013) made bold uppercase header text
   measurably wider than whatever it rendered with before. Overridden here,
   scoped to this report only, so every header wraps onto a second line
   instead of overflowing when it doesn't fit. */
.report-table thead th { white-space: normal; line-height: 1.2; }
/* ETP-5013 follow-up (re-added): the grayscale unification made screen and
   PDF colors match everywhere ELSE, but a drill-down link is a genuine
   exception — it's real-clickable in the interactive preview (isInteractive)
   and dead text in the exported PDF, so the PDF specifically renders it
   black, not blue. */
{{#if meta.isInteractive}}
.account-link { cursor: pointer; color: #2563eb; text-decoration: underline; font-weight: 600; }
.account-link:hover { opacity: 0.75; text-decoration: none; }
{{/if}}
/* Belt-and-suspenders: a browser's own Cmd/Ctrl+P on the live preview
   bypasses meta.isInteractive entirely, so @media print is what actually
   catches it — plus our own jsreport PDF export, uniformly. */
@media print {
  .account-link { color: inherit !important; text-decoration: none !important; cursor: default !important; font-weight: inherit !important; }
}
/* Account blocks (ETP-5013) — one bordered block PER ACCOUNT, its dimension
   breakdown nested inside and the account itself as the block's closing total
   row. Matches Classic's real Trial Balance layout (verified against a real
   Classic PDF export) — replaces the ETP-4898 "dim-group" card, which nested
   accounts inside a dimension instead and made every dimension's "total" net
   to 0 (summing unrelated accounts for one contact has no accounting
   meaning). Only used when "Agrupar por" picks a dimension; the flat
   single-level table below is untouched. */
.acct-block { margin-bottom: 3mm; }
/* .acct-total is ALSO the flat (ungrouped) branch's single grand-total row
   (below) — its own border-top is all that row needs, so the heavy
   between-blocks separator is scoped to .acct-block (grouped mode only),
   never bare .acct-total, or it leaks into the flat view's Total row too. */
.acct-total td { font-weight: 700; background: #f1f5f9; border-top: 1px solid #cbd5e1 !important; }
.acct-block .acct-total td { border-bottom: 2px solid #1a1a2e !important; }
/* The heavy separator only makes sense BETWEEN blocks — after the last
   account, nothing follows it, so it read as a stray line before the footer. */
.acct-block:last-of-type .acct-total td { border-bottom: none !important; }
{{#if meta.chartTotals}}
/* ETP-6084 chart-tree view (the dynamic report's print): one tree row per node, indented by `indent`. */
.tb-tree .tree-row.heading td { font-weight: 700; }
.tb-tree .dim-row td { font-style: italic; color: #475569; }
.tb-tree .period-group { text-align: center; }
.tb-tree .cell-amount { white-space: nowrap; }
.tb-tree .cmp-against { display: block; font-weight: 400; font-size: 0.85em; }
{{/if}}
</style>
</head>
<body><div class="report-container">
  <div class="report-header">
    <div><div class="report-title">{{meta.title}}</div>
</div>
    {{> document-branding}}
  </div>
  {{#if meta.filters.length}}
  <div class="report-filters-grid">
    {{#each meta.filters}}
    <div><span>{{this.label}}: </span><strong>{{this.value}}</strong></div>
    {{/each}}
  </div>
  {{/if}}


{{#if meta.chartTotals}}
  <table class="report-table tb-tree" style="table-layout: auto;">
    <thead>
      <tr>
        <th rowspan="{{#if (periodMode meta.params.compareMode)}}2{{else}}1{{/if}}">{{meta.labels.account_no}}</th>
        <th rowspan="{{#if (periodMode meta.params.compareMode)}}2{{else}}1{{/if}}">{{meta.labels.account_name}}</th>
        <th class="cell-amount" rowspan="{{#if (periodMode meta.params.compareMode)}}2{{else}}1{{/if}}">{{meta.labels.opening_balance}}</th>
        <th class="cell-amount period-group" colspan="{{#if (periodMode meta.params.compareMode)}}{{#if meta.compareMovements}}4{{else}}1{{/if}}{{else}}1{{/if}}">{{meta.labels.activity_debit}}</th>
        <th class="cell-amount period-group" colspan="{{#if (periodMode meta.params.compareMode)}}{{#if meta.compareMovements}}4{{else}}1{{/if}}{{else}}1{{/if}}">{{meta.labels.activity_credit}}</th>
        <th class="cell-amount period-group" colspan="{{#if (periodMode meta.params.compareMode)}}4{{else}}1{{/if}}">{{meta.labels.closing_balance}}</th>
      </tr>
      {{#if (periodMode meta.params.compareMode)}}
      <tr>
        <th class="cell-amount"></th>
        {{#if meta.compareMovements}}<th class="cell-amount">{{meta.labels.periodCompared}}<span class="cmp-against">{{periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</span></th><th class="cell-amount">{{meta.labels.periodVarAmount}}</th><th class="cell-amount">{{meta.labels.periodVarPct}}</th>{{/if}}
        <th class="cell-amount"></th>
        {{#if meta.compareMovements}}<th class="cell-amount">{{meta.labels.periodCompared}}<span class="cmp-against">{{periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</span></th><th class="cell-amount">{{meta.labels.periodVarAmount}}</th><th class="cell-amount">{{meta.labels.periodVarPct}}</th>{{/if}}
        <th class="cell-amount"></th>
        <th class="cell-amount">{{meta.labels.periodCompared}}<span class="cmp-against">{{periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</span></th><th class="cell-amount">{{meta.labels.periodVarAmount}}</th><th class="cell-amount">{{meta.labels.periodVarPct}}</th>
      </tr>
      {{/if}}
    </thead>
    <tbody>
      {{#each rows}}
      {{#with (lookup this.cells 0) as |cell|}}
      <tr class="tree-row{{#if ../isDimension}} dim-row{{else}}{{#ifCond ../elementlevel '!==' 'S'}} heading{{/ifCond}}{{/if}}">
        <td>{{../value}}</td>
        <td style="padding-left: calc(4px + {{../indent}} * 12px);">{{../name}}</td>
        <td class="cell-amount">{{formatCurrency cell.opening.amount}}</td>
        <td class="cell-amount">{{formatCurrency cell.debit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.debit (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}{{/if}}
        <td class="cell-amount">{{formatCurrency cell.credit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.credit (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}{{/if}}
        <td class="cell-amount">{{formatCurrency cell.closing.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#with (lookup cell.closing (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}
      </tr>
      {{/with}}
      {{/each}}
      {{#with (lookup meta.chartTotals 0) as |cell|}}
      <tr class="acct-total">
        <td colspan="2">{{@root.meta.ui.total}}</td>
        <td class="cell-amount">{{formatCurrency cell.opening.amount}}</td>
        <td class="cell-amount">{{formatCurrency cell.debit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.debit (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}{{/if}}
        <td class="cell-amount">{{formatCurrency cell.credit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.credit (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}{{/if}}
        <td class="cell-amount">{{formatCurrency cell.closing.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#with (lookup cell.closing (periodMode @root.meta.params.compareMode)) as |ref|}}<td class="cell-amount">{{formatCurrency ref.amount}}</td><td class="cell-amount">{{formatCurrency ref.variationAmount}}</td><td class="cell-amount">{{#if ref.variationPct}}{{formatCurrency ref.variationPct}} %{{else}}{{#ifCond ref.variationPct '===' 0}}{{formatCurrency ref.variationPct}} %{{/ifCond}}{{/if}}</td>{{/with}}{{/if}}
      </tr>
      {{/with}}
    </tbody>
  </table>
  {{#if meta.chartBalance}}{{#unless meta.chartBalance.balanced}}
  <div class="period-note">{{meta.labels.unbalanced}} {{formatCurrency meta.chartBalance.debitCreditDiff}}</div>
  {{/unless}}{{/if}}
  {{else}}
  {{#ifCond meta.params.groupBy '!==' ''}}
  {{#each meta.tbGroups}}
  <table class="report-table acct-block" style="table-layout: fixed;">
    <colgroup>
      <col style="width:10%"><col style="width:30%"><col style="width:15%">
      <col style="width:12%"><col style="width:12%"><col style="width:15%">
    </colgroup>
    {{#ifCond @index '===' 0}}
    <thead>
      <tr>
        <th style="width:10%">{{@root.meta.labels.account_no}}</th>
        <th style="width:30%">{{@root.meta.labels.account_name}}</th>
        <th style="width:15%" class="cell-amount">{{@root.meta.labels.balanceAsOf}} {{formatDateLocale @root.meta.params.dateFrom @root.meta.locale}}</th>
        <th style="width:12%" class="cell-amount">{{@root.meta.labels.activity_debit}}</th>
        <th style="width:12%" class="cell-amount">{{@root.meta.labels.activity_credit}}</th>
        <th style="width:15%" class="cell-amount">{{@root.meta.labels.balanceAsOf}} {{formatDateLocale @root.meta.params.dateTo @root.meta.locale}}</th>
      </tr>
    </thead>
    {{/ifCond}}
    <tbody>
      {{#each this.dimensionRows}}
      <tr>
        <td></td>
        <td>{{#if this.dimensionId}}<span class="account-link" onclick="window.parent.postMessage({type:'trial-balance-drilldown',accountId:'{{../account_id}}',accountValue:'{{../account_no}}',accountName:'{{../account_name}}',dimensionGroupBy:'{{@root.meta.params.groupBy}}',dimensionId:'{{this.dimensionId}}',dimensionValue:'{{this.dimensionValue}}'},'*')">{{this.dimensionValue}}</span>{{else}}{{this.dimensionValue}}{{/if}}</td>
        <td class="cell-amount">{{formatCurrency this.opening_balance}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_debit}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_credit}}</td>
        <td class="cell-amount">{{formatCurrency this.closing_balance}}</td>
      </tr>
      {{/each}}
      <tr class="acct-total">
        <td>{{#ifCond @root.meta.params.accountLevel '===' 'S'}}<span class="account-link" onclick="window.parent.postMessage({type:'trial-balance-drilldown',accountId:'{{this.account_id}}',accountValue:'{{this.account_no}}',accountName:'{{this.account_name}}'},'*')">{{this.account_no}}</span>{{else}}{{this.account_no}}{{/ifCond}}</td>
        <td>{{this.account_name}}</td>
        <td class="cell-amount">{{formatCurrency this.opening_balance}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_debit}}</td>
        <td class="cell-amount">{{formatCurrency this.activity_credit}}</td>
        <td class="cell-amount">{{formatCurrency this.closing_balance}}</td>
      </tr>
    </tbody>
  </table>
  {{/each}}
  {{else}}
  <table class="report-table" style="table-layout: fixed;">
    <colgroup>
      <col style="width:10%"><col style="width:30%"><col style="width:15%">
      <col style="width:12%"><col style="width:12%"><col style="width:15%">
    </colgroup>
    <thead>
      <tr>
        <th style="width:10%">{{meta.labels.account_no}}</th>
        <th style="width:30%">{{meta.labels.account_name}}</th>
        <th style="width:15%" class="cell-amount">{{meta.labels.balanceAsOf}} {{formatDateLocale meta.params.dateFrom meta.locale}}</th>
        <th style="width:12%" class="cell-amount">{{meta.labels.activity_debit}}</th>
        <th style="width:12%" class="cell-amount">{{meta.labels.activity_credit}}</th>
        <th style="width:15%" class="cell-amount">{{meta.labels.balanceAsOf}} {{formatDateLocale meta.params.dateTo meta.locale}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{#ifCond @root.meta.params.accountLevel '===' 'S'}}<span class="account-link" onclick="window.parent.postMessage({type:'trial-balance-drilldown',accountId:'{{lookup this 'account_id'}}',accountValue:'{{lookup this 'account_no'}}',accountName:'{{lookup this 'account_name'}}'},'*')">{{lookup this 'account_no'}}</span>{{else}}{{lookup this 'account_no'}}{{/ifCond}}</td>
        <td>{{lookup this 'account_name'}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'opening_balance')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'activity_debit')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'activity_credit')}}</td>
        <td class="cell-amount">{{formatCurrency (lookup this 'closing_balance')}}</td>
      </tr>
      {{/each}}
      <tr class="acct-total">
        <td colspan="2">{{meta.ui.total}}</td>
        <td class="cell-amount">{{formatCurrency (sumFieldWhere rows 'is_root' 'opening_balance')}}</td>
        <td class="cell-amount">{{formatCurrency (sumFieldWhere rows 'is_root' 'activity_debit')}}</td>
        <td class="cell-amount">{{formatCurrency (sumFieldWhere rows 'is_root' 'activity_credit')}}</td>
        <td class="cell-amount">{{formatCurrency (sumFieldWhere rows 'is_root' 'closing_balance')}}</td>
      </tr>
    </tbody>
  </table>
  {{/ifCond}}
  {{/if}}

  {{#if meta.isInteractive}}
  <div class="print-only-footer-note">{{meta.ui.printedOn}} {{formatDate meta.generatedAt}}</div>
  {{/if}}
</div></body></html>
