{{!-- Excel-only template (ETP-4898) — same one-row-per-(account[, dimension])
      shape `rows` already has after folding (this report's export is always
      flat, even when template.hbs nests the HTML/PDF view into per-account
      blocks — ETP-5013), just with numeric amount cells instead of
      formatCurrency text, so Excel can sum/pivot the columns.
      Amount cells use data-cell-type="number" with the RAW value (no formatCurrency) —
      html-to-xlsx does `parseFloat(cell.innerText)` for that type, so a formatted
      amount would silently truncate at the thousands separator. Never format here.
      The dimension column (ETP-5013) only appears when "Agrupar por" picked
      one — without it, a grouped export repeats the same account N times with
      no way to tell which row belongs to which contact/product/etc. Ungrouped
      exports are byte-for-byte unchanged from before this column existed. --}}
<!DOCTYPE html>
<html><head><meta charset="UTF-8">
<style>
  table { border-collapse: collapse; font-family: sans-serif; font-size: 10pt; }
  th { font-weight: bold; text-align: left; background: #f1f5f9; }
  th, td { padding: 1px 4px; white-space: nowrap; }
</style>
</head>
<body>
{{#if meta.chartTotals}}
  <table>
    <thead><tr>
      <th>{{meta.labels.account_no}}</th>
      <th>{{meta.labels.account_name}}</th>
      <th>{{meta.labels.level}}</th>
      <th>{{meta.labels.opening_balance}}</th>
      <th>{{meta.labels.activity_debit}}</th>
      {{#if (periodMode meta.params.compareMode)}}{{#if meta.compareMovements}}<th>{{meta.labels.activity_debit}} {{periodComparedHeader meta.labels.periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</th><th>{{meta.labels.activity_debit}} {{meta.labels.periodVarAmount}}</th><th>{{meta.labels.activity_debit}} {{meta.labels.periodVarPct}}</th>{{/if}}{{/if}}
      <th>{{meta.labels.activity_credit}}</th>
      {{#if (periodMode meta.params.compareMode)}}{{#if meta.compareMovements}}<th>{{meta.labels.activity_credit}} {{periodComparedHeader meta.labels.periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</th><th>{{meta.labels.activity_credit}} {{meta.labels.periodVarAmount}}</th><th>{{meta.labels.activity_credit}} {{meta.labels.periodVarPct}}</th>{{/if}}{{/if}}
      <th>{{meta.labels.closing_balance}}</th>
      {{#if (periodMode meta.params.compareMode)}}<th>{{meta.labels.closing_balance}} {{periodComparedHeader meta.labels.periodCompared meta.params.periods 0 (periodMode meta.params.compareMode) meta.params.columns meta.locale}}</th><th>{{meta.labels.closing_balance}} {{meta.labels.periodVarAmount}}</th><th>{{meta.labels.closing_balance}} {{meta.labels.periodVarPct}}</th>{{/if}}
    </tr></thead>
    <tbody>
      {{#each rows}}
      {{#with (lookup this.cells 0) as |cell|}}
      <tr>
        <td>{{../account_value}}</td>
        <td>{{../name}}</td>
        <td>{{../elementlevel}}</td>
        <td data-cell-type="{{numCellType cell.opening.amount}}">{{round2 cell.opening.amount}}</td>
        <td data-cell-type="{{numCellType cell.debit.amount}}">{{round2 cell.debit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.debit (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}{{/if}}
        <td data-cell-type="{{numCellType cell.credit.amount}}">{{round2 cell.credit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.credit (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}{{/if}}
        <td data-cell-type="{{numCellType cell.closing.amount}}">{{round2 cell.closing.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#with (lookup cell.closing (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}
      </tr>
      {{/with}}
      {{/each}}
      {{#with (lookup meta.chartTotals 0) as |cell|}}
      <tr>
        <td></td>
        <td>{{@root.meta.ui.total}}</td>
        <td></td>
        <td data-cell-type="{{numCellType cell.opening.amount}}">{{round2 cell.opening.amount}}</td>
        <td data-cell-type="{{numCellType cell.debit.amount}}">{{round2 cell.debit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.debit (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}{{/if}}
        <td data-cell-type="{{numCellType cell.credit.amount}}">{{round2 cell.credit.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#if @root.meta.compareMovements}}{{#with (lookup cell.credit (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}{{/if}}
        <td data-cell-type="{{numCellType cell.closing.amount}}">{{round2 cell.closing.amount}}</td>{{#if (periodMode @root.meta.params.compareMode)}}{{#with (lookup cell.closing (periodMode @root.meta.params.compareMode))}}<td data-cell-type="{{numCellType amount}}">{{round2 amount}}</td><td data-cell-type="{{numCellType variationAmount}}">{{round2 variationAmount}}</td><td data-cell-type="{{numCellType variationPct}}">{{round2 variationPct}}</td>{{/with}}{{/if}}
      </tr>
      {{/with}}
    </tbody>
  </table>
  {{else}}
  <table>
    <thead><tr>
      <th>{{meta.labels.account_no}}</th>
      <th>{{meta.labels.account_name}}</th>
      {{#if meta.dimensionField}}<th>{{meta.dimensionLabel}}</th>{{/if}}
      <th>{{meta.labels.opening_balance}}</th>
      <th>{{meta.labels.activity_debit}}</th>
      <th>{{meta.labels.activity_credit}}</th>
      <th>{{meta.labels.closing_balance}}</th>
    </tr></thead>
    <tbody>
      {{#each rows}}
      <tr>
        <td>{{lookup this 'account_no'}}</td>
        <td>{{lookup this 'account_name'}}</td>
        {{#if @root.meta.dimensionField}}<td>{{lookup this 'dimensionValue'}}</td>{{/if}}
        <td data-cell-type="number">{{lookup this 'opening_balance'}}</td>
        <td data-cell-type="number">{{lookup this 'activity_debit'}}</td>
        <td data-cell-type="number">{{lookup this 'activity_credit'}}</td>
        <td data-cell-type="number">{{lookup this 'closing_balance'}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{/if}}
</body></html>
