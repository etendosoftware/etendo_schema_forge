          "name": "completed",
          "label": "Paid",
          "description": "Fully paid invoices (payment complete).",
          "where": "e.paymentComplete = true"
        },
        {
          "name": "pending",
          "label": "Unpaid",
          "description": "Unpaid invoices with nothing paid yet (outstanding equals the total).",
          "where": "e.paymentComplete = false and abs(e.outstandingAmount) >= abs(e.grandTotalAmount)"
        },
        {
          "name": "partial",
          "label": "Partially paid",
          "description": "Invoices with a partial payment: some amount paid but a balance remains.",
          "where": "e.paymentComplete = false and abs(e.outstandingAmount) > 0 and abs(e.outstandingAmount) < abs(e.grandTotalAmount)"
        }
      ],
