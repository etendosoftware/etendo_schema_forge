  "rules": {
    "SE_Invoice_BPartner": {
      "entity": "invoice",
      "decision": "Omit",
      "description": "Auto-fill partner address, payment terms, price list from business partner. Classic UI only.",
      "impactIfOmitted": "Users must manually set address, payment terms, and price list after choosing a business partner."
    },
    "SE_Invoice_BPartnerLocation": {
      "entity": "invoice",
      "decision": "Omit",
      "description": "Cascade on partner address change. Classic UI only.",
      "impactIfOmitted": "No cascade on address change."
    },
    "SL_Invoice_DocType": {
      "entity": "invoice",
      "decision": "Omit",
      "description": "Auto-fill payment terms and method from document type. Classic UI only.",
      "impactIfOmitted": "Users must manually set payment terms and method."
    },
    "SE_Invoice_AccountingDate": {
      "entity": "invoice",
      "decision": "Keep",
      "description": "ETP-4531 (redefined 2026-07-17): C_Invoice.DateInvoiced carries AD_Column.AD_Callout_ID = com.etendoerp.sif.general.callouts.SifInvoiceOperationDateCallout, which extends org.openbravo.erpCommon.ad_callouts.SE_Invoice_AccountingDate and calls super.execute() to auto-fill dateAcct from dateInvoiced. com.etendoerp.go's NeoCalloutService executes this same callout server-side, so it fires in the GO SPA too (create-time cascade and interactive per-field callout). accountingDate is now hidden (visibility: system) and unified with the document date — the native cascade is intentionally kept as-is (the com.etendoerp.go-side guard that used to block it, per the earlier independent-editable-field design, was removed) so this is the primary mechanism keeping accountingDate in sync. AbstractInvoiceHeaderHandler#mirrorAccountingDate is a server-side safety net for write paths that don't trigger this callout (e.g. a bare PATCH).",
      "impactIfOmitted": "If this native callout were blocked again, accountingDate would only stay in sync via the mirrorAccountingDate safety net — any gap between the two would desynchronize the hidden accounting date from the visible document date."
    },
    "READONLY_Posted_AccountingDate": {
      "type": "readOnlyLogic",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Accounting date becomes read-only once the invoice is posted (Posted=Y). Mirrors Goods Receipt/Goods Shipment. Uses Posted rather than Processed so the date can still be corrected if a posting attempt failed and the document needs to be re-posted.",
      "impactIfOmitted": "Users could change accounting date on already-posted invoices, desynchronizing the frontend from the accounting facts already generated."
    },
    "SE_Invoice_TaxDate": {
      "type": "callout",
      "entity": "invoice",
      "decision": "Keep",
      "description": "ETP-4531 (redefined 2026-07-17): C_Invoice.DateAcct carries AD_Column.AD_Callout_ID = org.openbravo.erpCommon.ad_callouts.SE_Invoice_TaxDate, reachable whenever accountingDate is written (now hidden/visibility: system, unified with the document date, rather than the earlier independent-editable-field design). It only fires an update when the callout request's formState already carries a non-empty 'taxDate' that differs from the new accountingDate value (info.getStringParameter(\"inptaxdate\")). taxDate is classified visibility:discarded in this window, so the frontend never sends a 'taxDate' key in formState; the callout's isNotEmpty(strTaxDate) guard is always false and it never produces an update. Verified harmless — kept as-is, not implemented client-side.",
      "impactIfOmitted": "None observed: the callout's only effect targets a field this window discards, so there is nothing to omit."
    },
    "SL_Invoice_PriceList": {
      "entity": "invoice",
      "decision": "Omit",
      "description": "Cascade on price list change. Classic UI only.",
      "impactIfOmitted": "No cascade on price list change."
    },
    "SL_Invoice_Product": {
      "entity": "invoiceLine",
      "decision": "Omit",
      "description": "Auto-fill price, UOM, tax from product selection. Classic UI only.",
      "impactIfOmitted": "Users must manually set price, UOM, and tax after selecting a product."
    },
    "SL_Invoice_Amt": {
      "entity": "invoiceLine",
      "decision": "Omit",
      "description": "Recalculate line amount on quantity/price change. Backend handles on save.",
      "impactIfOmitted": "Line amounts calculated by backend on save."
    },
    "SL_Invoice_Conversion": {
      "entity": "invoiceLine",
      "decision": "Omit",
      "description": "UOM conversion calculation. Backend handles on save.",
      "impactIfOmitted": "UOM conversion calculated by backend."
    },
    "OperativeQuantity_To_BaseQuantity": {
      "entity": "invoiceLine",
      "decision": "Omit",
      "description": "Converts operative quantity to base quantity. Backend handles on save.",
      "impactIfOmitted": "Base quantity calculated by backend."
    },
    "VAL_BPartnerLocation_BillTo": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters partner address selector to bill-to locations of the selected business partner.",
      "impactIfOmitted": "Users could select irrelevant addresses."
    },
    "VAL_DocType_APInvoice": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters document type to AP invoices and credit memos (IsSOTrx=N).",
      "impactIfOmitted": "Users could select wrong document types."
    },
    "VAL_User_BPartnerContact": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters user/contact to contacts of the selected business partner.",
      "impactIfOmitted": "Users could select contacts from other business partners."
    },
    "VAL_User_OrgTree": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters company agent to users in the organization hierarchy.",
      "impactIfOmitted": "Users could select agents outside their org tree."
    },
    "VAL_Project_StatusAndBPartner": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters project to open/ordered projects for the selected business partner.",
      "impactIfOmitted": "Users could select closed or unrelated projects."
    },
    "VAL_PriceList_IsSOTrx": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters price list to purchase price lists (IsSOTrx=N).",
      "impactIfOmitted": "Users could select sales price lists for purchase invoices."
    },
    "VAL_PaymentMethod_Account": {
      "type": "validation",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Filters payment method to valid AP payment methods with accounts.",
      "impactIfOmitted": "Users could select payment methods without AP accounts."
    },
    "VAL_Tax_IsSOTrx_Date": {
      "type": "validation",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "Filters tax selector to purchase taxes valid for the invoice date.",
      "impactIfOmitted": "Users could select sales taxes or expired taxes."
    },
    "READONLY_Processed_Header": {
      "type": "readOnlyLogic",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Most header fields become read-only when document is processed (Processed=Y). Covers: documentNo, invoiceDate, businessPartner, partnerAddress, currency, paymentTerms, paymentMethod, priceList. Note: transactionDocument uses readOnlyLogicJs (locks after first save via d=>!!d.id).",
      "impactIfOmitted": "Users could edit fields on confirmed invoices, breaking data integrity."
    },
    "READONLY_Processed_Lines": {
      "type": "readOnlyLogic",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "Line fields become read-only when parent header is processed. Covers: lineNo, product, invoicedQuantity, unitPrice, tax, description.",
      "impactIfOmitted": "Users could edit lines on confirmed invoices."
    },
    "READONLY_ReversedInvoice_Processed": {
      "type": "readOnlyLogic",
      "entity": "reversedInvoices",
      "decision": "Keep",
      "description": "Reversed invoice reference becomes read-only when document is processed.",
      "impactIfOmitted": "Users could modify reversal links on processed invoices."
    },
    "DISPLAY_OperativeQty_WhenApplicable": {
      "type": "displayLogic",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "Operative quantity and UOM shown only when product has UOM management active.",
      "impactIfOmitted": "Operative quantity fields always visible."
    }
  },
  "discardPatterns": [
    "CopyFrom*",
    "EM_*"
  ],
  "version": 2
}
