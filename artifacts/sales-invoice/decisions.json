  "rules": {
    "BP_AutoFill_Address": {
      "type": "callout",
      "entity": "invoice",
      "decision": "Keep",
      "description": "When changing business partner, auto-fill partner address, payment terms, payment method and price list from customer defaults"
    },
    "Line_Recalc_Totals": {
      "type": "eventHandler",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "After saving a line, recalculate header totals (TotalLines, GrandTotal) including taxes"
    },
    "Product_AutoFill_Price": {
      "type": "callout",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "When selecting a product, auto-fill unit price, tax and UOM from the sales price list"
    },
    "Line_Calc_NetAmount": {
      "type": "callout",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "Recalculate line net amount and tax amount when quantity, price or discount changes"
    },
    "ReadOnly_When_Processed": {
      "type": "displayLogic",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Lock all editable fields when invoice status is Completed or Voided"
    },
    "Match_SO_Shipment": {
      "type": "eventHandler",
      "entity": "invoiceLine",
      "decision": "Keep",
      "description": "When a line references a sales order line or shipment line (C_OrderLine_ID, M_InOutLine_ID), validate quantity does not exceed outstanding amount from the linked document"
    },
    "DateAcct_Default": {
      "type": "callout",
      "entity": "invoice",
      "decision": "Keep",
      "description": "ETP-4531 (redefined 2026-07-17): C_Invoice.DateInvoiced carries AD_Column.AD_Callout_ID = com.etendoerp.sif.general.callouts.SifInvoiceOperationDateCallout, which extends org.openbravo.erpCommon.ad_callouts.SE_Invoice_AccountingDate and calls super.execute() to auto-fill dateAcct from dateInvoiced. NeoCalloutService/NeoCalloutEndpoint in com.etendoerp.go execute this same callout server-side (create-time cascade and interactive per-field callout), so it fires in the GO SPA too. accountingDate is now hidden (visibility: system) and unified with the document date — the native cascade is intentionally kept as-is (the com.etendoerp.go-side guard that used to block it, per the earlier independent-editable-field design, was removed) so this is the primary mechanism keeping accountingDate in sync. AbstractInvoiceHeaderHandler#mirrorAccountingDate is a server-side safety net for write paths that don't trigger this callout (e.g. a bare PATCH).",
      "impactIfOmitted": "If this native callout were blocked again, accountingDate would only stay in sync via the mirrorAccountingDate safety net — any gap between the two would desynchronize the hidden accounting date from the visible document date."
    },
    "READONLY_Posted_AccountingDate": {
      "type": "readOnlyLogic",
      "entity": "invoice",
      "decision": "Keep",
      "description": "Accounting date becomes read-only once the invoice is posted (Posted=Y). Mirrors Goods Receipt/Goods Shipment. Uses Posted rather than Processed so the date can still be corrected if a posting attempt failed and the document needs to be re-posted.",
      "impactIfOmitted": "Users could change accounting date on already-posted invoices, desynchronizing the frontend from the accounting facts already generated."
    },
    "SE_Invoice_TaxDate": {
      "type": "callout",
      "entity": "invoice",
      "decision": "Keep",
      "description": "ETP-4531 (redefined 2026-07-17): C_Invoice.DateAcct carries AD_Column.AD_Callout_ID = org.openbravo.erpCommon.ad_callouts.SE_Invoice_TaxDate, reachable whenever accountingDate is written (now hidden/visibility: system, unified with the document date, rather than the earlier independent-editable-field design). It only fires an update when the callout request's formState already carries a non-empty 'taxDate' that differs from the new accountingDate value (info.getStringParameter(\"inptaxdate\")). taxDate IS present in contract.json as a backend-only field (visibility: system — it exists in the backend contract but is never sent to the frontend form), so the frontend never sends a 'taxDate' key in formState; the callout's isNotEmpty(strTaxDate) guard is always false and it never produces an update. Verified harmless — kept as-is, not implemented client-side.",
      "impactIfOmitted": "None observed: the callout's only effect targets a field this window never exposes, so there is nothing to omit."
    },
    "Currency_From_PriceList": {
      "type": "callout",
      "entity": "invoice",
      "decision": "Keep",
      "description": "When price list changes, auto-fill currency from the selected price list"
    }
  },
  "discardPatterns": [
    "EM_*"
  ],
  "version": 2
}
