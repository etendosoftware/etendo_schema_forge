    },
    "dateFilterKey": "invoiceDate",
    "labelOverrides": {
      "es_ES": {
        "OutstandingAmt": "Pendiente de pago",
        "EM_Etgo_Due_Date": "Vencimiento",
        "em_etgo_delivery_status": "Estado de entrega",
        "C_DocTypeTarget_ID": "Tipo de documento",
        "PriceList": "Precio"
      },
      "en_US": {
        "OutstandingAmt": "Pending Payment",
