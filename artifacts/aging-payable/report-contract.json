    { "name": "column1", "label": { "en_US": "Number Of Days Overdue: Group One", "es_ES": "Días Tramo 1" }, "type": "number", "section": "tramos", "default": 30 },
    { "name": "column2", "label": { "en_US": "Number Of Days Overdue: Group Two", "es_ES": "Días Tramo 2" }, "type": "number", "section": "tramos", "default": 60 },
    { "name": "column3", "label": { "en_US": "Number Of Days Overdue: Group Three", "es_ES": "Días Tramo 3" }, "type": "number", "section": "tramos", "default": 90 },
