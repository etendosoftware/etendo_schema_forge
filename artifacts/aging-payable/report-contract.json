    { "name": "glId", "label": { "en_US": "General Ledger", "es_ES": "Libro Mayor" }, "type": "search", "selector": "acctschema", "inputStyle": "popup-single", "required": true, "hidden": true, "autoDefault": true, "section": "alcance" },
    { "name": "currentDate", "label": { "en_US": "As of Date", "es_ES": "Fecha hasta" }, "type": "date", "required": true, "section": "periodo" },
    { "name": "bPartnerId", "label": { "en_US": "Contact", "es_ES": "Contacto" }, "type": "search", "selector": "bpartner", "inputStyle": "popup", "section": "alcance" },
