  ],
  "groups": [],
  "filters": [],
  "sections": [
    { "id": "periodo", "label": { "en_US": "Period", "es_ES": "Periodo" } },
    { "id": "alcance", "label": { "en_US": "Scope", "es_ES": "Alcance" } },
    { "id": "tramos", "label": { "en_US": "Aging Brackets", "es_ES": "Tramos de antigüedad" } }
