{
  "$schema": "decisions-v2",
  "version": 2,
  "window": {
    "category": "settings",
    "name": "Price List",
    "hidePrint": true,
    "hideMoreMenu": true,
    "showDetailFooterTotals": false,
    "summaryFields": [],
    "labelOverrides": {
      "es_ES": {
        "Name": "Nombre",
        "C_Currency_ID": "Moneda",
        "IsSOPriceList": "Tarifa de venta",
        "Costbased": "Basado en coste",
        "IsTaxIncluded": "Precio incluye impuesto",
        "IsDefault": "Por defecto",
        "IsActive": "Activo"
      }
    }
  },
  "entities": {
    "priceList": {
      "javaQualifier": "priceListHeaderHandler",
      "fields": {
        "name": {
          "grid": true,
          "searchable": true,
          "section": "principal",
          "seq": 1,
          "order": 1
        },
        "currency": {
          "visibility": "readOnly",
          "grid": false,
          "form": true,
          "section": "principal",
          "seq": 2
        },
        "description": {
          "grid": false,
          "section": "principal",
          "seq": 3
        },
        "salesPriceList": {
          "grid": true,
          "section": "principal",
          "seq": 4,
          "order": 2,
          "badge": true,
          "labels": { "es_ES": "Tipo", "en_US": "Type" },
          "badgeLabels": {
            "true": { "es_ES": "Venta", "en_US": "Sales" },
            "false": { "es_ES": "Compra", "en_US": "Purchase" }
          },
          "badgeVariants": {
            "true": "blue",
            "false": "purple"
          }
        },
        "costBasedPriceList": {
          "visibility": "discarded"
        },
        "priceIncludesTax": {
          "visibility": "discarded"
        },
        "default": {
          "grid": true,
          "section": "principal",
          "seq": 7,
          "order": 3,
          "badge": true,
          "labels": { "es_ES": "Por defecto", "en_US": "Default" },
          "badgeLabels": {
            "true": { "es_ES": "Sí", "en_US": "Yes" },
            "false": { "es_ES": "No", "en_US": "No" }
          }
        },
        "etgoProductcount": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "section": "principal",
          "seq": 8,
          "order": 4,
          "labels": { "es_ES": "Nº de productos", "en_US": "Product Count" }
        },
        "active": {
          "visibility": "editable",
          "grid": true,
          "form": true,
          "section": "principal",
          "seq": 9,
          "order": 5,
          "badge": true,
          "labels": { "es_ES": "Activo", "en_US": "Active" },
          "badgeLabels": {
            "true": { "es_ES": "Sí", "en_US": "Yes" },
            "false": { "es_ES": "No", "en_US": "No" }
          }
        },
        "enforcePriceLimit": {
          "visibility": "discarded"
        },
        "basePricelist": {
          "visibility": "discarded"
        }
      }
    },
    "priceListVersion": {
      "javaQualifier": "priceListVersionHandler"
    },
    "priceListLine": {
      "fields": {
        "product": {
          "grid": true,
          "section": "principal",
          "seq": 1
        },
        "listPrice": {
          "grid": true,
          "section": "principal",
          "seq": 2
        },
        "standardPrice": {
          "grid": true,
          "section": "principal",
          "seq": 3
        },
        "limitPrice": {
          "grid": true,
          "section": "principal",
          "seq": 4
        },
        "uom": {
          "grid": true,
          "section": "principal",
          "seq": 5
        }
      }
    }
  },
  "rules": {},
  "discardPatterns": ["EM_*"]
}
