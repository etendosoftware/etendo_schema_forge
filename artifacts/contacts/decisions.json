{
  "$schema": "decisions-v2",
  "window": {
    "agentPrompt": "#REF#agent-prompts/contacts/spec.md",
    "category": "contact",
    "name": "Contacts",
    "entityLabel": "Contact",
    "sidebarLayout": false,
    "breadcrumb": "Contact",
    "detailEntity": null,
    "statusField": "none",
    "summaryFields": [],
    "primaryTabs": [
      {
        "key": "general",
        "label": "General"
      },
      {
        "key": "financial",
        "label": "Financial",
        "panel": "ContactsFinancialPanel"
      }
    ],
    "subsetFilters": [
      {
        "label": "all"
      },
      {
        "label": "customers",
        "filter": "criteria=%5B%7B%22fieldName%22%3A%22customer%22%2C%22operator%22%3A%22equals%22%2C%22value%22%3Atrue%7D%5D"
      },
      {
        "label": "vendors",
        "filter": "criteria=%5B%7B%22fieldName%22%3A%22vendor%22%2C%22operator%22%3A%22equals%22%2C%22value%22%3Atrue%7D%5D"
      }
    ],
    "customComponents": {
      "headerTable": "ContactsTable",
      "topbarExtra": "ContactTypeToggle"
    },
    "hidePrint": true,
    "hideMoreMenu": true,
    "linesLayout": "inlineEditable",
    "labelOverrides": {
      "en_US": {
        "Name": "Legal Name",
        "FIN_Financial_Account_ID": "Account",
        "PO_Financial_Account_ID": "Expense Account",
        "EM_Etgo_Web": "Website",
        "EM_Etgo_Firstname": "First Name",
        "EM_Etgo_Lastname": "Last Name",
        "C_BP_Group_ID": "Contact Category"
      },
      "es_ES": {
        "Name": "Razón Social",
        "EM_Etgo_Identifier": "Identificador",
        "FIN_Financial_Account_ID": "Cuenta",
        "PO_Financial_Account_ID": "Cuenta contable de gastos",
        "EM_Etgo_Web": "Página web",
        "EM_Etgo_Firstname": "Nombre",
        "EM_Etgo_Lastname": "Apellidos",
        "C_BP_Group_ID": "Categoría de contacto"
      }
    },
    "processOverrides": {
      "setNewCurrency": {
        "exclude": true
      }
    },
    "listBaseFilter": "criteria=%7B%22operator%22%3A%22or%22%2C%22criteria%22%3A%5B%7B%22fieldName%22%3A%22customer%22%2C%22operator%22%3A%22equals%22%2C%22value%22%3Atrue%7D%2C%7B%22fieldName%22%3A%22vendor%22%2C%22operator%22%3A%22equals%22%2C%22value%22%3Atrue%7D%5D%7D",
    "listViewOptions": {
      "hidePrint": true,
      "hideCounter": true,
      "hideLink": true
    },
    "secondaryTabs": {
      "contact": {
        "tabMode": "table-form",
        "tabOrder": 1,
        "label": "Person",
        "addLineFields": [
          "firstName",
          "lastName",
          "email",
          "phone",
          "position"
        ],
        "requireSavedRecord": true
      },
      "bankAccount": {
        "tabMode": "table-form",
        "tabOrder": 2,
        "label": "Bank Account",
        "addLineFields": [
          "bankName",
          "country",
          "bankFormat",
          "accountNo",
          "iBAN",
          "swiftCode"
        ],
        "requireSavedRecord": true
      },
      "locationAddress": {
        "tabOrder": 3,
        "label": "Location",
        "customAddModal": "LocationEditorModal",
        "requireSavedRecord": true
      },
      "customerAccounting": {
        "tabMode": "table-form",
        "tabOrder": 4,
        "label": "Customer Accounting",
        "addLineFields": [
          "accountingSchema",
          "customerReceivablesNo",
          "customerPrepayment"
        ],
        "requireSavedRecord": true,
        "maxDetailLines": 1
      },
      "vendorAccounting": {
        "tabMode": "table-form",
        "tabOrder": 5,
        "label": "Vendor Accounting",
        "addLineFields": [
          "accountingSchema",
          "vendorLiability",
          "vendorPrepayment"
        ],
        "requireSavedRecord": true,
        "maxDetailLines": 1
      }
    },
    "import": {
      "enabled": true,
      "spec": "contacts",
      "entity": "businessPartner",
      "formats": ["csv", "txt"],
      "limit": { "maxRows": 5000, "concurrency": 4 },
      "dedupe": { "scope": "database", "key": ["taxID"] },
      "descriptor": "contacts",
      "fields": [
        { "target": "name", "aliases": ["nombre comercial", "nombre", "razon social", "razón social"], "label": "Commercial Name", "required": true, "example": "Distribuciones García S.L." },
        { "target": "etgoIsperson", "aliases": ["tipo", "tipo de contacto", "persona o empresa", "tipo cliente"], "label": "Contact Type (Person / Company)", "required": false, "example": "Empresa", "labelKey": "importHeaderType" },
        { "target": "category", "aliases": ["categoria", "categoría", "categoria de contacto", "categoría de contacto", "codigo categoria", "código categoría", "nombre categoria", "nombre categoría"], "label": "Contact Category", "example": "Clientes", "column": "C_BP_Group_ID" },
        { "target": "etgoFirstname", "aliases": ["nombre de pila", "nombre persona"], "label": "First Name", "required": false, "example": "María" },
        { "target": "etgoLastname", "aliases": ["apellido", "apellidos"], "label": "Last Name", "required": false, "example": "García" },
        { "target": "etgoEmail", "aliases": ["email", "correo", "e-mail"], "isEmail": true, "label": "Email", "example": "info@distribucionesgarcia.es" },
        { "target": "etgoPhone", "aliases": ["telefono", "teléfono"], "label": "Phone", "example": "910 000 001" },
        { "target": "etgoWeb", "aliases": ["web", "website", "sitio web", "pagina web", "página web"], "label": "Website", "example": "https://distribucionesgarcia.es" },
        { "target": "oBTIKTaxIDKey", "aliases": ["clave nif pais residencia", "clave nif país residencia", "tipo identificacion fiscal", "tipo identificación fiscal", "tax id type"], "label": "Tax ID Type", "required": false, "example": "NIF" },
        { "target": "taxID", "aliases": ["cif/nif", "cif", "nif", "tax id", "taxid", "identificacion fiscal", "identificación fiscal"], "label": "CIF/NIF", "required": true, "example": "B12345678" },
        { "target": "email", "aliases": ["email de contacto"], "isEmail": true, "label": "Email (Contact)", "example": "compras@distribucionesgarcia.es", "headerScope": "contact" },
        { "target": "firstName", "aliases": ["nombre de contacto"], "label": "First Name (Contact)", "example": "Lucía", "headerScope": "contact" },
        { "target": "lastName", "aliases": ["apellido de contacto"], "label": "Last Name (Contact)", "example": "Fernández", "headerScope": "contact" },
        { "target": "phone", "aliases": ["telefono de contacto"], "label": "Phone (Contact)", "example": "610 000 002", "headerScope": "contact" },
        { "target": "position", "aliases": ["cargo"], "label": "Position", "example": "Responsable de compras", "headerScope": "contact" },
        { "target": "address", "aliases": ["direccion", "dirección"], "label": "Address", "example": "Calle Mayor 12", "labelKey": "importHeaderAddress", "headerScope": "contact" },
        { "target": "city", "aliases": ["ciudad"], "label": "City", "example": "Sevilla", "labelKey": "importHeaderCity", "headerScope": "contact" },
        { "target": "postal", "aliases": ["codigo postal", "código postal", "cp"], "label": "Postal Code", "example": "41001", "labelKey": "importHeaderPostalCode", "headerScope": "contact" },
        { "target": "country", "aliases": ["pais", "país"], "label": "Country", "matchEntity": "Country", "example": "España", "headerScope": "contact", "labelKey": "importHeaderCountry" },
        { "target": "region", "aliases": ["provincia", "region", "región"], "label": "Region", "example": "Sevilla", "labelKey": "importHeaderRegion", "headerScope": "contact" }
      ]
    }
  },
