{
  "$schema": "decisions-v2",
  "window": {
    "category": "inventory",
    "name": "Warehouse",
    "detailEntity": null,
    "secondaryTabs": {
      "productTransactions": {
        "tabOrder": 1,
        "label": "Transactions",
        "customPanel": "WarehouseTransactionsTable"
      },
      "accounting": {
        "tabOrder": 2,
        "label": "Accounting"
      }
    },
    "hidePrint": true,
    "hideLink": true,
    "listbarPaddingX": "px-2",
    "tablePaddingX": "px-2"
  },
  "entities": {
    "header": {
      "name": "warehouse",
      "fields": {
        "searchKey": {
          "searchable": true,
          "grid": true,
          "seq": 1
        },
        "name": {
          "searchable": true,
          "grid": true,
          "seq": 2
        },
        "description": {
          "grid": false,
          "seq": 4,
          "span": 4,
          "rows": 1
        },
        "locationAddress": {
          "grid": true,
          "seq": 3,
          "span": 2,
          "editModal": "location"
        },
        "warehouseRule": {
          "grid": false,
          "visibility": "discarded"
        },
        "storageBinSeparator": {
          "visibility": "discarded"
        },
        "shipmentVehicle": {
          "visibility": "discarded"
        },
        "shipperCode": {
          "visibility": "discarded"
        },
        "fromDocumentNo": {
          "visibility": "discarded"
        },
        "toDocumentNo": {
          "visibility": "discarded"
        },
        "mReturnlocatorID": {
          "visibility": "discarded"
        },
        "allocated": {
          "visibility": "discarded"
        }
      },
      "formCols": 4
    },
    "storageBin": {
      "name": "storageBin"
    },
    "productTransactions": {
      "name": "productTransactions",
      "javaQualifier": "productTransactionsHandler"
    },
    "binContents": {
      "name": "binContents",
      "javaQualifier": "binContentsHandler",
      "fields": {
        "etgoCost": {
          "grid": true,
          "form": false,
          "visibility": "readOnly"
        },
        "etgoValuation": {
          "grid": true,
          "form": false,
          "visibility": "readOnly"
        }
      }
    },
    "accounting": {
      "name": "accounting",
      "hideDelete": true,
      "fields": {
        "accountingSchema": { "visibility": "system", "derivation": "fromConfig" },
        "warehouse": { "visibility": "system", "derivation": "fromParent" },
        "warehouseDifferences": {
          "visibility": "editable",
          "grid": true,
          "form": true,
          "required": true,
          "lookup": true,
          "grow": true,
          "seq": 1
        },
        "warehouseInventory": { "visibility": "discarded" },
        "inventoryRevaluation": { "visibility": "discarded" },
        "inventoryAdjustment": { "visibility": "discarded" },
        "organization": { "visibility": "system" },
        "client": { "visibility": "system" },
        "id": { "visibility": "system" },
        "active": { "visibility": "system" },
        "creationDate": { "visibility": "system" },
        "createdBy": { "visibility": "system" },
        "updated": { "visibility": "system" },
        "updatedBy": { "visibility": "system" }
      }
    }
  },
  "rules": {},
  "discardPatterns": [
    "EM_*"
  ],
  "version": 2
}
