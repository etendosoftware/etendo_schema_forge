{
  "$schema": "decisions-v2",
  "window": {
    "category": "inventory",
    "name": "Product",
    "vectorSearch": {
      "target": "product"
    },
    "breadcrumb": "Inventory / Product",
    "layoutType": "gallery",
    "sidebarLayout": true,
    "hidePrint": true,
    "hideMoreMenu": true,
    "hideLink": true,
    "contentBg": "bg-card",
    "tablePaddingX": "px-2",
    "formCardPadding": "px-2",
    "compactSidebarPadding": true,
    "tabsBarPaddingX": "px-2",
    "toolbarPaddingX": "px-2",
    "toolbarBorderBottom": true,
    "autoSaveOnBlur": true,
    "noHeaderBorder": true,
    "whiteFormBackground": true,
    "sidebarClassName": "w-[320px] shrink-0 overflow-y-auto pt-2 pl-0 pr-4 pb-5 border-l border-border-subtle",
    "attachments": true,
    "detailEntity": null,
    "customPanelTabs": [
      { "key": "pricing", "labelKey": "price", "component": "ProductPriceBar", "tabOrder": 100 }
    ],
    "labelOverrides": {
      "en_US": {
        "M_Product_Category_ID": "Category",
        "ProductType": "Type",
        "DateFrom": "Start Date",
        "DateTo": "Expiry Date"
      },
      "es_ES": {
        "M_Product_Category_ID": "Categoría",
        "ProductType": "Tipo",
        "Value": "Código",
        "IsStocked": "Almacenable",
        "DateFrom": "Fecha de inicio",
        "DateTo": "Fecha de expiración"
      },
      "es_AR": {
        "IsStocked": "Almacenable",
        "DateFrom": "Fecha de inicio",
        "DateTo": "Fecha de expiración"
      }
    },
    "headerExtra": { "customForm": "ProductStockDefaultsWatcher" },
    "customComponents": {
      "subHeader": "ProductCostBanner"
    },
    "secondaryTabs": {
      "costing": {
        "tabOrder": 500,
        "label": "Costing",
        "requireSavedRecord": true,
        "addLineFields": [
          "cost",
          "startingDate",
          "endingDate"
        ]
      },
      "accounting": {
        "tabOrder": 500,
        "label": "Accounting",
        "addLineFields": [
          "fixedAsset",
          "productExpense",
          "productRevenue",
          "productCOGS"
        ],
        "requireSavedRecord": true,
        "maxDetailLines": 1,
        "visibleWhenCapability": "showAccountingFields"
      }
    },
    "import": {
      "enabled": true,
      "spec": "product",
      "entity": "product",
      "descriptor": "product",
      "formats": ["csv", "txt", "xlsx"],
      "limit": { "maxRows": 5000, "concurrency": 4, "batchSize": 10 },
      "dedupe": { "scope": "database", "key": ["searchKey"] },
      "fields": [
        { "target": "searchKey", "aliases": ["codigo", "código", "sku"], "label": "Search Key", "required": true, "example": "SKU-1001" },
        { "target": "name", "aliases": ["nombre"], "label": "Name", "required": true, "example": "Tornillo hexagonal M8", "exampleKey": "importExampleProductName" },
        { "target": "description", "aliases": ["descripcion", "descripción", "description"], "example": "Tornillería inoxidable", "exampleKey": "importExampleProductDescription" },
        { "target": "productType", "aliases": ["tipo", "tipo de producto"], "label": "Product Type", "required": false, "example": "Item", "exampleKey": "importExampleProductType" },
        { "target": "uOM", "aliases": ["unidad de medida", "unidad", "um", "uom"], "label": "Unit of Measure", "matchEntity": "UOM", "matchMode": "strict", "required": false, "example": "Unidad", "exampleKey": "importExampleProductUom" },
        { "target": "salesPrice", "aliases": ["precio de venta", "precio venta", "precio", "pvp"], "label": "Sales Price", "isNumeric": true, "example": "12,50", "exampleKey": "importExampleProductSalesPrice", "labelKey": "importHeaderSalesPrice" },
        { "target": "purchasePrice", "aliases": ["precio de compra", "precio compra"], "label": "Purchase Price", "isNumeric": true, "example": "8,20", "exampleKey": "importExampleProductPurchasePrice", "labelKey": "importHeaderPurchasePrice" },
        { "target": "cost", "aliases": ["costo", "coste", "coste estandar", "coste estándar", "costo estandar", "costo estándar", "standard cost"], "label": "Cost", "required": false, "isNumeric": true, "example": "7,40", "exampleKey": "importExampleProductCost", "labelKey": "importHeaderCost" },
        { "target": "costStartingDate", "aliases": ["fecha de inicio", "fecha inicio", "vigente desde", "fecha de inicio del coste", "starting date"], "label": "Cost Starting Date", "example": "01/01/2026", "exampleKey": "importExampleProductCostStartingDate", "labelKey": "importHeaderCostStartingDate" },
        { "target": "category", "aliases": ["categoria", "categoría", "codigo categoria", "código categoría", "nombre categoria", "nombre categoría"], "label": "Category", "example": "Herramientas", "exampleKey": "importExampleProductCategory", "column": "M_Product_Category_ID" },
        { "target": "taxCategory", "aliases": ["grupo de impuesto", "grupo de impuestos", "categoria de impuesto", "categoría de impuesto", "impuesto", "tax category"], "label": "Tax Category", "matchEntity": "FinancialMgmtTaxCategory", "matchMode": "strict", "required": false, "example": "IVA Normal", "exampleKey": "importExampleProductTaxCategory", "labelKey": "importHeaderTaxCategory" },
        { "target": "stocked", "aliases": ["almacenable", "stocked", "is stocked"], "label": "Stocked", "required": false, "example": "Sí", "exampleKey": "importExampleYes", "labelKey": "importHeaderStocked" },
        { "target": "returnable", "aliases": ["retornable", "returnable"], "label": "Returnable", "required": false, "example": "Sí", "exampleKey": "importExampleYes", "labelKey": "importHeaderReturnable" }
      ]
    }
  },
  "entities": {
    "intrastat": { "exclude": true },
    "product": {
      "javaQualifier": "productDefaultsHandler",
      "formCols": 3,
      "fields": {
        "searchKey": {
          "grid": true,
          "searchable": true,
          "section": "principal",
          "seq": 1,
          "publicApi": { "exposed": true, "name": "searchKey", "required": true }
        },
        "name": {
          "grid": true,
          "searchable": true,
          "section": "principal",
          "seq": 2,
          "multiField": {
            "subtitle": "searchKey",
            "media": { "field": "image", "kind": "neoImage", "fallback": "box" },
            "parts": [
              { "field": "searchKey", "labels": { "en_US": "Identifier", "es_ES": "Identificador" } },
              { "field": "name", "labels": { "en_US": "Name", "es_ES": "Nombre" } }
            ]
          },
          "publicApi": { "exposed": true, "name": "name", "required": true }
        },
        "description": {
          "type": "textarea",
          "section": "principal",
          "seq": 10,
          "span": 3,
          "publicApi": { "exposed": true, "name": "description" }
        },
        "productType": {
          "grid": true,
          "searchable": true,
          "reference": "ProductType",
          "inputMode": "selector",
          "section": "principal",
          "displayLogic": null,
          "seq": 3,
          "enumVariants": {
            "I": "blue",
            "S": "purple",
            "R": "teal",
            "E": "orange"
          }
        },
        "productCategory": {
          "grid": true,
          "searchable": true,
          "reference": "ProductCategory",
          "section": "principal",
          "seq": 4,
          "publicApi": { "exposed": true, "name": "category" }
        },
        "uOM": {
          "grid": true,
          "section": "principal",
          "seq": 5,
          "inputMode": "search"
        },
        "image": {
          "type": "image",
          "inline": false,
          "section": "principal",
          "seq": 11
        },
        "taxCategory": {
          "section": "principal",
          "seq": 6,
          "displayLogic": null
        },
        "brand": {
          "form": false,
          "section": "other"
        },
        "attributeSet": {
          "form": false,
          "section": "other"
        },
        "uPCEAN": {
          "searchable": true,
          "form": false,
          "section": "other",
          "displayLogic": null
        },
        "sale": {
          "grid": false,
          "form": false,
          "section": "other",
          "displayLogic": null
        },
        "purchase": {
          "grid": false,
          "form": false,
          "section": "other",
          "displayLogic": null
        },
        "eTGOSalePrice": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "section": "other",
          "publicApi": { "exposed": true, "name": "salePrice" },
          "agentPrompt": "The product's sale price: its standard price on the default sales tariff (current version first). Net of tax unless the tariff includes tax. A new product is given a 0 price on the default sales and purchase tariffs (see _skipPricesSeed on etendo_create), so 0 means 'not priced yet'."
        },
        "eTGOPurchasePrice": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "section": "other",
          "agentPrompt": "The product's purchase price: its standard price on the default purchase tariff (current version first). A new product is given a 0 price on the default sales and purchase tariffs (see _skipPricesSeed on etendo_create), so 0 means 'not priced yet'."
        },
        "eTGOCost": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "section": "other",
          "agentPrompt": "The product's current unit cost as the costing engine records it (the standard or average cost in force today, from product/costing), in that cost's own currency, for the whole company (not per warehouse). Empty (null) means no cost has been recorded yet; it is not a cost of 0."
        },
        "eTGOStock": {
          "visibility": "readOnly",
          "grid": true,
          "form": false,
          "section": "other",
          "publicApi": { "exposed": true, "name": "stock" },
          "agentPrompt": "Total quantity on hand of the product, summed over every warehouse and storage bin, in the product's unit of measure. It does not subtract reservations nor open sales orders: product/stock gives it per bin with reservedQty and allocatedQuantity."
        },
        "stocked": {
          "section": "principal",
          "seq": 7,
          "readOnlyLogic": null,
          "displayLogic": null,
          "displayLogicJs": "record.productType === 'I'"
        },
        "mProductStatusID": {
          "reference": "ProductStatus",
          "form": false,
          "section": "other"
        },
        "returnable": {
          "section": "principal",
          "seq": 8,
          "displayLogic": null,
          "displayLogicJs": "record.productType === 'I'"
        },
        "active": {
          "visibility": "editable",
          "grid": false,
          "section": "principal",
          "seq": 9,
          "readOnlyLogic": null,
          "displayLogic": null
        },
        "characteristicDescription": {
          "visibility": "discarded"
        },
        "manageVariants": {
          "visibility": "discarded"
        },
        "isGeneric": {
          "visibility": "discarded"
        },
        "genericProduct": {
          "visibility": "discarded"
        },
        "billOfMaterials": {
          "visibility": "discarded"
        },
        "weight": {
          "visibility": "editable",
          "form": false,
          "section": "other"
        },
        "uOMForWeight": {
          "visibility": "editable",
          "form": false,
          "section": "other",
          "reference": "UOM",
          "inputMode": "selector"
        },
        "useAttributeSetValueAs": {
          "visibility": "discarded"
        },
        "attributeSetValue": {
          "visibility": "discarded"
        },
        "production": {
          "visibility": "discarded"
        },
        "processPlan": {
          "visibility": "discarded"
        },
        "overdueReturnDays": {
          "visibility": "discarded"
        },
        "deferredRevenue": {
          "visibility": "discarded"
        },
        "isdeferredexpense": {
          "visibility": "discarded"
        },
        "bookUsingPurchaseOrderPrice": {
          "visibility": "discarded"
        },
        "revenuePlanType": {
          "visibility": "discarded"
        },
        "periodNumber": {
          "visibility": "discarded"
        },
        "defaultPeriod": {
          "visibility": "discarded"
        },
        "expplantype": {
          "visibility": "discarded"
        },
        "periodnumberExp": {
          "visibility": "discarded"
        },
        "defaultPeriodExpense": {
          "visibility": "discarded"
        },
        "createVariants": {
          "visibility": "discarded"
        },
        "updateInvariants": {
          "visibility": "discarded"
        },
        "linkedToProduct": {
          "visibility": "discarded"
        },
        "includedProductCategories": {
          "visibility": "discarded"
        },
        "includedProducts": {
          "visibility": "discarded"
        },
        "ispricerulebased": {
          "visibility": "discarded"
        },
        "quantityRule": {
          "visibility": "discarded"
        },
        "printDescription": {
          "visibility": "discarded"
        },
        "modifyTax": {
          "visibility": "discarded"
        },
        "relateprodcattoservice": {
          "visibility": "discarded"
        },
        "relateprodtoservice": {
          "visibility": "discarded"
        },
        "allowDeferredSell": {
          "visibility": "discarded"
        },
        "deferredSellMaxDays": {
          "visibility": "discarded"
        },
        "relateprodcattaxtoservice": {
          "visibility": "discarded"
        },
        "copyservicemodifytaxconfig": {
          "visibility": "discarded"
        }
      },
      "agentPrompt": "A product's name is not unique: two products can share it. Identify one by its searchKey (code) or id. When several match what the user said, do not pick one: show them (name, searchKey, prices) and ask. If the user cannot tell, suggest — for them to confirm — the one used in that contact's most recent order or invoice (etendo_list on sales-order/header filtered by businessPartner, newest first, then its lines)."
    },
    "price": {
      "javaQualifier": "productPriceHandler",
      "fields": {
        "cost": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "agentPrompt": "Informational cost noted on this tariff row; not the product's cost for valuation, which is eTGOCost (product/costing)."
        },
        "priceListVersion": {
          "visibility": "editable",
          "grid": true,
          "reference": "PriceListVersion"
        },
        "standardPrice": {
          "grid": true,
          "agentPrompt": "The price this tariff version applies: the unit price a new order or invoice line takes for the product (net of tax unless the tariff includes tax). The figure to use as 'the price'."
        },
        "listPrice": {
          "grid": true,
          "agentPrompt": "The catalog (list) price, shown as the line's list price; a line priced below it shows the difference as a discount. Usually equal to standardPrice."
        },
        "priceLimit": {
          "agentPrompt": "The lowest price allowed for the product on this tariff when price limits are enforced. Maintained by the server."
        }
      }
    },
    "billOfMaterials": {
      "fields": {
        "lineNo": {
          "grid": true,
          "displayLogic": null
        },
        "bOMProduct": {
          "grid": true,
          "inputMode": "search",
          "displayLogic": null
        },
        "bOMQuantity": {
          "grid": true,
          "displayLogic": null
        },
        "bomprice": {
          "displayLogic": null
        },
        "description": {
          "displayLogic": null
        }
      }
    },
    "purchasing": {
      "exclude": true
    },
    "characteristics": {
      "name": "productCharacteristic",
      "fields": {
        "sequenceNumber": {
          "grid": true
        },
        "characteristic": {
          "grid": true
        },
        "variant": {
          "grid": true
        },
        "definesPrice": {
          "displayLogic": null
        },
        "definesImage": {
          "displayLogic": null
        },
        "characteristicSubset": {
          "reference": "CharacteristicSubset",
          "inputMode": "selector",
          "displayLogic": null
        }
      }
    },
    "stock": {
      "readOnly": true,
      "javaQualifier": "productStockWarehouseHandler",
      "agentPrompt": "Stock per product, warehouse and storage bin. Lots, serial numbers and expiry dates are not handled in Etendo GO, so a row says nothing about them and no product is lot-tracked here.",
      "fields": {
        "storageBin": {
          "visibility": "readOnly",
          "grid": true,
          "reference": "StorageBin"
        },
        "uOM": {
          "visibility": "readOnly",
          "grid": true
        },
        "quantityOnHand": {
          "visibility": "readOnly",
          "grid": true,
          "agentPrompt": "Physical quantity in this storage bin now. Not the quantity free to sell: it does not subtract reservedQty nor open sales orders. Quantity committed to orders = sales-order/lines with allParents:true and a product filter, orderedQuantity - deliveredQuantity of completed orders."
        },
        "reservedQty": {
          "visibility": "readOnly",
          "grid": true,
          "agentPrompt": "Quantity of this bin held by explicit stock reservations. Open sales orders do NOT reserve stock by themselves, so it is usually 0 even with orders pending delivery."
        },
        "allocatedQuantity": {
          "visibility": "readOnly",
          "grid": true,
          "agentPrompt": "The part of reservedQty already allocated to this exact bin (reserved and tied to this stock), so it is never more than reservedQty."
        },
        "attributeSetValue": {
          "visibility": "readOnly",
          "grid": true,
          "reference": "AttributeSetValue",
          "inputMode": "selector"
        }
      }
    },
    "alternateUom": {
      "fields": {
        "uOM": {
          "grid": true
        },
        "conversionRate": {
          "grid": true,
          "readOnlyLogic": null
        },
        "sales": {
          "grid": true
        },
        "purchase": {
          "grid": true
        },
        "logistics": {
          "grid": true
        },
        "mProductAumID": {
          "name": "id"
        }
      }
    },
    "productPriceRuleVersion": {
      "exclude": true
    },
    "accounting": {
      "javaQualifier": "productAccountingHandler",
      "hideDelete": true,
      "fields": {
        "accountingSchema": { "visibility": "system", "addLineFromSibling": true },
        "fixedAsset": {
          "lookup": true,
          "lookupDrawer": "account",
          "visibility": "editable",
          "grid": true,
          "seq": 1
        },
        "productExpense": {
          "lookup": true,
          "lookupDrawer": "account",
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 2
        },
        "productRevenue": {
          "lookup": true,
          "lookupDrawer": "account",
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 3
        },
        "productCOGS": {
          "lookup": true,
          "lookupDrawer": "account",
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 4
        },
        "pDefExpenseAcct": {
          "visibility": "discarded"
        },
        "productDeferredRevenue": {
          "visibility": "discarded"
        },
        "invoicePriceVariance": {
          "lookup": true,
          "lookupDrawer": "account",
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 5
        },
        "productRevenueReturn": {
          "visibility": "discarded"
        },
        "productCOGSReturn": {
          "visibility": "discarded"
        },
        "purchasePriceVariance": {
          "visibility": "discarded"
        },
        "tradeDiscountReceived": {
          "visibility": "discarded"
        },
        "tradeDiscountGranted": {
          "visibility": "discarded"
        }
      }
    },
    "costingRule": {
      "exclude": true
    },
    "costing": {
      "publicApi": { "readOnly": true },
      "javaQualifier": "productCostingHandler",
      "fields": {
        "costType": {
          "visibility": "system"
        },
        "cost": {
          "visibility": "editable",
          "grid": true,
          "required": true,
          "columnType": "amount",
          "summable": false,
          "currencyField": "cCurrencyID",
          "readOnlyLogic": null,
          "readOnlyLogicJs": "record.manual === false || record.manual === 'N'"
        },
        "startingDate": {
          "visibility": "editable",
          "grid": true,
          "required": true,
          "readOnlyLogic": null,
          "readOnlyLogicJs": "record.manual === false || record.manual === 'N'"
        },
        "endingDate": {
          "visibility": "editable",
          "grid": true,
          "required": false,
          "derivation": "fromConfig",
          "reason": "ETP-5245 - DateTo is NOT NULL in the dictionary but optional for the user: an empty expiry means 'in force indefinitely'. ProductCostingHandler.injectDefaultEndingDate() fills the blank server-side with CostingUtils.getLastDate() (31-12-9999) before the row reaches the CRUD layer, so the column is never written NULL. Declared as a fromConfig server default so the NOT NULL invariant is satisfied by the handler instead of by forcing the field required in the UI.",
          "readOnlyLogic": null,
          "readOnlyLogicJs": "record.manual === false || record.manual === 'N'"
        },
        "quantity": {
          "visibility": "discarded"
        },
        "warehouse": {
          "visibility": "discarded"
        },
        "cCurrencyID": {
          "visibility": "system"
        },
        "originalCost": {
