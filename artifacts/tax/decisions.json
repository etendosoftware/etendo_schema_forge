{
  "$schema": "decisions-v2",
  "version": 2,
  "window": {
    "category": "settings",
    "name": "Tax Rate",
    "detailEntity": "accounting",
    "breadcrumb": "Finance / Tax",
    "hidePrint": true,
    "hideMoreMenu": true,
    "hideCreate": true,
    "hideDelete": true,
    "hideDeleteButton": true,
    "noHeaderBorder": true,
    "maxDetailLines": 1,
    "labelOverrides": {
      "es_ES": {
        "Name": "Nombre",
        "Rate": "Índice",
        "SOPOType": "Tipo venta/compra",
        "ValidFrom": "Válido desde",
        "Description": "Descripción"
      },
      "en_US": {
        "Name": "Name",
        "Rate": "Rate",
        "SOPOType": "Sales/Purchase Type",
        "ValidFrom": "Valid From",
        "Description": "Description"
      }
    },
    "headerExtra": {
      "customForm": "TaxSifField"
    }
  },
  "entities": {
    "taxZone": { "exclude": true },
    "translation": { "exclude": true },
    "accounting": {
      "javaQualifier": "taxAccountingHandler",
      "hideDelete": true,
      "fields": {
        "accountingSchema": {
          "visibility": "system",
          "addLineFromSibling": true
        },
        "taxDue": {
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 1
        },
        "taxCredit": {
          "visibility": "editable",
          "grid": true,
          "grow": true,
          "seq": 2
        },
        "taxExpense": {
          "visibility": "discarded",
          "reason": "Only used for non-recoverable tax scenarios — not in scope for simplified UI"
        },
        "taxLiability": {
          "visibility": "discarded",
          "reason": "Advanced deferred-tax scenario — not in scope for simplified UI"
        },
        "taxReceivables": {
          "visibility": "discarded",
          "reason": "Advanced deferred-tax scenario — not in scope for simplified UI"
        },
        "taxDueTransitory": {
          "visibility": "discarded",
          "reason": "Cash VAT transitory account — advanced accounting scheme, not in scope for simplified UI"
        },
        "taxCreditTransitory": {
          "visibility": "discarded",
          "reason": "Cash VAT transitory account — advanced accounting scheme, not in scope for simplified UI"
        }
      }
    },
    "taxParameter": { "exclude": true },
    "tax": {
      "fields": {
        "name": {
          "visibility": "readOnly",
          "grid": true,
          "searchable": true,
          "section": "principal",
          "seq": 1
        },
        "rate": {
          "visibility": "readOnly",
          "grid": true,
          "section": "principal",
          "seq": 2,
          "cellType": "taxRate"
        },
        "salesPurchaseType": {
          "visibility": "readOnly",
          "name": "applicableTo",
          "grid": true,
          "section": "principal",
          "seq": 3,
          "cellType": "taxScope"
        },
        "validFromDate": {
          "visibility": "readOnly",
          "name": "validFrom",
          "grid": false,
          "form": true,
          "section": "principal",
          "seq": 4
        },
        "docTaxAmount": {
          "visibility": "readOnly",
          "grid": false,
          "form": true,
          "section": "principal",
          "seq": 5
        },
        "baseAmount": {
          "visibility": "readOnly",
          "grid": false,
          "form": true,
          "section": "principal",
          "seq": 6
        },
        "description": { "visibility": "discarded" },
        "taxCategory": { "visibility": "discarded" },
        "summaryLevel": {
          "visibility": "system",
          "reason": "ETP-4888: needed client-side (not shown in UI) so TaxSifModal.jsx can detect a compound/summary tax and resolve down to its rate-component child instead of editing the summary tax's own (always-blank) SIF columns."
        },
        "country": { "visibility": "discarded" },
        "destinationCountry": { "visibility": "discarded" },
        "taxBase": { "visibility": "discarded" },
        "region": { "visibility": "discarded" },
        "destinationRegion": { "visibility": "discarded" },
        "aeatsiiIsprorate": { "visibility": "discarded" },
        "lineNo": { "visibility": "discarded" },
        "oBSPTITaxBookType": { "visibility": "discarded" },
        "parentTaxRate": {
          "visibility": "system",
          "reason": "ETP-4888: needed to list a summary tax's rate-component children via fetchByCriteria(tax, tax, 'parentTaxRate', summaryId) — see TaxSifModal.jsx's compound-tax resolution."
        },
        "oBSPTIReverseCharge": { "visibility": "discarded" },
        "oBSPTIEquivalentCharge": {
          "visibility": "system",
          "reason": "ETP-4888: needed client-side (not shown in UI) to pick the ONE child that carries the régimen key — the non-equivalent-charge rate component, mirroring com.etendoerp.verifactu's ETVFAC_ORDER_VFAC_VALIDATION.xml / InitialValidator.java criterion."
        },
        "businessPartnerTaxCategory": { "visibility": "discarded" },
        "default": { "visibility": "discarded" },
        "cascade": { "visibility": "discarded" },
        "withholdingTax": { "visibility": "discarded" },
        "notTaxable": { "visibility": "readOnly", "form": false },
        "notTaxdeductable": { "visibility": "discarded" },
        "istaxdeductable": { "visibility": "discarded" },
        "obsptiReagyp": { "visibility": "discarded" },
        "oBSPTIIsintracommunity": { "visibility": "discarded" },
        "isCashVAT": { "visibility": "discarded" },
        "obsptiIslease": { "visibility": "discarded" },
        "obsptiIsrealestate": { "visibility": "discarded" },
        "taxExempt": { "visibility": "readOnly", "form": false },
        "obsptiIsrebu": { "visibility": "discarded" },
        "obsptiIsexport": { "visibility": "discarded" },
        "obsptiIsimplicitcharge": { "visibility": "discarded" },
        "obsptiReceiveOss": { "visibility": "discarded" },
        "aeatsiiIsproratexml": { "visibility": "discarded" },
        "aeatsiiCauseExemption": { "visibility": "discarded" },
        "tbaiClaveregimeniva": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='N' & @IsNoTaxable@='N'"
        },
        "tbaiNonsubjectcause": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@IsNoTaxable@='Y' & @isTaxExempt@='N'"
        },
        "tBAICausaDeExencion": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='Y'"
        },
        "etvfacVatRegime": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='N' & @IsNoTaxable@='N'"
        },
        "etvfacIGICRegime": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='N' & @IsNoTaxable@='N'"
        },
        "etvfacIPSIRegime": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='N' & @IsNoTaxable@='N'"
        },
        "etvfacExemptionCause": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@isTaxExempt@='Y'"
        },
        "etvfacCauseNotTaxable": {
          "visibility": "editable",
          "form": false,
          "grid": false,
          "displayLogic": "@IsNoTaxable@='Y' & @isTaxExempt@='N'"
        }
      }
    }
  }
}
