VITE_MOCK=false
VITE_API_BASE=/etendo
JSREPORT_URL=https://reports.staging.etendo.cloud

# CloudWatch RUM — fill in after running go-infraestructure/setup-observability.sh
# CloudWatch RUM — IDs injected via GitHub Actions vars at build time
VITE_RUM_APP_MONITOR_ID_STAGING=
VITE_RUM_IDENTITY_POOL_ID_STAGING=
VITE_RUM_APP_MONITOR_ID_EXPERIMENTAL=
VITE_RUM_IDENTITY_POOL_ID_EXPERIMENTAL=

# Survey engine tunables — internal ops knob for the Etendo GO team, not customer-facing.
# All optional; unset/invalid falls back to the code default. See docs/surveys.md#configuration-vite_survey_.
# VITE_SURVEY_GLOBAL_COOLDOWN_DAYS=30
# VITE_SURVEY_DISMISSED_COOLDOWN_DAYS=21
# VITE_SURVEY_MAX_PER_MONTH=2
# VITE_SURVEY_NPS_MIN_AGE_DAYS=60
# VITE_SURVEY_NPS_INACTIVITY_DAYS=14
# VITE_SURVEY_RESPONSE_COOLDOWN_DAYS=90
# VITE_SURVEY_CSAT_MIN_DOCS=5
# VITE_SURVEY_CSAT_DOC_GAP=30
