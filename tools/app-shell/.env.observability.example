# Copy to an unversioned environment file. Browser tokens are public; API keys are not.
VITE_APP_ENV=development
VITE_APP_VERSION=local
VITE_DATADOG_ENABLED=false
# Feature-flag control plane: datadog | configcat. Empty = Datadog when the RUM
# application ID, client token, site and VITE_APP_ENV are all set, else ConfigCat
# when its key is set, else the code defaults. Datadog Feature Flags reuses the RUM
# credentials below (no extra secret) and VITE_APP_ENV as the flag environment.
VITE_FLAGS_PROVIDER=
# ConfigCat fallback, kept until the Datadog cutover completes.
VITE_CONFIGCAT_SDK_KEY=
VITE_CONFIGCAT_POLL_SECONDS=60
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=datadoghq.eu
VITE_DATADOG_SERVICE=etendo-go-web
VITE_DATADOG_SESSION_SAMPLE_RATE=100
VITE_DATADOG_SESSION_REPLAY_SAMPLE_RATE=20
VITE_DATADOG_REMOTE_CONFIGURATION_ID=
# Deterministic local overrides disable remote evaluation entirely.
VITE_FEATURE_FLAGS=
# Independent optional analytics destination.
VITE_MIXPANEL_ENABLED=false
VITE_MIXPANEL_TOKEN=
VITE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Explicit trusted API base URLs (origin plus Etendo context); only /sws/neo traced.
VITE_DATADOG_TRACE_API_BASES=[]
VITE_DATADOG_TRACE_SAMPLE_RATE=20
