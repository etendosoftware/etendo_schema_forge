      "expected": {
        "lines": [
          {
            "unit6": "0.125000",
            "net": "0.13"
          }
        ],
        "base": "0.13",
        "taxes": [
          {
            "rate": 21,
            "base": "0.13",
            "amount": "0.03"
          }
        ],
        "linesTotal": "0.16"
      }
    },
