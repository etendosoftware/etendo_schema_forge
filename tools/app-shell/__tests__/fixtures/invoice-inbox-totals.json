{
  "_comment": "ETP-6050 S2 — shared by the SPA (invoiceInboxReviewModel.test.js) and the backend (InvoiceInboxTotals JUnit). Formula: unit6 = round6(unitPrice*(1-discount/100)); net = round2(quantity*unit6); tax per rate = round2(sum(net)*rate/100); HALF_UP away from zero. Lines without taxRate add to the base only. Expected values are exact decimal STRINGS (unit6 with 6 decimals, money with 2). Rate rule (both sides): effective rate = the line's taxRate, else tax.rate of its resolved tax block; rounded HALF_UP to 2 decimals BEFORE grouping by rate and computing the tax; no rate at all = base only.",
  "cases": [
    {
      "name": "no discount, one rate",
      "lines": [
        {
          "quantity": 2,
          "unitPrice": 10,
          "taxRate": 21
        }
      ],
      "expected": {
        "lines": [
          {
            "unit6": "10.000000",
            "net": "20.00"
          }
        ],
        "base": "20.00",
        "taxes": [
          {
            "rate": 21,
            "base": "20.00",
            "amount": "4.20"
          }
        ],
        "linesTotal": "24.20"
      }
    },
    {
      "name": "plain 10 percent discount",
      "lines": [
        {
          "quantity": 3,
          "unitPrice": 100,
          "discount": 10,
          "taxRate": 21
        }
      ],
      "expected": {
        "lines": [
          {
            "unit6": "90.000000",
            "net": "270.00"
          }
        ],
        "base": "270.00",
        "taxes": [
          {
            "rate": 21,
            "base": "270.00",
            "amount": "56.70"
          }
        ],
        "linesTotal": "326.70"
      }
    },
    {
      "name": "two rates and a line without rate",
      "lines": [
        {
          "quantity": 1,
          "unitPrice": 33.33,
          "taxRate": 21
        },
        {
          "quantity": 2,
          "unitPrice": 12.5,
          "taxRate": 10
        },
        {
          "quantity": 4,
          "unitPrice": 1.1
        }
      ],
      "expected": {
        "lines": [
          {
            "unit6": "33.330000",
            "net": "33.33"
          },
          {
            "unit6": "12.500000",
            "net": "25.00"
          },
          {
            "unit6": "1.100000",
            "net": "4.40"
          }
        ],
        "base": "62.73",
        "taxes": [
          {
            "rate": 10,
            "base": "25.00",
            "amount": "2.50"
          },
          {
            "rate": 21,
            "base": "33.33",
            "amount": "7.00"
          }
        ],
        "linesTotal": "72.23"
      }
    },
    {
      "name": "half-cent line rounds away from zero",
      "lines": [
        {
          "quantity": 1,
          "unitPrice": 0.125,
          "taxRate": 21
        }
