#!/usr/bin/env bash
# .githooks/pre-push
# Runs full validations (tests, domain boundaries, offline regen) locally before push.
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# Execution stays local unless explicitly enabled. The value may be exported by
# the shell or declared in the unversioned .env file.
PREPUSH_EXECUTION="${PREPUSH_EXECUTION:-}"
if [ -z "$PREPUSH_EXECUTION" ] && [ -f "$REPO_DIR/.env" ]; then
  PREPUSH_EXECUTION="$(awk -F= '
    $1 == "PREPUSH_EXECUTION" {
      value = substr($0, index($0, "=") + 1)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]\r]+$/, "", value)
      gsub(/^['\"']|['\"']$/, "", value)
      print value
      exit
    }
  ' "$REPO_DIR/.env")"
fi

case "$PREPUSH_EXECUTION" in
  ""|local)
    ;;
  cloud)
    # Keep credentials out of the hook environment. Only cloud-runner settings
    # are copied from .env when the caller did not explicitly export them.
    if [ -f "$REPO_DIR/.env" ]; then
      for env_key in \
        PREPUSH_KUBECONFIG PREPUSH_NPMRC PREPUSH_KUBE_CONTEXT \
        PREPUSH_NAMESPACE PREPUSH_DEPLOYMENT PREPUSH_SONAR_ENV_FILE PREPUSH_GO_REPO; do
        if [ -z "${!env_key:-}" ]; then
          env_value="$(awk -F= -v key="$env_key" '
            $1 == key {
              value = substr($0, index($0, "=") + 1)
              sub(/^[[:space:]]+/, "", value)
              sub(/[[:space:]\r]+$/, "", value)
              gsub(/^['\"']|['\"']$/, "", value)
              print value
              exit
            }
          ' "$REPO_DIR/.env")"
          [ -n "$env_value" ] && export "$env_key=$env_value"
        fi
      done
    fi
    exec "$REPO_DIR/scripts/run-remote-prepush.sh" "$@"
    ;;
  *)
    echo "ERROR: PREPUSH_EXECUTION must be 'local' or 'cloud' (found '$PREPUSH_EXECUTION')." >&2
    exit 2
    ;;
esac

echo "==> Running pre-push checks..."

cd "$REPO_DIR"

# The push's ref lines (stdin), read once: the trailer check and the target branch both use them.
# A manual run from a terminal has none.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS="$(cat)"
# shellcheck source=lib/target-branch.sh
. "$SCRIPT_DIR/lib/target-branch.sh"

# ----------------------------------------------------------------------------
# Hooks-Verified: every commit being pushed must carry a valid trailer, proving
# the pre-commit hooks were installed and ran for that exact tree.
# HOOKS_VERIFY_SKIP=1 exists only for maintenance pushes of imported history;
# CI's verify check applies regardless.
# ----------------------------------------------------------------------------
if [ "$HOOKS_VERIFY_SKIP" != "1" ]; then
  . "$SCRIPT_DIR/lib/hooks-proof.sh"
  # stdin: <local ref> <local sha> <remote ref> <remote sha>
  UNVERIFIED=""
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue                                                # no ref lines
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # branch deletion
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      # New branch: only check commits not already reachable from any remote ref.
      RANGE="$(git rev-list "$local_sha" --not --remotes)"
    else
      # Same `--not --remotes` guard as the new-branch case above, and for the
      # same reason. Without it, merging the epic into a task branch pulls every
      # epic commit that is not yet on this branch's remote into the range —
      # including the ones that predate this check — and the push is refused for
      # history the branch neither authored nor can legitimately rewrite.
      RANGE="$(git rev-list "${remote_sha}..${local_sha}" --not --remotes)"
    fi
    for sha in $RANGE; do
      if ! hooks_verify_commit "$sha"; then
        UNVERIFIED="$UNVERIFIED $sha"
      fi
    done
  done <<< "$PUSH_REFS"

  if [ -n "$UNVERIFIED" ]; then
    echo "❌ ERROR: commits without a valid '${HOOKS_TRAILER_KEY}' trailer:"
    for sha in $UNVERIFIED; do
      printf '     %s  %s\n' "$(git rev-parse --short "$sha")" "$(git log -1 --format=%s "$sha")"
    done
    echo ""
    echo "   They were made without the git hooks, or changed after them (an amend with"
    echo "   --no-verify, a rebase that resolved a conflict). CI's verify check refuses"
    echo "   them too."
    # Resolve the exact base so the fix can be copy-pasted instead of derived by
    # hand — reading it off the list above is the step people get wrong.
    REBASE_BASE="$(hooks_rebase_base $UNVERIFIED || true)"
    echo "   Fix: enable the hooks and re-create the commits:"
    echo "     npm install                     # sets core.hooksPath=.githooks"
    if [ -n "$REBASE_BASE" ]; then
      echo "     git rebase --exec 'git commit --amend --no-edit' $REBASE_BASE"
      echo ""
      echo "   That base is the parent of the oldest commit listed above. The rebase"
      echo "   re-stamps every commit after it — content is untouched, but the hashes"
      echo "   change, so only do it while the branch is unpushed or force-pushable."
    else
      echo "     git rebase --exec 'git commit --amend --no-edit' <base>"
      echo "   (<base> = the parent of the oldest commit listed above; it could not be"
      echo "    resolved automatically here.)"
    fi
    exit 1
  fi
  echo "✔ Hooks-Verified trailer present on all pushed commits."
fi

# Require Node 22+ for local validation tooling and coverage workers.
NODE_MAJOR=$(node -e "process.stdout.write(process.versions.node.split('.')[0])" 2>/dev/null || echo "0")
if [ "$NODE_MAJOR" -lt 22 ]; then
  echo "❌ ERROR: pre-push requires Node.js >= 22 (found $(node --version 2>/dev/null || echo '?'))."
  echo "   Switch to Node 22 before pushing (e.g. nvm use 22, volta install node@22, etc.)."
  exit 1
fi

# Local parallelism (ETP-5695). Vitest defaults to one jsdom fork per CPU but one, and the mocked
# Playwright suite to 4 browsers; next to each other they kept 8-thread laptops at 99% CPU for the
# whole push. The pre-push gives vitest half the logical CPUs (TEST_WORKERS, read by
# scripts/test-changed.sh) and the mocked suite at most that many workers. PRE_PUSH_WORKERS sets
# the share; an exported TEST_WORKERS or E2E_WORKERS still wins. Integration keeps its own default.
CPUS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)"
PRE_PUSH_WORKERS="${PRE_PUSH_WORKERS:-$(( CPUS / 2 > 1 ? CPUS / 2 : 1 ))}"
export TEST_WORKERS="${TEST_WORKERS:-$PRE_PUSH_WORKERS}"
MOCKED_E2E_WORKERS="${E2E_WORKERS:-$(( PRE_PUSH_WORKERS < 4 ? PRE_PUSH_WORKERS : 4 ))}"
# Even half the CPUs left a 12-thread ThinkBook at 97% (ETP-5695): the hook and everything it starts
# run at nice 10, so the editor and the browser stay responsive and an idle machine loses no time.
# PRE_PUSH_NICE=0 turns it off.
renice -n "${PRE_PUSH_NICE:-10}" -p $$ >/dev/null 2>&1 || true

# Path where run-sonar.sh writes a copy-pasteable handoff prompt when the
# Quality Gate fails. Cleared up-front so a stale file is never shown.
HANDOFF_FILE="$REPO_DIR/sonar-reports/sonar-handoff-prompt.md"
rm -f "$HANDOFF_FILE"

# Remembers which numbered step (0-4) failed last time, so the next push can
# report it. Written right before every failing exit; cleared when that step
# passes again or on a clean full pass.
LAST_FAILED_FILE="$REPO_DIR/tmp/pre-push/last-failed-step"

# Fail fast: Check for uncommitted or untracked changes
if [ -n "$(git status --porcelain)" ]; then
  echo "❌ ERROR: You have uncommitted or untracked changes in your working tree."
  echo "   Commit or stash them before pushing: the checks below must see what you push."
  echo "   Uncommitted files:"
  git status --porcelain
  exit 1
fi

# Measure everything against the branch this push will merge into (lib/target-branch.sh): the
# conflict check, the relevance diff, Sonar's base ref and the unit-test selection.
TARGET_BRANCH="$(target_branch "$(pushed_branch "$PUSH_REFS")")"
git rev-parse --verify --quiet "origin/$TARGET_BRANCH" >/dev/null \
  || git fetch --quiet origin "$TARGET_BRANCH" 2>/dev/null || true
BASE_REF=""
for branch in "origin/$TARGET_BRANCH" "origin/develop" "origin/main"; do
  if git rev-parse --verify --quiet "$branch" >/dev/null; then
    BASE_REF="$branch"
    break
  fi
done
echo "==> Target branch: ${BASE_REF:-none} (PRE_PUSH_TARGET=<branch> overrides it)"

# ----------------------------------------------------------------------------
# Live progress helpers
# ----------------------------------------------------------------------------
# Detect interactive terminal: only animate when stdout is a TTY (skip in CI).
if [ -t 1 ]; then IS_TTY=1; else IS_TTY=0; fi

SPIN_FRAMES=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

# Per-step duration cache (used as ETA baseline across runs).
DURATIONS_FILE="$REPO_DIR/tmp/pre-push/durations"

# Content-addressed step cache (inert unless PRE_PUSH_CACHE=1 — see the file).
# shellcheck source=lib/step-cache.sh
. "$SCRIPT_DIR/lib/step-cache.sh"
# Relevance rules shared with commit-msg (the Checks: trailer), so the two agree.
# shellcheck source=lib/relevance.sh
. "$SCRIPT_DIR/lib/relevance.sh"
LAST_DURATION=0

# Look up the last recorded duration (seconds) for a step key, or 0.
prev_duration() {
  local key="$1" val=""
  [ -f "$DURATIONS_FILE" ] && val="$(grep "^${key}=" "$DURATIONS_FILE" 2>/dev/null | tail -n1 | cut -d= -f2)"
  [[ "$val" =~ ^[0-9]+$ ]] && echo "$val" || echo 0
}

# Persist the duration (seconds) for a step key.
save_duration() {
  local key="$1" dur="$2"
  mkdir -p "$(dirname "$DURATIONS_FILE")"
  if [ -f "$DURATIONS_FILE" ]; then
    grep -v "^${key}=" "$DURATIONS_FILE" > "$DURATIONS_FILE.tmp" 2>/dev/null || true
    mv "$DURATIONS_FILE.tmp" "$DURATIONS_FILE"
  fi
  echo "${key}=${dur}" >> "$DURATIONS_FILE"
}

# Animate a spinner + ETA + last log line while $1 (pid) is alive.
monitor_progress() {
  local pid="$1" key="$2" log="$3"
  local start=$SECONDS i=0
  local baseline; baseline="$(prev_duration "$key")"
  local cols; cols="$(tput cols 2>/dev/null || echo 80)"

  while kill -0 "$pid" 2>/dev/null; do
    local elapsed=$(( SECONDS - start ))
    local frame="${SPIN_FRAMES[$(( i % ${#SPIN_FRAMES[@]} ))]}"
    i=$(( i + 1 ))

    # Progress / ETA section.
    local prog
    if [ "$baseline" -gt 0 ]; then
      local pct=$(( elapsed * 100 / baseline ))
      [ "$pct" -gt 99 ] && pct=99
      local remaining=$(( baseline - elapsed ))
      [ "$remaining" -lt 0 ] && remaining=0
      local filled=$(( pct / 10 )) bar="" c=0
      while [ "$c" -lt 10 ]; do
        if [ "$c" -lt "$filled" ]; then bar="${bar}█"; else bar="${bar}░"; fi
        c=$(( c + 1 ))
      done
      prog="[${bar}] ${pct}% · ${elapsed}s elapsed · ~${remaining}s left"
    else
      prog="${elapsed}s elapsed (no baseline yet)"
    fi

    # Activity = last non-empty log line (strip ANSI color codes). Some
    # subprocesses (vitest, sonar wrappers) redraw their own progress with `\r`
    # instead of `\n`, so from grep/tail's point of view the "line" they're
    # mid-writing keeps growing as one giant `\r`-joined blob until they finally
    # emit a real newline. Treat `\r` as a line break FIRST so tail only ever
    # sees the most recent redraw, not every historical fragment concatenated
    # together (which is what happens if you merely strip the CRs afterward).
    local activity=""
    if [ -s "$log" ]; then
      # Only the last few KB matter for "the current line" — this log can grow
      # into the megabytes over a multi-minute step, and re-scanning all of it
      # on every 0.2s tick would get slower as the step runs longer.
      activity="$(tail -c 4096 "$log" 2>/dev/null | tr '\r' '\n' | grep -v '^[[:space:]]*$' | tail -n1 | sed $'s/\033\\[[0-9;]*m//g')"
    fi

    local line="   ${frame} ${prog}   ${activity}"
    printf '\r\033[K%s' "${line:0:$(( cols - 1 ))}"
    sleep 0.2
  done
  printf '\r\033[K'
}

# Run a command (string, eval'd) in a dir, streaming live progress.
# Sets LAST_DURATION. Records duration on success. Returns the command's exit status.
exec_with_progress() {
  local key="$1" run_dir="$2" abs_log="$3" cmd="$4"
  mkdir -p "$(dirname "$abs_log")"

  local start=$SECONDS
  set +e
  ( cd "$run_dir" && eval "$cmd" ) > "$abs_log" 2>&1 &
  local pid=$!
  [ "$IS_TTY" = "1" ] && monitor_progress "$pid" "$key" "$abs_log"
  wait "$pid"
  local st=$?
  set -e

  LAST_DURATION=$(( SECONDS - start ))
  [ $st -eq 0 ] && save_duration "$key" "$LAST_DURATION"
  return $st
}

# Every failed check lands here instead of aborting the script — the rest of
# the relevant checks still get their turn, so a push with a new bug AND a
# failing test AND a coverage drop shows all three in one attempt, not one
# per push. Only the final summary (after everything relevant has run) blocks
# the push. STEP_OK lets an immediate caller know whether ITS step just
# passed, when it needs to decide whether follow-on logic still makes sense.
FAILED_STEPS=()

record_failure() {
  local label="$1" existing
  for existing in "${FAILED_STEPS[@]}"; do
    [ "$existing" = "$label" ] && return 0
  done
  FAILED_STEPS+=("$label")
}

# Per-check timing/outcome, printed as one table at the end (see print_summary)
# so a dev can paste real numbers into a task/PR without re-timing anything by
# hand. One row per check regardless of outcome — skipped/cached checks are
# summary-worthy too (they explain why the total is lower than expected).
# $2 duration in seconds, or "-" when not applicable (skipped/instant checks).
SUMMARY_ROWS=()
record_summary_row() {
  SUMMARY_ROWS+=("$1|$2|$3|${4:-}")
}

# Print the failure detail and record it, but keep going. If the step produced
# a ready-to-use handoff prompt (e.g. the Sonar gate), print it IN FULL so the
# developer sees what to fix, then remove it — otherwise a LATER, unrelated
# step's failure in this same run would show this stale handoff instead of
# its own detail.
# $4 (optional): step key to remember as the last failed step (LAST_FAILED_FILE).
report_failure() {
  local step_name="$1" exit_status="$2" abs_log="$3" step_key="${4:-}"
  if [ -n "$step_key" ]; then
    mkdir -p "$(dirname "$LAST_FAILED_FILE")"
    echo "$step_key" > "$LAST_FAILED_FILE"
  fi
  echo ""
  if [ -f "$HANDOFF_FILE" ]; then
    cat "$HANDOFF_FILE"
    rm -f "$HANDOFF_FILE"
  else
    echo "========================================================================="
    echo "❌ ERROR: Step '$step_name' failed with exit code $exit_status."
    echo "👉 Log file: $abs_log"
    echo "========================================================================="
    echo "Showing last 25 lines of log:"
    echo "-------------------------------------------------------------------------"
    tail -n 25 "$abs_log"
    echo "-------------------------------------------------------------------------"
    echo ""
  fi
  record_failure "$step_name"
}

# Pipeline runner helper. Always returns 0 — never trips `set -e` at the call
# site — regardless of whether the step passed. Sets STEP_OK=1/0 so a caller
# that needs to gate follow-on logic on THIS step's own result still can.
run_step() {
  local step_num="$1"
  local step_name="$2"
  local run_dir="$3"
  local log_file="$4"
  local cmd="$5"
  local cache_key="${6:-}"
  local abs_log="$REPO_DIR/$log_file"
  STEP_OK=1

  # A hit means every input this step reads is byte-identical to the last time it
  # passed. Announced loudly and never silently: a quiet skip is how "it passed
  # locally" turns into a lie.
  if step_cache_lookup "$step_num" "$cache_key"; then
    echo "==> [$step_num/5] $step_name... CACHED (inputs unchanged since it last passed)"
    record_summary_row "$step_name" "$(prev_duration "step-${step_num}")" "CACHED" ""
    return 0
  fi

  echo "==> [$step_num/5] $step_name..."

  # Capture the exit status without tripping `set -e`. Calling exec_with_progress
  # bare would abort the whole script on a non-zero return (before we print the
  # failure detail), making a blocked push show nothing useful in the console.
  local exit_status=0
  exec_with_progress "step-${step_num}" "$run_dir" "$abs_log" "$cmd" || exit_status=$?

  if [ $exit_status -eq 0 ]; then
    echo "==> [$step_num/5] $step_name... SUCCESS ✅ (${LAST_DURATION}s)"
    step_cache_store "$step_num" "$cache_key"
    [ "$step_num" = "$LAST_FAILED_STEP" ] && rm -f "$LAST_FAILED_FILE"
    record_summary_row "$step_name" "$LAST_DURATION" "OK" ""
  else
    echo "==> [$step_num/5] $step_name... FAILED ❌ (${LAST_DURATION}s)"
    step_cache_invalidate "$step_num"
    report_failure "$step_name" "$exit_status" "$abs_log" "$step_num"
    STEP_OK=0
    record_summary_row "$step_name" "$LAST_DURATION" "FAILED" ""
  fi
  return 0
}

# 1. Run domain boundary check
run_domain_boundary_check() {
  local log_file="tmp/pre-push/domain-boundary-check.log"
  local abs_log="$REPO_DIR/$log_file"
  echo "==> [1/3] Running domain boundary check..."

  mkdir -p "$(dirname "$abs_log")"

  if [ -z "$BASE_REF" ]; then
    echo "==> [1/3] Running domain boundary check... SKIPPED ⚠️ (No base ref found)"
    return 0
  fi

  # Try running without bypass labels first.
  # Capture status without `set -e` aborting — this call is EXPECTED to fail for
  # cross-domain changes, after which we retry with bypass labels below.
  local status_no_label=0
  exec_with_progress "step-1" "$REPO_DIR" "$abs_log" "make domain-boundary-check BASE=\"$BASE_REF\"" || status_no_label=$?

  if [ $status_no_label -eq 0 ]; then
    echo "==> [1/3] Running domain boundary check... SUCCESS ✅ (Single-domain, ${LAST_DURATION}s)"
    return 0
  fi

  # Try running with bypass labels
  local status_with_labels=0
  exec_with_progress "step-1" "$REPO_DIR" "$abs_log" "make domain-boundary-check BASE=\"$BASE_REF\" LABELS=\"cross-domain-approved,scope:vertical-slice,scope:platform-change,scope:generator-change\"" || status_with_labels=$?

  if [ $status_with_labels -eq 0 ]; then
    echo "==> [1/3] Running domain boundary check... SUCCESS ✅ (Cross-domain, ${LAST_DURATION}s)"
    echo ""
    echo "========================================================================="
    echo "⚠️  WARNING: Cross-domain/mixed-scope changes detected."
    echo "👉 REMINDER: You MUST add one of the following labels to your Pull Request"
    echo "   on GitHub once created, otherwise the remote check will fail:"
    echo "   - 'cross-domain-approved' (if you have a cross-domain plan file)"
    echo "   - 'scope:vertical-slice' (if this is a vertical slice flow)"
    echo "   - 'scope:platform-change' (if this is a platform/app-shell change)"
    echo "   - 'scope:generator-change' (if this is a generator change)"
    echo "========================================================================="
    echo ""
    return 0
  else
    echo "==> [1/3] Running domain boundary check... FAILED ❌ (${LAST_DURATION}s)"
    echo ""
    echo "========================================================================="
    echo "❌ ERROR: Domain boundary check failed. Cross-domain changes detected but no plan/checklist matches."
    echo "👉 Log file: $abs_log"
    echo "========================================================================="
    echo "Showing last 25 lines of log:"
    echo "-------------------------------------------------------------------------"
    tail -n 25 "$abs_log"
    echo "-------------------------------------------------------------------------"
    echo ""
    exit 1
  fi
}

# Check that the sibling com.etendoerp.go checkout (used as REGEN_CHECK_PREV_XML_DIR
# below) has no local commits missing from origin. offline-regen-check.yml resolves
# its own branch there (exact match, else hotfix/*->main, else->develop) and 
# always fetches fresh — it only ever sees what's actually on
# GitHub. If your local checkout is ahead of that (unpushed commits), this check
# passes against YOUR state while CI compares against an older one — exactly the
# kind of local-pass/CI-fail split this whole exercise is trying to close.
#
# Deliberately read-only: we never `git checkout` in etendo_core/modules/com.etendoerp.go
# — that directory is a real local Etendo install, not a disposable clone, and
# switching branches there could yank you off work in progress. If it's already on
# a different branch than CI would resolve, we skip rather than touch it.
check_go_module_push_sync() {
  local go_dir="$REPO_DIR/etendo_core/modules/com.etendoerp.go"
  STEP_OK=1
  [ -d "$go_dir/.git" ] || return 0

  echo "==> Checking com.etendoerp.go is fully pushed (sibling used by the offline regen-check)..."

  local sf_branch expected_branch go_branch
  sf_branch="$(git rev-parse --abbrev-ref HEAD)"

  if ! git -C "$go_dir" fetch --quiet origin 2>/dev/null; then
    echo "    SKIPPED ⚠️ (could not fetch com.etendoerp.go/origin — offline?)"
    return 0
  fi

  if git -C "$go_dir" rev-parse --verify --quiet "origin/$sf_branch" >/dev/null 2>&1; then
    expected_branch="$sf_branch"
  else
    case "$sf_branch" in
      hotfix/*)  expected_branch="main" ;;
      *)         expected_branch="develop" ;;
    esac
  fi

  go_branch="$(git -C "$go_dir" branch --show-current)"

  if [ "$go_branch" != "$expected_branch" ]; then
    echo "    SKIPPED ⚠️ (com.etendoerp.go is on '$go_branch', CI would resolve '$expected_branch' — not touching your checkout)"
    echo "    👉 To let this check run: git -C etendo_core/modules/com.etendoerp.go checkout $expected_branch"
    return 0
  fi

  local local_head origin_head
  local_head="$(git -C "$go_dir" rev-parse HEAD)"
  origin_head="$(git -C "$go_dir" rev-parse "origin/$expected_branch")"

  if [ "$local_head" = "$origin_head" ]; then
    echo "    SUCCESS ✅ (com.etendoerp.go '$expected_branch' matches origin)"
    return 0
  fi

  if git -C "$go_dir" merge-base --is-ancestor "$local_head" "$origin_head" 2>/dev/null; then
    echo "    WARNING ⚠️ (com.etendoerp.go '$expected_branch' is BEHIND origin — CI will see newer commits than what you're testing against)"
    echo "    👉 git -C etendo_core/modules/com.etendoerp.go pull"
    return 0
  fi

  echo "    FAILED ❌ (com.etendoerp.go '$expected_branch' has commits not pushed to origin)"
  echo ""
  echo "========================================================================="
  echo "❌ ERROR: etendo_core/modules/com.etendoerp.go has local commits that are"
  echo "   NOT on origin/$expected_branch. The offline regen-check below would"
  echo "   compare against YOUR local (unpushed) state, but CI's offline-regen-check"
  echo "   workflow always fetches fresh and only sees what's on GitHub — they"
  echo "   would disagree."
  echo "👉 Push com.etendoerp.go first, then re-run this push:"
  echo "     git -C etendo_core/modules/com.etendoerp.go push origin $expected_branch"
  echo "========================================================================="
  record_failure "com.etendoerp.go not fully pushed (blocks step 4 comparison)"
  STEP_OK=0
  return 0
}

# ----------------------------------------------------------------------------
# Playwright E2E tests — mocked must pass before push. Integration specs need the local
# Etendo backend and run for ~12 min, so they are left to CI's full pipeline (ETP-5695);
# PRE_PUSH_INTEGRATION=1 runs them here too when they are relevant.
# ----------------------------------------------------------------------------
# Delegates to scripts/run-e2e-full.sh (ETP-4883): it owns the whole server
# lifecycle itself (builds a dedicated no-PWA bundle, serves it with `vite
# preview` on its own port, tears it down on exit) instead of assuming a
# developer's own `make dev` is already up on :3100 — no more stale-dev-server
# drift between what pre-push validates and what actually ships.
# Mocked and integration run as TWO SEPARATE invocations (not E2E_SUITE=all)
# so a mocked failure never prevents integration from also running and being
# reported — same "collect everything, don't stop at the first problem"
# contract as the rest of this hook.
# Overridable: E2E_PASSWORD, E2E_BACKEND_URL, E2E_WORKERS.
# backend_url defaults to the LOCAL environment's own configured context (read from
# ../config/Openbravo.properties' context.url) rather than a hardcoded /etendo — different
# developer machines legitimately deploy under different context names (e.g. /etendogoclean).
# E2E_BACKEND_URL always wins when set; falls back to the historical /etendo default when the
# properties file is missing or has no context.url (CI, a fresh checkout, etc).
# local-env (isolated worktree environments): the env's Tomcat lives on its own port, recorded as
# `export PORT=NNNN` in <env root>/build/local-env/env, while context.url keeps the copied :8080.
# When that file exists its PORT replaces the port of the URL (host and context path are kept).
# Priority: E2E_BACKEND_URL > local-env PORT > context.url > http://localhost:8080/etendo.
resolve_backend_url() {
  local etendo_root props_file env_file url port
  etendo_root="$(git rev-parse --show-toplevel 2>/dev/null)/.."
  props_file="$etendo_root/config/Openbravo.properties"
  env_file="$etendo_root/build/local-env/env"
  if [ -f "$props_file" ]; then
    url="$(grep -E '^context\.url=' "$props_file" | tail -1 | sed 's/^context\.url=//; s/\\:/:/g')"
  fi
  url="${url:-http://localhost:8080/etendo}"
  if [ -f "$env_file" ]; then
    port="$(grep -E '^export PORT=[0-9]+[[:space:]]*$' "$env_file" | tail -1 | sed -E 's/^export PORT=([0-9]+).*/\1/')"
    if [ -n "$port" ]; then
      url="$(printf '%s' "$url" | sed -E "s#^(https?://[^/:]+)(:[0-9]+)?#\1:$port#")"
    fi
  fi
  echo "$url"
}

run_playwright() {
  local password="${E2E_PASSWORD:-12345}"
  local backend_url="${E2E_BACKEND_URL:-$(resolve_backend_url)}"

  if [ "$RUN_PW_MOCKED" != "1" ] && [ "$RUN_PW_INTEGRATION" != "1" ] && [ "$PW_INTEGRATION_DEFERRED" != "1" ]; then
    echo "==> Playwright E2E... SKIPPED ⏭️  (no UI/spec changes relevant to these tests)"
    record_summary_row "Playwright — mocked" "-" "SKIPPED" ""
    record_summary_row "Playwright — integration" "-" "SKIPPED" ""
    return 0
  fi

  if [ "$RUN_PW_MOCKED" = "1" ]; then
    # ETP-5891: run only the mocked specs the change can affect, picked by
    # scripts/select-mocked-specs.js from the coverage map CI publishes for develop; the PR's mini
    # pipeline and the cut still run every spec. PRE_PUSH_MOCKED_ALL=1, tooling or an unknown file,
    # no base ref or any selector problem run the whole suite: never fewer specs when in doubt.
    local whole_reason plan_file plan_out plan_status total contract_out
    MOCKED_SPECS=""
    # A spec off the shared fixture records no coverage, so the selection could never reach it.
    if contract_out="$(cd "$REPO_DIR" && node --test scripts/__tests__/mocked-specs-coverage-contract.test.js 2>&1)"; then
      echo "==> Mocked specs coverage contract... OK ✅"
    else
      printf '%s\n' "$contract_out" | grep -E '^not ok|^\s+[+-] |^\s+(actual|message):' | sed 's/^/   /'
      echo "==> Mocked specs coverage contract... FAILED ❌ (scripts/__tests__/mocked-specs-coverage-contract.test.js)"
      record_failure "Mocked specs coverage contract (every mocked spec imports e2e/tests/helpers/test.js; extra pages go in e2e/mocked-always-run.json)"
    fi
    whole_reason="$(printf '%s\n' "${CHANGED_FILES:-}" | relevance_mocked_whole)"
    if [ "${PRE_PUSH_MOCKED_ALL:-}" = "1" ]; then
      whole_reason="PRE_PUSH_MOCKED_ALL=1"
    elif [ -z "$whole_reason" ] && [ -z "$BASE_REF" ]; then
      whole_reason="no base ref to compare with"
    fi
    if [ -n "$whole_reason" ]; then
      echo "==> Mocked spec selection: the whole suite ($whole_reason)"
      run_e2e_suite mocked "mocked specs" "$password" "$backend_url"
    else
      plan_file="$(mktemp)"
      set +e
      plan_out="$(cd "$REPO_DIR" && node scripts/select-mocked-specs.js --base "$BASE_REF" --out "$plan_file" 2>&1)"
      plan_status=$?
      set -e
      echo "==> Mocked spec selection:"
      printf '%s\n' "$plan_out" | sed 's/^/   /'
      if [ "$plan_status" -ne 0 ] || [ "$(head -n 1 "$plan_file")" = "*" ]; then
        if [ "$plan_status" -ne 0 ]; then
          echo "   (the selector exited $plan_status: running the whole suite)"
        fi
        run_e2e_suite mocked "mocked specs" "$password" "$backend_url"
      elif [ ! -s "$plan_file" ]; then
        echo "==> Playwright E2E — mocked specs... SKIPPED ⏭️  (no mocked spec reaches the change)"
        record_summary_row "Playwright — mocked" "-" "SKIPPED" "no mocked spec reaches the change"
      else
        MOCKED_SPECS="$(tr '\n' ' ' < "$plan_file")"
        MOCKED_SPECS="${MOCKED_SPECS% }"
        total="$(cd "$REPO_DIR" && git ls-files 'e2e/*.mocked.spec.js' | wc -l | tr -d ' ')"
        run_e2e_suite mocked "mocked specs, $(wc -l < "$plan_file" | tr -d ' ') of $total the change can affect" "$password" "$backend_url"
      fi
      rm -f "$plan_file"
    fi
  else
    echo "==> Playwright E2E — mocked specs... SKIPPED ⏭️  (no mocked-spec / UI changes)"
    record_summary_row "Playwright — mocked" "-" "SKIPPED" ""
  fi

  if [ "$RUN_PW_INTEGRATION" = "1" ]; then
    run_e2e_suite integration "integration specs" "$password" "$backend_url"
  elif [ "$PW_INTEGRATION_DEFERRED" = "1" ]; then
    echo "==> Playwright E2E — integration specs... SKIPPED ⏭️  (left to CI's full pipeline; PRE_PUSH_INTEGRATION=1 runs them here)"
    record_summary_row "Playwright — integration" "-" "SKIPPED" "left to CI (PRE_PUSH_INTEGRATION=1 runs it here)"
  else
    echo "==> Playwright E2E — integration specs... SKIPPED ⏭️  (no integration-spec / UI changes)"
    record_summary_row "Playwright — integration" "-" "SKIPPED" ""
  fi

  return 0
}

# Extracts Playwright's own end-of-run counters ("498 passed", "1 flaky", ...)
# from a captured log — these lines are always left-anchored with just a
# number (test NAMES in the same failed/flaky block start with "[project]"
# instead), so the pattern can't accidentally match those.
playwright_test_counts() {
  local log="$1" pw_status n result=""
  for pw_status in passed failed flaky skipped interrupted; do
    # No hard end-anchor: the "passed" line carries a trailing "(3.9m)"
    # duration that the others don't, so this tolerates trailing text —
    # `\>` isn't POSIX-portable, hence the explicit space-or-EOL alternation.
    n="$(grep -oE "^[[:space:]]*[0-9]+ ${pw_status}([[:space:]]|\$)" "$log" 2>/dev/null | tail -1 | grep -oE '[0-9]+')"
    if [ -n "$n" ]; then
      [ -n "$result" ] && result="${result}, "
      result="${result}${n} ${pw_status}"
    fi
  done
  [ -z "$result" ] && result="no test-count line found in log"
  echo "$result"
}

# Lists the actual test titles under a "N failed"/"N flaky" block (indented
# lines starting with "[project] › ..." right after that count line) — the
# count alone says something broke, this says exactly what to go look at.
playwright_named_tests() {
  local log="$1" pw_status="$2"
  awk -v st="$pw_status" '
    $0 ~ "^[[:space:]]*[0-9]+ " st "([[:space:]]|$)" { grab=1; next }
    grab && /^[[:space:]]*\[/ { line=$0; sub(/^[[:space:]]+/, "", line); print "      - " line; next }
    grab { grab=0 }
  ' "$log" 2>/dev/null
}

# Runs one E2E_SUITE value through run-e2e-full.sh, streaming output live
# (via `tee`, not just captured — a multi-minute suite with silent output
# looks hung) while also keeping a copy to classify the failure reason below.
# $1 suite (mocked|integration)  $2 label for echo/record_failure  $3 password
# $4 backend url (also passed as ETENDO_URL — the built bundle's proxy target
# must point at the same instance the reachability check just verified).
run_e2e_suite() {
  local suite="$1" label="$2" password="$3" backend_url="$4" st start dur counts
  local log="$REPO_DIR/tmp/pre-push/e2e-${suite}.log"
  mkdir -p "$REPO_DIR/tmp/pre-push"

  # Mirror CI exactly. run-e2e-full.sh exports CI=true and playwright.config.js
  # resolves `retries: process.env.CI ? 1 : 0`, so the pipeline grants BOTH suites
  # one retry. This gate used to give mocked 0 on the theory that a mocked flake is
  # always a real bug. In practice that made the gate stricter than the pipeline: a
  # flake CI absorbs blocked the push instead, and the only way through was exporting
  # E2E_RETRIES=1 by hand on every attempt. A gate that rejects what CI would accept
  # is a false negative, so both suites now get the same single retry CI gives them.
  # Flakes still surface: the summary reports them per suite by name.
  # E2E_RETRIES, if already exported by the caller, always wins.
  local retries="${E2E_RETRIES:-1}"

  echo "==> Playwright E2E — ${label}..."
  start=$SECONDS
  set +e
  # Only the mocked suite gets the local worker cap: integration specs share one admin and one
  # tenant, so more workers there mean data races (see playwright.config.js).
  local workers_env="" specs=""
  [ "$suite" = "mocked" ] && { workers_env="E2E_WORKERS=$MOCKED_E2E_WORKERS"; specs="${MOCKED_SPECS:-}"; }
  # shellcheck disable=SC2086 # workers_env is empty or a single NAME=value word
  ( cd "$REPO_DIR" && env $workers_env E2E_MOCKED_SPECS="$specs" E2E_SUITE="$suite" E2E_PASSWORD="$password" \
      E2E_BACKEND_URL="$backend_url" ETENDO_URL="$backend_url" \
      E2E_RETRIES="${retries:-0}" \
      ./scripts/run-e2e-full.sh ) 2>&1 | tee "$log"
  st=${PIPESTATUS[0]}
  set -e
  dur=$(( SECONDS - start ))
  counts="$(playwright_test_counts "$log")"

  local flaky_names failed_names
  flaky_names="$(playwright_named_tests "$log" flaky)"
  if [ -n "$flaky_names" ]; then
    echo "   ⚠️  Flaky (failed once, passed on retry):"
    echo "$flaky_names"
  fi

  if [ "$st" -ne 0 ]; then
    local reason="Playwright E2E — ${label}"
    if grep -q "backend is not reachable" "$log"; then
      reason="${reason} (backend not reachable)"
    elif grep -q "Build failed" "$log"; then
      reason="${reason} (E2E build failed)"
    elif grep -q "Preview server did not come up" "$log"; then
      reason="${reason} (preview server didn't start)"
    fi
    failed_names="$(playwright_named_tests "$log" failed)"
    [ -n "$failed_names" ] && { echo "   ❌ Failed:"; echo "$failed_names"; }
    echo "==> Playwright E2E — ${label}... FAILED ❌ (exit $st)"
    record_failure "$reason"
    record_summary_row "Playwright — ${label%% specs}" "$dur" "FAILED" "$counts"
  else
    record_summary_row "Playwright — ${label%% specs}" "$dur" "OK" "$counts"
  fi
}

# 0. Fail fast when the branch no longer merges cleanly into its target (lib/target-branch.sh).
check_target_conflicts "$TARGET_BRANCH"

# ----------------------------------------------------------------------------
# Relevance detection — run only the checks a change actually requires.
# Same contract as com.etendoerp.go's hook:
#   • GOLDEN RULE: when in doubt, RUN. No base ref / diff fails / a file matches
#     no known bucket → everything runs.
#   • The change set is INCREMENTAL: the three-dot diff ("$BASE_REF"...HEAD)
#     compares from the merge-base (where the branch left the base) to HEAD, so
#     the WHOLE branch delta is considered, not just the tip commit.
#   • A skipped step is REPORTED but never blocks; the already Hooks-Verified
#     commits stay valid.
#
# Classification lives in lib/relevance.sh (relevance_checks), SHARED with
# commit-msg so the per-push `Checks:` trailer and this step selection use the exact
# same rules. Playwright is split by suite: a mocked-only change never forces the
# (backend-dependent) integration suite, and vice versa; a UI (app-shell/src) change
# runs both. Generated code lives under artifacts/<window>/generated/, so
# app-shell/src is hand-written source and does NOT trigger the regen/drift checks.
# ----------------------------------------------------------------------------
RUN_S0=0; RUN_S1=0; RUN_S2=0; RUN_S3=0; RUN_S4=0
RUN_PW_MOCKED=0; RUN_PW_INTEGRATION=0
if [ -n "$BASE_REF" ] && CHANGED_FILES="$(git diff --name-only "$BASE_REF"...HEAD 2>/dev/null)"; then
  CHECKS="$(printf '%s\n' "$CHANGED_FILES" | relevance_checks)"
  case " $CHECKS " in *" npm "*)            RUN_S0=1 ;; esac
  case " $CHECKS " in *" testid "*)         RUN_S1=1 ;; esac
  case " $CHECKS " in *" tests "*)          RUN_S2=1 ;; esac
  case " $CHECKS " in *" regen "*)          RUN_S3=1 ;; esac
  case " $CHECKS " in *" xml "*)            RUN_S4=1 ;; esac
  case " $CHECKS " in *" pw-mocked "*)      RUN_PW_MOCKED=1 ;; esac
  case " $CHECKS " in *" pw-integration "*) RUN_PW_INTEGRATION=1 ;; esac
  n_files="$(printf '%s\n' "$CHANGED_FILES" | grep -Evc '^[[:space:]]*$' || true)"
  b() { [ "$1" = "1" ] && printf run || printf skip; }
  echo "==> Relevance: ${n_files} changed file(s) vs ${BASE_REF}:"
  echo "      [0 npm]=$(b $RUN_S0)  [1 testid]=$(b $RUN_S1)  [2 tests+sonar]=$(b $RUN_S2)  [3 regen]=$(b $RUN_S3)  [4 xml]=$(b $RUN_S4)"
  echo "      playwright: mocked=$(b $RUN_PW_MOCKED)  integration=$(b $RUN_PW_INTEGRATION)"
else
  RUN_S0=1; RUN_S1=1; RUN_S2=1; RUN_S3=1; RUN_S4=1; RUN_PW_MOCKED=1; RUN_PW_INTEGRATION=1
  echo "==> Relevance: no reliable change set (base='${BASE_REF:-none}') → running ALL checks."
fi

# Relevant integration specs are left to CI unless PRE_PUSH_INTEGRATION=1 (see run_playwright).
PW_INTEGRATION_DEFERRED=0
if [ "$RUN_PW_INTEGRATION" = "1" ] && [ "${PRE_PUSH_INTEGRATION:-0}" != "1" ]; then
  RUN_PW_INTEGRATION=0
  PW_INTEGRATION_DEFERRED=1
fi

# 0. Sync node_modules with package-lock.json (CI parity)
#
# CI's "Install dependencies" step runs `npm ci || npm install` against the
# committed package-lock.json before anything else runs. Every later step here
# (data-testid check, Sonar/tests, and especially `make regen-check`, which
# resolves `sf-*` bins via `npx` from node_modules) must see the SAME package
# versions CI would install — not whatever happens to already be on disk from
# an earlier `npm install` of a newer core-package build. Without this, a
# locally-ahead node_modules can make `make regen-check` pass here using a
# newer @etendosoftware/schema-forge-cli than what package.json/lockfile
# actually pin, while CI's `npm ci` installs the older pinned version and
# fails (see ETP-4584: Offline Regen Check drift on `warehouse.editModal`
# caused entirely by a stale core-package pin that only `npm ci` — not a
# stale local install — would have caught).
run_step_0() {
  # Second trigger, independent of the diff: the lockfile can be unchanged vs the
  # target while the INSTALLED tree is older than it (e.g. develop merged in, its
  # lockfile bumped a core package, node_modules never reinstalled -> E2E build
  # and vitest fail on stale packages). Pure JSON compare, fast when in sync.
  local stale_reason=""
  if [ "$RUN_S0" != "1" ] && stale_reason="$(node "$REPO_DIR/scripts/check-node-modules-fresh.js" "$REPO_DIR")"; then
    stale_reason=""
  elif [ "$RUN_S0" != "1" ]; then
    echo "==> node_modules is stale vs package-lock.json (${stale_reason:-unknown}) -> running npm ci"
    RUN_S0=1
  fi
  if [ "$RUN_S0" != "1" ]; then
    echo "==> [0/5] Syncing npm dependencies (npm ci)... SKIPPED ⏭️  (lockfile unchanged)"
    record_summary_row "Syncing npm dependencies with package-lock.json (npm ci)" "-" "SKIPPED" ""
    return 0
  fi
  # npm ci is a pure function of the lockfile and the node major it installs for.
  local key
  key="$(step_cache_compute "node-${NODE_MAJOR}" package.json package-lock.json)"
  # A stale install must reinstall even if this lockfile already passed once.
  [ -n "$stale_reason" ] && key=""
  run_step "0" "Syncing npm dependencies with package-lock.json (npm ci)" "$REPO_DIR" "tmp/pre-push/npm-ci.log" "npm ci || npm install" "$key"
}

# 1. Run data-testid check (fast, runs before expensive checks)
run_step_1() {
  if [ "$RUN_S1" != "1" ]; then
    echo "==> [1/5] Running data-testid check... SKIPPED ⏭️  (no app-shell/src changes)"
    record_summary_row "Running data-testid check" "-" "SKIPPED" ""
    return 0
  fi
  # The checker only ever reads the app-shell sources it scans, plus its own script.
  local key
  key="$(step_cache_compute "node-${NODE_MAJOR}" tools/app-shell/src scripts/check-add-data-testid.sh)"
  run_step "1" "Running data-testid check" "$REPO_DIR" "tmp/pre-push/data-testid-check.log" "npm run check:data-testid" "$key"
}

# Test hygiene (reuse-first protocol, docs/testing/test-reuse-policy.md): the same
# scripts/check-test-hygiene.js the PR's `test-hygiene (reuse-first protocol)` job runs, over
# the same change set (BASE_REF...HEAD). It takes well under a second and only looks at the
# changed test files itself, so it is not relevance-gated and never cached. The mode comes from
# TEST_HYGIENE_MODE in .github/workflows/ratchet-guards.yml, so the hook and CI share ONE switch:
# `annotate` prints the findings and never blocks; `block` blocks the push exactly when CI would.
run_test_hygiene() {
  local name="Running test-hygiene check (reuse-first protocol)"
  if [ -z "$BASE_REF" ]; then
    echo "==> $name... SKIPPED ⚠️  (no target branch to diff against)"
    record_summary_row "$name" "-" "SKIPPED" ""
    return 0
  fi
  local mode out findings status=0 start=$SECONDS duration
  mode="$(sed -n -E 's/^[[:space:]]*TEST_HYGIENE_MODE:[[:space:]]*([a-z]+).*/\1/p' \
    "$REPO_DIR/.github/workflows/ratchet-guards.yml" 2>/dev/null | head -n 1)"
  [ -n "$mode" ] || mode=annotate
  out="$(cd "$REPO_DIR" && node scripts/check-test-hygiene.js --base "$BASE_REF" --head HEAD --mode "$mode" 2>&1)" || status=$?
  duration=$(( SECONDS - start ))
  findings="$(printf '%s\n' "$out" | grep -cE '^::(warning|error)' || true)"
  if [ "$status" -ne 0 ]; then
    echo "==> $name... FAILED ❌ (${duration}s, mode: $mode)"
  elif [ "$findings" -gt 0 ]; then
    echo "==> $name... ${findings} WARNING(S) ⚠️  (${duration}s, mode: $mode — not blocking)"
  else
    echo "==> $name... SUCCESS ✅ (${duration}s)"
  fi
  # GitHub annotation lines (`::warning file=F,line=N,title=T::msg`) shown as `F:N [T] msg`.
  if [ "$findings" -gt 0 ] || [ "$status" -ne 0 ]; then
    printf '%s\n' "$out" \
      | sed -E 's/^::(warning|error) file=([^,]*),line=([0-9]+),title=([^:]*)::/   \2:\3 [\4] /; s/^::(warning|error) title=([^:]*)::/   [\2] /'
  fi
  if [ "$status" -ne 0 ]; then
    record_failure "$name"
    record_summary_row "$name" "$duration" "FAILED" "${findings} finding(s)"
  else
    record_summary_row "$name" "$duration" "OK" "${findings} warning(s), mode: ${mode}"
  fi
  return 0
}

# Domain boundary check disabled: repos are now split at the repo level
# (schema_forge_core vs etendo_schema_forge), so the monorepo cross-domain
