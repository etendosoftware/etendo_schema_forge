#!/usr/bin/env bash
# .githooks/pre-commit
# Validates pipeline completeness for any staged artifact or pipeline files.
# Skipped automatically when no relevant files are staged (fast path).
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
export SF_ROOT="$REPO_DIR"

# Merge commits only reconcile trees that were already validated on their
# source branches. Avoid re-validating every incoming artifact as if it were a
# new task change; hooks-proof already excludes multi-parent commits.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

# Fast-path: only run when staged files touch artifacts or pipeline code.
# (The generator/resolver/validator code itself now lives in the separate
# schema_forge_core repo — this hook can't watch changes to code it no
# longer contains, so that alternation was dropped.)
if ! git diff --cached --name-only | grep -qE '^(artifacts/|tools/app-shell/src/windows/registry\.js)'; then
  # Nothing to validate, but the hook DID run — record the proof so commit-msg
  # still stamps the trailer (that is what proves the hooks are installed).
  . "$SCRIPT_DIR/lib/hooks-proof.sh"
  hooks_write_proof
  exit 0
fi

# Mirrors the Makefile's SF variable: LOCAL_CORE=1 runs the pipeline validator
# from the sibling schema_forge_core source instead of the published
# @etendosoftware/schema-forge-cli package. Without this, a developer working
# against a LOCAL_CORE-only generator fix (not yet published) gets blocked
# committing correct output because the published validator doesn't know
# about the fix yet.
if [ "$LOCAL_CORE" = "1" ]; then
  SF_BIN="$REPO_DIR/cli/sf-local"
else
  SF_BIN="npx"
fi

cd "$REPO_DIR" && "$SF_BIN" sf-validate-pipeline --staged
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "Tip: 'git commit --no-verify' to bypass (not recommended)."
fi

# Record that these checks passed for the tree about to be committed, so
# commit-msg can stamp the Hooks-Verified trailer. See lib/hooks-proof.sh.
if [ $EXIT_CODE -eq 0 ]; then
  . "$SCRIPT_DIR/lib/hooks-proof.sh"
  hooks_write_proof
fi

exit $EXIT_CODE
