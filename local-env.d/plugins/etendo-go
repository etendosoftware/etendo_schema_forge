#!/usr/bin/env bash
# local-env plugin: Etendo GO for an Etendo checkout that contains this schema_forge.
#
# local-env (repo etendo-localenv) knows Etendo Classic only; it runs every
# executable under <repo>/local-env.d/plugins as `<plugin> <hook>` with the
# environment in LOCALENV_* variables (contract: etendo-localenv docs/design.md
# §6.7). This one gives each local-env environment its own Etendo GO SPA:
#   manifest         `seed GOClient v2` (part of the DB fingerprint)
#   db-seed          the gradle invocations that load the GO sample client
#   worktree-create  reserves SPA_PORT / BFF_PORT for the new environment, allows that SPA
#                    origin, points the MCP / OAuth public URLs at it, the app-shell's
#                    .env.local ETENDO_URL and context.url at its Tomcat
#   up               `make dev-local-core` in the background, pointed at its Tomcat; the
#                    `feature-flag` lines of worktree.conf for the SPA and, the boolean ones,
#                    for the backend (ETGO_FLAG_*); Copilot when worktree.conf says `setting copilot=on`
#   status           SPA URL, running or stopped; Copilot's when it is on
#   stop|off|worktree-rm  stops that environment's SPA + BFF, and its Copilot
# manifest and db-seed print nothing without modules/com.etendoerp.go.
# Env: ETENDO_GO_SPA=0 skips starting the SPA (same as `local-env up --skip-plugin=etendo-go`).
# Docs: docs/local-env-plugin.md
set -euo pipefail

hook="${1:-}"
# The ENVIRONMENT's repos, not the ones this file was loaded from: with LOCALENV_PLUGINS
# the plugin may come from another checkout, and an environment's schema_forge may be a
# symlink to an adopted worktree, where ../ resolves physically to that worktree's
# siblings. Falls back to this file's own checkout when the environment has none.
SF="$ETENDO_ROOT/schema_forge"
[[ -d "$SF" ]] || SF="$(cd "$(dirname "$0")/../.." && pwd)"
CORE="$ETENDO_ROOT/schema_forge_core"
[[ -d "$CORE" ]] || CORE="$SF/../schema_forge_core"
GO_MODULE="$ETENDO_ROOT/modules/com.etendoerp.go"
STATE="${LOCALENV_PLUGIN_STATE:?run by local-env only}"
PIDF="$STATE/spa.pid"
LOGF="$STATE/spa.log"
COPILOT_PIDF="$STATE/copilot.pid"
COPILOT_LOGF="$STATE/copilot.log"
COPILOT_DIR="$ETENDO_ROOT/modules/com.etendoerp.copilot"
# the main checkout keeps the canonical ports; worktree-create reserves others
SPA_PORT="${SPA_PORT:-3100}"
BFF_PORT="${BFF_PORT:-3400}"

configured_feature_flags() {
  local line kind assignment key value json=""
  [[ -f "$ETENDO_ROOT/worktree.conf" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    read -r kind assignment _ <<< "$line" || true
    [[ "$kind" == feature-flag && "$assignment" == *=* ]] || continue
    key="${assignment%%=*}" value="${assignment#*=}"
    [[ "$key" =~ ^[a-z][a-z0-9-]*$ ]] || continue
    [[ "$value" =~ ^(true|false|-?(0|[1-9][0-9]*)(\.[0-9]+)?)$ ]] || continue
    json+="${json:+,}\"$key\":$value"
  done < "$ETENDO_ROOT/worktree.conf"
  [[ -n "$json" ]] && printf '{%s}\n' "$json"
  return 0
}

# The `feature-flag` lines of worktree.conf with a boolean value, for the backend: com.etendoerp.go's
# PropertiesFeatureProvider reads `etendo.go.flags.<key>`, then the environment variable
# ETGO_FLAG_<KEY> (upper case, - as _). They go into the environment's env file, which local-env
# sources and Tomcat inherits, each line tagged so the next `up` replaces exactly the ones it wrote:
# a line removed from worktree.conf is dropped, a hand-written ETGO_FLAG_ line is kept. A value in
# Openbravo.properties still wins over the variable (the provider's own order).
# sync_backend_flags: exit 0 when it changed the env file, 1 otherwise.
BACKEND_FLAG_TAG="# local-env etendo-go: worktree.conf feature-flag"
sync_backend_flags() {
  local f="$LOCALENV_STATE/env" line kind assignment key value lines="" tmp
  if [[ -f "$ETENDO_ROOT/worktree.conf" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      read -r kind assignment _ <<< "$line" || true
      [[ "$kind" == feature-flag && "$assignment" == *=* ]] || continue
      key="${assignment%%=*}" value="${assignment#*=}"
      [[ "$key" =~ ^[a-z][a-z0-9-]*$ && "$value" =~ ^(true|false)$ ]] || continue
      key="$(tr 'a-z-' 'A-Z_' <<< "$key")"
      lines+="export ETGO_FLAG_$key=$value $BACKEND_FLAG_TAG"$'\n'
    done < "$ETENDO_ROOT/worktree.conf"
  fi
  # local-env may append to the env file after these lines: only the tagged lines decide
  [[ "$(grep -F "$BACKEND_FLAG_TAG" "$f" 2>/dev/null || true)" == "${lines%$'\n'}" ]] && return 1
  tmp="$(mktemp)"
  { grep -vF "$BACKEND_FLAG_TAG" "$f" 2>/dev/null || true; printf '%s' "$lines"; } > "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"
}

# worktree.conf `setting copilot=on|off` (default off): this plugin runs the environment's Copilot.
copilot_wanted() {
  [[ -f "$ETENDO_ROOT/worktree.conf" ]] || return 1
  awk '$1 == "setting" && $2 ~ /^copilot=/ { v = substr($2, 9) } END { exit !(v == "on") }' "$ETENDO_ROOT/worktree.conf"
}
copilot_pid() { local p; p="$(cat "$COPILOT_PIDF" 2>/dev/null || true)"; [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# set_prop FILE KEY VALUE: KEY=VALUE in a .properties file, replacing the line or appending it.
# VALUE is written as given (escape it for an Openbravo.properties). Exit 0 when FILE changed.
set_prop() {
  local f=$1 key=$2 value=$3 tmp
  [[ -f "$f" ]] || return 1
  tmp="$(mktemp)"
  PROP_KEY="$key" PROP_VALUE="$value" awk '
    BEGIN { key = ENVIRON["PROP_KEY"]; value = ENVIRON["PROP_VALUE"]
            k = key; gsub(/\./, "\\.", k); re = "^[ \t]*" k "[ \t]*=" }
    $0 ~ re { if (!done) print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }' "$f" > "$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 1; fi
  cat "$tmp" > "$f"; rm -f "$tmp"
}

# The Openbravo.properties an environment's Tomcat reads, plus the ones a build deploys from.
props_files() {
  local f
  for f in "$ETENDO_ROOT/config/Openbravo.properties" "$ETENDO_ROOT/WebContent/WEB-INF/Openbravo.properties" \
           "$LOCALENV_STATE"/catalina/webapps/*/WEB-INF/Openbravo.properties; do
    [[ -f "$f" ]] && echo "$f"
  done
}

# context.url is the base com.etendoerp.go builds the URLs it hands out from when no app base URL
# is configured (McpImageTools.publicUrl: the upload URLs of etendo_request_*_upload). A worktree
# copies the main checkout's (:8080), so an MCP client was told to upload to another Tomcat. Set to
# this environment's Tomcat URL in worktrees only (a main checkout may point it anywhere on
# purpose), and only over a localhost value.
# align_context_url: exit 0 when it changed a file (listed in ALIGNED), 1 otherwise.
align_context_url() {
  local f tmp escaped
  ALIGNED=""
  [[ -n "${LOCALENV_WORKTREE:-}" && "$LOCALENV_URL" =~ ^http://localhost:[0-9]+/ ]] || return 1
  escaped="${LOCALENV_URL//:/\\:}"
  while IFS= read -r f; do
    tmp="$(mktemp)"
    # ENVIRON, not -v: awk -v would turn the \: escapes into plain colons
    CONTEXT_URL="$escaped" awk '
      /^[ \t]*context\.url[ \t]*=[ \t]*http(\\)?:\/\/localhost(\\)?:[0-9]+(\/[^ \t\r]*)?[ \t\r]*$/ {
        print "context.url=" ENVIRON["CONTEXT_URL"] (($0 ~ /\r$/) ? "\r" : ""); next
      }
      { print }' "$f" > "$tmp"
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    else cat "$tmp" > "$f"; rm -f "$tmp"; ALIGNED="${ALIGNED:+$ALIGNED, }$f"; fi
  done < <(props_files)
  [[ -n "$ALIGNED" ]]
}

# Copilot reads its settings from environment variables named after gradle.properties keys
# (copilot.port or COPILOT_PORT, read_optional_env_var): what docker's .env carries for its
# container. Exported upper case with . as _, then this environment's ports on top.
copilot_env() {
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_.]*)[[:space:]]*=(.*)$ ]] || continue
    key="$(tr 'a-z.' 'A-Z_' <<< "${BASH_REMATCH[1]}")" value="${BASH_REMATCH[2]}"
    printf '%s=%s\0' "$key" "$value"
  done < "$ETENDO_ROOT/gradle.properties"
}

# reserve_copilot_ports: COPILOT_PORT / COPILOT_PORT_MCP of this environment. The main checkout
# keeps Copilot's defaults (5005 / 5006); a worktree reserves its own pair, from 5007, once, in
# its env file, skipping the ports other environments reserved and anything listening.
reserve_copilot_ports() {
  local f="$LOCALENV_STATE/env"
  COPILOT_PORT="$(sed -n 's/^export COPILOT_PORT=//p' "$f" 2>/dev/null | tail -1)"
  COPILOT_PORT_MCP="$(sed -n 's/^export COPILOT_PORT_MCP=//p' "$f" 2>/dev/null | tail -1)"
  [[ -n "$COPILOT_PORT" && -n "$COPILOT_PORT_MCP" ]] && return 0
  if [[ -z "${LOCALENV_WORKTREE:-}" ]]; then COPILOT_PORT=5005 COPILOT_PORT_MCP=5006; return 0; fi
  COPILOT_PORT="$(free_port 5007 COPILOT_PORT 5005 5006)"
  COPILOT_PORT_MCP="$(free_port $((COPILOT_PORT + 1)) COPILOT_PORT_MCP 5005 5006 "$COPILOT_PORT")"
  printf 'export COPILOT_PORT=%s\nexport COPILOT_PORT_MCP=%s\n' "$COPILOT_PORT" "$COPILOT_PORT_MCP" >> "$f"
}

# start_copilot: runs modules/com.etendoerp.copilot (`uv run python run.py`, the module's own
# entry point) in its own session on this environment's ports, and points the backend at it
# (copilot.host=localhost: the copied host.docker.internal resolves only from a container).
# Exit 0 when it changed the backend's properties (Tomcat reads them at start).
start_copilot() {
  local p f port mcp changed=1
  if [[ ! -f "$COPILOT_DIR/run.py" ]]; then
    echo "WARNING: setting copilot=on, but $COPILOT_DIR/run.py is not in this checkout: Copilot not started" >&2; return 1
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "WARNING: setting copilot=on, but uv is not installed: Copilot not started" >&2; return 1
  fi
  reserve_copilot_ports
  port=$COPILOT_PORT mcp=$COPILOT_PORT_MCP
  if ! p="$(copilot_pid)" && { port_busy "$port" || port_busy "$mcp"; }; then
    echo "WARNING: setting copilot=on, but :$port or :$mcp is already in use by another process (a docker Copilot?): this environment's Copilot not started" >&2
    return 1
  fi
  while IFS= read -r f; do
    set_prop "$f" copilot.host localhost && changed=0
    set_prop "$f" copilot.port "$port" && changed=0
    set_prop "$f" copilot.port.mcp "$mcp" && changed=0
  done < <(props_files)
  if [[ -n "$p" ]]; then
    echo ">> Copilot already running: http://localhost:$port (pid $p, log $COPILOT_LOGF)"
    return $changed
  fi
  # the gradle.properties keys first, this environment's ports last (gradle.properties has its own)
  ( cd "$COPILOT_DIR"
    if [[ -f "$ETENDO_ROOT/gradle.properties" ]]; then
      while IFS= read -r -d '' kv; do export "${kv?}"; done < <(copilot_env)
    fi
    export COPILOT_PORT="$port" COPILOT_PORT_MCP="$mcp" COPILOT_WAIT_FOR_DEBUGGER=false
    exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' uv run python run.py
  ) >> "$COPILOT_LOGF" 2>&1 < /dev/null &
  echo $! > "$COPILOT_PIDF"
  echo ">> Copilot starting: http://localhost:$port (MCP :$mcp, log $COPILOT_LOGF)"
  return $changed
}

stop_copilot() {   # the process group of this environment's Copilot only
  local p i=0
  p="$(copilot_pid)" || { rm -f "$COPILOT_PIDF"; return 0; }
  kill -TERM -- "-$p" 2>/dev/null || true
  while kill -0 "$p" 2>/dev/null && (( i < 50 )); do sleep 0.2; i=$((i + 1)); done
  kill -KILL -- "-$p" 2>/dev/null || true
  rm -f "$COPILOT_PIDF"
  echo ">> Copilot stopped (pid $p)"
}

port_busy() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }
spa_pid() { local p; p="$(cat "$PIDF" 2>/dev/null || true)"; [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# spa_listen_port PGID: the port the SPA really listens on, empty while nothing does yet.
# The reserved SPA_PORT is only a request: a branch whose Makefile predates SPA_PORT
# serves on its own default (ETP-5602 reserved 3101 and served 3100). The recorded pid
# leads its own session (setsid), so its process group holds the BFF and vite: vite is
# the SPA; failing that, any listener that is not the BFF's port.
spa_listen_port() {
  local pid="" port vite="" other="" line
  while IFS= read -r line; do
    case "$line" in
      p*) pid="${line#p}" ;;
      n*) port="${line##*:}"
          if [[ -z "$vite" ]] && ps -o command= -p "$pid" 2>/dev/null | grep -q vite; then vite="$port"; fi
          [[ -z "$other" && "$port" != "$BFF_PORT" ]] && other="$port" ;;
    esac
  done < <(lsof -nP -a -g "$1" -iTCP -sTCP:LISTEN -Fpn 2>/dev/null)
  echo "${vite:-$other}"
}

# makefile_ignores_spa_port: this environment's schema_forge cannot be told the SPA port
makefile_ignores_spa_port() { ! grep -q 'SPA_PORT' "$SF/Makefile" 2>/dev/null; }

# first port >= START that nothing listens on and no other environment reserved;
# the main checkout's pair is never handed out
free_port() {   # free_port START KEY TAKEN...
  local p=$1 key=$2 taken; shift 2
  taken="$(cat "$LOCALENV_WORKTREES"/*/build/local-env/env 2>/dev/null | sed -n "s/^export $key=//p")"
  while port_busy "$p" || grep -qx "$p" <<< "$taken" || [[ " $* " == *" $p "* ]]; do p=$((p + 1)); done
  echo "$p"
}

# com.etendoerp.go's CorsUtils trusts localhost:3000/3100/4173/5173 plus ETGO_ALLOWED_ORIGINS
# (comma-separated, additive): a SPA on any other port gets "Origin not allowed" (403) on
# login. The origins go into the environment's env file, which local-env sources and
# exports before exec'ing tomcat-fast, so Tomcat's JVM inherits them. Merged with the value
# already there (the file's line, else the inherited one): never clobbered.
# add_origins PORT: exit 0 when it changed the env file, 1 when nothing was missing.
add_origins() {
  local port=$1 f="$LOCALENV_STATE/env" cur o add="" merged tmp
  [[ "$port" == 3100 ]] && return 1
  if grep -q '^export ETGO_ALLOWED_ORIGINS=' "$f" 2>/dev/null; then
    cur="$(sed -n 's/^export ETGO_ALLOWED_ORIGINS=//p' "$f" | tail -1)"
  else cur="${ETGO_ALLOWED_ORIGINS:-}"; fi
  for o in "http://localhost:$port" "http://127.0.0.1:$port"; do
    [[ ",$cur," == *",$o,"* ]] || add="${add:+$add,}$o"
  done
  [[ -n "$add" ]] || return 1
  merged="${cur:+$cur,}$add"
  tmp="$(mktemp)"
  { grep -v '^export ETGO_ALLOWED_ORIGINS=' "$f" 2>/dev/null || true; echo "export ETGO_ALLOWED_ORIGINS=$merged"; } > "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"
}

# The MCP OAuth flow of a SPA on another port: its vite well-known metadata advertises
# resource http://localhost:<port>/mcp and issuer http://localhost:<port>, while the backend
# validates the token audience against etgo.mcp.public.url and the client needs the issuer to
# equal etgo.oauth2.public.url. A worktree's properties are copied from the main checkout and
# still say :3100, so the login fails. Rewritten in the environment's gradle.properties,
# config/Openbravo.properties, WebContent/WEB-INF (which a build deploys) and the deployed
# WEB-INF copy, keeping each line's escaping
# (http\://localhost\:<port> in the Openbravo.properties files). Only a localhost value with
# another port is rewritten: a custom public URL is kept, and an absent property is not added
# (PublicUrlResolver then derives the URL from the request, which is not this SPA's to decide).
# align_public_urls PORT: exit 0 when it changed a file (listed in ALIGNED), 1 otherwise.
ALIGNED=""
align_public_urls() {
  local port=$1 f tmp
  ALIGNED=""
  [[ "$port" == 3100 ]] && return 1
  for f in "$ETENDO_ROOT/gradle.properties" "$ETENDO_ROOT/config/Openbravo.properties" \
           "$ETENDO_ROOT/WebContent/WEB-INF/Openbravo.properties" \
           "$LOCALENV_STATE"/catalina/webapps/*/WEB-INF/Openbravo.properties; do
    [[ -f "$f" ]] || continue
    tmp="$(mktemp)"
    awk -v port="$port" '
      match($0, /^[ \t]*etgo\.(mcp|oauth2)\.public\.url[ \t]*=[ \t]*/) {
        head = substr($0, 1, RLENGTH); val = substr($0, RLENGTH + 1)
        cr = (val ~ /\r$/) ? "\r" : ""
        sub(/[ \t\r]+$/, "", val)
        if (val ~ /^http(\\)?:\/\/localhost(\\)?:[0-9]+(\/[^ \t]*)?$/) {
          cur = val; sub(/^http(\\)?:\/\/localhost(\\)?:/, "", cur); sub(/\/.*/, "", cur)
          if (cur != port) {
            print head ((val ~ /\\:/) ? "http\\://localhost\\:" : "http://localhost:") port \
              (head ~ /etgo\.mcp\./ ? "/mcp" : "") cr
            next
          }
        }
      }
      { print }' "$f" > "$tmp"
    if cmp -s "$tmp" "$f"; then rm -f "$tmp"
    else cat "$tmp" > "$f"; rm -f "$tmp"; ALIGNED="${ALIGNED:+$ALIGNED, }$f"; fi
  done
  [[ -n "$ALIGNED" ]]
}

# A worktree's tools/app-shell/.env.local is copied from the main checkout, so its ETENDO_URL
# is the main Tomcat's. `up` overrides it on make's command line, but a `make dev` run by hand
# in the environment (e.g. after this plugin skipped the SPA) proxied to the main checkout's
# Tomcat without a word (2026-10-26). Rewritten in worktrees only (a main checkout may point it
# anywhere on purpose), only for a localhost value, and only in a schema_forge that physically
# lives in the environment: an adopted worktree or the plugin's own checkout is someone else's.
# align_app_shell_url: exit 0 when it changed the file, 1 otherwise.
align_app_shell_url() {
  local f="$SF/tools/app-shell/.env.local" sf root tmp
  [[ -n "${LOCALENV_WORKTREE:-}" && -f "$f" ]] || return 1
  sf="$(cd "$SF" && pwd -P)"; root="$(cd "$ETENDO_ROOT" && pwd -P)"
  [[ "$sf" == "$root"/* ]] || return 1
  tmp="$(mktemp)"
  awk -v url="$LOCALENV_URL" '
    /^ETENDO_URL=http:\/\/(localhost|127\.0\.0\.1)(:[0-9]+)?(\/[^ \t\r]*)?[ \t\r]*$/ {
      print "ETENDO_URL=" url (($0 ~ /\r$/) ? "\r" : ""); next
    }
    { print }' "$f" > "$tmp"
  if cmp -s "$tmp" "$f"; then rm -f "$tmp"; return 1; fi
  cat "$tmp" > "$f"; rm -f "$tmp"
}

# needs_install DIR STAMP: node_modules missing, or the lockfile changed since the last
# install. local-env clones a repo's node_modules into a new worktree from the source
# checkout, so they can lag the branch's own lockfile: the same check covers that.
needs_install() {
  local dir=$1 ref=$2
  [[ -d "$dir/node_modules" ]] || return 0
  # never installed by this plugin: npm's own record of the last install is the reference
  [[ -f "$ref" ]] || ref="$dir/node_modules/.package-lock.json"
  [[ -f "$ref" ]] || return 0
  [[ "$dir/package-lock.json" -nt "$ref" ]]
}

stop_spa() {   # the process group of this environment's SPA + BFF only
  local p i=0
  p="$(spa_pid)" || { rm -f "$PIDF"; return 0; }
  kill -TERM -- "-$p" 2>/dev/null || true
  while kill -0 "$p" 2>/dev/null && (( i < 50 )); do sleep 0.2; i=$((i + 1)); done
  kill -KILL -- "-$p" 2>/dev/null || true
  rm -f "$PIDF"
  echo ">> Etendo GO SPA stopped (:$SPA_PORT, BFF :$BFF_PORT)"
}

# tomcat_reads WHAT: says that WHAT changed in the backend's configuration. A Tomcat about to
# start (LOCALENV_TOMCAT=1) reads it; one already running does not.
tomcat_reads() {
  if [[ "${LOCALENV_TOMCAT:-0}" == 1 ]]; then echo ">> $1 (the Tomcat starting now picks it up)"
  else echo "WARNING: $1; a Tomcat of this environment that is already running still has the old configuration: restart it once" >&2; fi
}

case "$hook" in
  manifest)
    # The version is bumped when com.etendoerp.go's GOClient sample dataset changes in a way a
    # seeded DB must have: the fingerprint does not hash the dataset, so without a bump every
    # environment keeps restoring the old seed. v2 (ETP-5850): GOClient's sequence for
    # C_BPartner.EM_Etgo_Identifier, without which creating a contact fails.
    [[ -d "$GO_MODULE" ]] && echo "seed GOClient v2"
    ;;
  db-seed)
    if [[ -d "$GO_MODULE" ]]; then
      echo "import.sample.data -Pclient=GOClient"
      echo "prepareOnboardingSampledata --info"
    fi
    ;;
  worktree-create)
    grep -q '^export SPA_PORT=' "$LOCALENV_STATE/env" 2>/dev/null && exit 0
    spa="$(free_port 3101 SPA_PORT 3100 3400)"
    bff="$(free_port 3401 BFF_PORT 3100 3400 "$spa")"
    printf 'export SPA_PORT=%s\nexport BFF_PORT=%s\n' "$spa" "$bff" >> "$LOCALENV_STATE/env"
    add_origins "$spa" || true
    echo ">> Etendo GO SPA of this environment: :$spa (AI BFF :$bff), allowed as an origin by its Tomcat"
    if align_public_urls "$spa"; then
      echo ">> Pointed etgo.mcp.public.url / etgo.oauth2.public.url at :$spa in $ALIGNED"
    fi
    if align_app_shell_url; then echo ">> Pointed ETENDO_URL of $SF/tools/app-shell/.env.local at $LOCALENV_URL"; fi
    if align_context_url; then echo ">> Pointed context.url at $LOCALENV_URL in $ALIGNED"; fi
    ;;
  up)
    # environments created before worktree-create did it; before any skip, for a `make dev` by hand
    if align_app_shell_url; then echo ">> Pointed ETENDO_URL of $SF/tools/app-shell/.env.local at $LOCALENV_URL"; fi
    # backend configuration first: none of it depends on the SPA, and Tomcat reads it at start
    if align_context_url; then tomcat_reads "pointed context.url at $LOCALENV_URL in $ALIGNED"; fi
    if sync_backend_flags; then tomcat_reads "backend feature flags (ETGO_FLAG_*) of $ETENDO_ROOT/worktree.conf written to $LOCALENV_STATE/env"; fi
    if copilot_wanted; then
      if start_copilot; then tomcat_reads "pointed copilot.host / copilot.port at this environment's Copilot"; fi
    else
      stop_copilot >/dev/null
    fi
    if [[ "${ETENDO_GO_SPA:-1}" == 0 ]]; then echo ">> ETENDO_GO_SPA=0: Etendo GO SPA not started"; exit 0; fi
    if [[ ! -d "$GO_MODULE" ]]; then echo ">> modules/com.etendoerp.go not in this checkout: Etendo GO SPA not started"; exit 0; fi
    if [[ ! -d "$CORE/packages/app-shell-core/src" ]]; then
      echo "WARNING: $CORE not found: Etendo GO SPA not started (make dev-local-core needs it)" >&2
      exit 0
    fi
    # environments created before the origins were reserved. local-env sourced the env file
    # before this hook, but tomcat-fast sources it again when it starts, so a Tomcat about
    # to start (LOCALENV_TOMCAT=1) gets the line; one already running does not
    if add_origins "$SPA_PORT"; then
      if [[ "${LOCALENV_TOMCAT:-0}" == 1 ]]; then
        echo ">> Added ETGO_ALLOWED_ORIGINS for :$SPA_PORT to $LOCALENV_STATE/env (the Tomcat starting now picks it up)"
      else
        echo "WARNING: added ETGO_ALLOWED_ORIGINS for :$SPA_PORT to $LOCALENV_STATE/env; a Tomcat of this environment that is already running does not have it: restart it once, or login from the SPA answers 'Origin not allowed'" >&2
      fi
    fi
    # same for the public URLs: properties are read at context init
    if align_public_urls "$SPA_PORT"; then
      if [[ "${LOCALENV_TOMCAT:-0}" == 1 ]]; then
        echo ">> Pointed etgo.mcp.public.url / etgo.oauth2.public.url at :$SPA_PORT in $ALIGNED (the Tomcat starting now picks them up)"
      else
        echo "WARNING: pointed etgo.mcp.public.url / etgo.oauth2.public.url at :$SPA_PORT in $ALIGNED; a Tomcat of this environment that is already running still has the old values: restart it once, or an MCP client's OAuth login against this SPA fails (token audience / issuer mismatch)" >&2
      fi
    fi
    if p="$(spa_pid)"; then
      port="$(spa_listen_port "$p")"
      echo ">> Etendo GO SPA already running: http://localhost:${port:-$SPA_PORT}$([[ -n "$port" && "$port" != "$SPA_PORT" ]] && echo " (not the reserved :$SPA_PORT)") (pid $p, log $LOGF)"
      exit 0
    fi
    install=0 core_install=0
    needs_install "$SF" "$STATE/install.stamp" && install=1
    needs_install "$CORE" "$STATE/core-install.stamp" && core_install=1
    # a symlinked repo is a worktree adopted from someone else: never install into it
    for r in schema_forge:$install schema_forge_core:$core_install; do
      if [[ "${r#*:}" == 1 && -L "$ETENDO_ROOT/${r%%:*}" ]]; then
        echo "WARNING: $ETENDO_ROOT/${r%%:*} is an adopted worktree whose node_modules are missing or stale: Etendo GO SPA not started (install there yourself)" >&2
        exit 0
      fi
    done
    # a branch whose Makefile predates SPA_PORT/BFF_PORT runs on 3100/3400 whatever was
    # reserved, and its dev-local-core first kills whatever listens there: possibly the
    # main checkout's SPA and BFF. Start it only while both ports are free
    if makefile_ignores_spa_port && [[ "$SPA_PORT" != 3100 || "$BFF_PORT" != 3400 ]]; then
      if port_busy 3100 || port_busy 3400; then
        echo "WARNING: this branch's schema_forge/Makefile does not take SPA_PORT/BFF_PORT, so its SPA would take :3100/:3400, which are in use (its dev-local-core would kill them): Etendo GO SPA not started" >&2
        exit 0
      fi
      echo "WARNING: this branch's schema_forge/Makefile does not take SPA_PORT: the SPA will listen on :3100, not the reserved :$SPA_PORT (local-env status shows the real port; its Tomcat only allows the reserved origin)" >&2
    fi
    # Translate per-worktree feature flags into Vite's local override map.
    feature_flags="$(configured_feature_flags)"
    feature_flags_set=0
    if [[ -n "$feature_flags" ]]; then
      export VITE_FEATURE_FLAGS="$feature_flags"
      feature_flags_set=1
      echo ">> Etendo GO SPA feature flags loaded from $ETENDO_ROOT/worktree.conf"
    fi
    # own session (= own process group): Ctrl-C on Tomcat or closing the terminal does
    # not kill it, and stop_spa can signal the whole make/npm/node tree at once
    # SCHEMA_FORGE_CORE: vite would otherwise resolve ../schema_forge_core from its own
    # physical path, which for an adopted worktree is not this environment's core
    SF="$SF" STAMP="$STATE/install.stamp" INSTALL=$install ETENDO_URL="$LOCALENV_URL" \
      SCHEMA_FORGE_CORE="$CORE" CORE_STAMP="$STATE/core-install.stamp" CORE_INSTALL=$core_install \
      SPA_PORT="$SPA_PORT" BFF_PORT="$BFF_PORT" FEATURE_FLAGS_SET="$feature_flags_set" \
      perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' bash -c '
        # npm install, not `make install`: that target also sets core.hooksPath, git config
        # the core repo shares with every worktree of it
        if [[ $CORE_INSTALL == 1 ]]; then (cd "$SCHEMA_FORGE_CORE" && npm install) && touch "$CORE_STAMP" || exit 1; fi
        cd "$SF"
        if [[ $INSTALL == 1 ]]; then make install && touch "$STAMP" || exit 1; fi
        # Make command-line variables beat the same names in schema_forge/.env.
        # The AI BFF does not read ETENDO_URL: without ETENDO_MCP_URL it calls :8080, the
        # main checkout, with this user credentials; the usage URL derives from it unless
        # ETENDO_USAGE_URL is set, so both are pinned to this environment Tomcat.
        feature_flag_args=()
        if [[ $FEATURE_FLAGS_SET == 1 ]]; then
          feature_flag_args=("VITE_FEATURE_FLAGS=$VITE_FEATURE_FLAGS")
        fi
        exec make dev-local-core ETENDO_URL="$ETENDO_URL" SPA_PORT="$SPA_PORT" BFF_PORT="$BFF_PORT" \
          SCHEMA_FORGE_CORE="$SCHEMA_FORGE_CORE" \
          ETENDO_MCP_URL="$ETENDO_URL/sws/mcp" ETENDO_USAGE_URL="$ETENDO_URL/sws/neo/usage" \
          "${feature_flag_args[@]}"' \
      >> "$LOGF" 2>&1 < /dev/null &
    echo $! > "$PIDF"
    echo ">> Etendo GO SPA starting: http://localhost:$SPA_PORT -> $LOCALENV_URL$([[ $core_install == 1 ]] && echo ', after npm install in schema_forge_core')$([[ $install == 1 ]] && echo ', after make install') (log: $LOGF)"
    ;;
  status)
    # the URL first: local-env takes the first one in the value as the SPA's (progress.json)
    if ! p="$(spa_pid)"; then printf 'SPA\thttp://localhost:%s (stopped)\n' "$SPA_PORT"
    elif port="$(spa_listen_port "$p")"; [[ -z "$port" ]]; then
      printf 'SPA\thttp://localhost:%s (starting%s)\n' "$SPA_PORT" "$(makefile_ignores_spa_port && echo "; this branch's Makefile ignores SPA_PORT, the real port shows once it listens")"
    elif [[ "$port" != "$SPA_PORT" ]]; then
      printf 'SPA\thttp://localhost:%s (running; not the reserved :%s%s)\n' "$port" "$SPA_PORT" "$(makefile_ignores_spa_port && echo ": this branch's Makefile ignores SPA_PORT")"
    else printf 'SPA\thttp://localhost:%s (running)\n' "$port"; fi
    if copilot_wanted || copilot_pid >/dev/null; then
      port="$(sed -n 's/^export COPILOT_PORT=//p' "$LOCALENV_STATE/env" 2>/dev/null | tail -1)"
      printf 'Copilot\thttp://localhost:%s (%s)\n' "${port:-5005}" "$(copilot_pid >/dev/null && echo running || echo stopped)"
    fi
    ;;
  stop|off|worktree-rm)
    stop_copilot
    stop_spa
    ;;
esac
exit 0
