{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-push-no-verify.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for pre-push bypass"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block-coverage-threshold-overrides.sh\"",
            "timeout": 10,
            "statusMessage": "Protecting coverage thresholds"
          }
        ]
      }
    ]
  }
}
