{
  "name": "schema-forge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "tools/app-shell",
    "e2e"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "mkdir -p artifacts && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=artifacts/test-report.xml 'cli/test/*.test.js' 'tools/app-shell/src/**/__tests__/*.test.js' 'tools/app-shell/test/*.test.js' 'artifacts/**/__tests__/*.test.js'",
    "check:data-testid": "./scripts/check-add-data-testid.sh",
    "apply:data-testid": "./scripts/apply-add-data-testid.sh",
    "gateway:link-local-core": "make gateway-link-local-core"
  },
  "devDependencies": {
    "@etendosoftware/app-shell-core": "0.3.94-preview.feature-ETP-6080.20261104145120.2a40c0d",
    "@etendosoftware/schema-forge-cli": "0.3.94-preview.feature-ETP-6080.20261104145120.2a40c0d",
    "@etendosoftware/schema-forge-core": "0.3.94-preview.feature-ETP-6080.20261104145120.2a40c0d",
    "esbuild": "^0.28.0",
    "handlebars": "^4.7.9",
    "jscodeshift": "^17.3.0",
    "shadcn": "^4.0.2"
  }
}
